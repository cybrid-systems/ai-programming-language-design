@@ -0,0 +1,39 @@
+/* Copyright (c) 2024 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#ifndef GRAPH_OPTIMIZER_RULE_PUSHDISTINCTLIMITDOWNEXPANDRULE_H_
+#define GRAPH_OPTIMIZER_RULE_PUSHDISTINCTLIMITDOWNEXPANDRULE_H_
+
+#include "graph/optimizer/OptRule.h"
+
+namespace nebula {
+namespace opt {
+
+// Push `LIMIT k` through `Dedup` into a one-step Expand whose input has
+// exactly one source vertex.  The storage getDstBySrc RPC can then dedup
+// destinations while scanning and stop after k distinct destinations.
+//
+//   Limit(k) -> Dedup -> Expand        Limit(k) -> Dedup -> Expand(dedup, limit=k)
+//
+// This is only valid for a single source vertex: for multiple sources a
+// global LIMIT cannot be applied independently to each source.
+class PushDistinctLimitDownExpandRule final : public OptRule {
+ public:
+  const Pattern &pattern() const override;
+
+  StatusOr<OptRule::TransformResult> transform(OptContext *ctx,
+                                               const MatchedResult &matched) const override;
+
+  std::string toString() const override;
+
+ private:
+  PushDistinctLimitDownExpandRule();
+
+  static std::unique_ptr<OptRule> kInstance;
+};
+
+}  // namespace opt
+}  // namespace nebula
+#endif  // GRAPH_OPTIMIZER_RULE_PUSHDISTINCTLIMITDOWNEXPANDRULE_H_
