new file mode 100644
index 0000000..07a3ee8
--- /dev/null
+++ b/src/graph/optimizer/rule/PushDistinctLimitDownExpandRule.cpp
@@ -0,0 +1,120 @@
+/* Copyright (c) 2024 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include "graph/optimizer/rule/PushDistinctLimitDownExpandRule.h"
+
+#include "graph/context/ExecutionContext.h"
+#include "graph/optimizer/OptContext.h"
+#include "graph/optimizer/OptGroup.h"
+#include "graph/planner/plan/PlanNode.h"
+#include "graph/planner/plan/Query.h"
+#include "graph/util/ExpressionUtils.h"
+
+using nebula::graph::Dedup;
+using nebula::graph::Expand;
+using nebula::graph::Limit;
+using nebula::graph::PlanNode;
+using nebula::graph::QueryContext;
+
+namespace nebula {
+namespace opt {
+
+std::unique_ptr<OptRule> PushDistinctLimitDownExpandRule::kInstance =
+    std::unique_ptr<PushDistinctLimitDownExpandRule>(new PushDistinctLimitDownExpandRule());
+
+PushDistinctLimitDownExpandRule::PushDistinctLimitDownExpandRule() {
+  RuleSet::QueryRules().addRule(this);
+}
+
+const Pattern &PushDistinctLimitDownExpandRule::pattern() const {
+  static Pattern pattern =
+      Pattern::create(PlanNode::Kind::kLimit,
+                      {Pattern::create(PlanNode::Kind::kDedup,
+                                       {Pattern::create(PlanNode::Kind::kExpand)})});
+  return pattern;
+}
+
+StatusOr<OptRule::TransformResult> PushDistinctLimitDownExpandRule::transform(
+    OptContext *octx, const MatchedResult &matched) const {
+  auto *qctx = octx->qctx();
+  const auto *limitGroupNode = matched.node;
+  const auto *dedupGroupNode = matched.dependencies.front().node;
+  const auto *expandGroupNode = matched.dependencies.front().dependencies.front().node;
+
+  const auto *limit = static_cast<const Limit *>(limitGroupNode->node());
+  const auto *dedup = static_cast<const Dedup *>(dedupGroupNode->node());
+  const auto *expand = static_cast<const Expand *>(expandGroupNode->node());
+
+  if (!graph::ExpressionUtils::isEvaluableExpr(limit->countExpr())) {
+    return TransformResult::noTransform();
+  }
+  if (expand->maxSteps() != 1 || expand->sample() || expand->joinInput()) {
+    return TransformResult::noTransform();
+  }
+  // The storage RPC returns one dst column.  Deduping it is equivalent to
+  // deduping the Expand output only when that output is just `_expand_vid`.
+  if (expand->colNames().size() != 1 || expand->colNames().front() != "_expand_vid") {
+    return TransformResult::noTransform();
+  }
+  // A global LIMIT can be applied per source only when there is one source.
+  auto *ectx = qctx->ectx();
+  if (!ectx->exist(expand->inputVar()) || ectx->getResult(expand->inputVar()).size() != 1) {
+    return TransformResult::noTransform();
+  }
+  const int64_t offset = std::max<int64_t>(limit->offset(), 0);
+  const int64_t count = limit->count(qctx);
+  if (count < 0 || offset > std::numeric_limits<int64_t>::max() - count) {
+    return TransformResult::noTransform();
+  }
+  const int64_t limitRows = offset + count;
+  int64_t oldLimit = -1;
+  if (expand->limitExpr() != nullptr) {
+    if (!graph::ExpressionUtils::isEvaluableExpr(expand->limitExpr())) {
+      return TransformResult::noTransform();
+    }
+    oldLimit = expand->limit(qctx);
+  }
+  if (oldLimit >= 0 && oldLimit <= limitRows) {
+    return TransformResult::noTransform();
+  }
+
+  auto *newLimit = static_cast<Limit *>(limit->clone());
+  auto *newDedup = static_cast<Dedup *>(dedup->clone());
+  auto *newExpand = static_cast<Expand *>(expand->clone());
+  newExpand->setDedup(true);
+  newExpand->setLimit(limitRows);
+  // Keep the original dataflow variable names; the groups are replaced in place.
+  newExpand->setInputVar(expand->inputVar());
+  newExpand->setOutputVar(expand->outputVar());
+  newDedup->setInputVar(expand->outputVar());
+  newDedup->setOutputVar(dedup->outputVar());
+  newLimit->setInputVar(dedup->outputVar());
+  newLimit->setOutputVar(limit->outputVar());
+
+  auto *newExpandGroup = OptGroup::create(octx);
+  auto *newExpandGroupNode = newExpandGroup->makeGroupNode(newExpand);
+  for (auto *dep : expandGroupNode->dependencies()) {
+    newExpandGroupNode->dependsOn(dep);
+  }
+
+  auto *newDedupGroup = OptGroup::create(octx);
+  auto *newDedupGroupNode = newDedupGroup->makeGroupNode(newDedup);
+  newDedupGroupNode->dependsOn(newExpandGroup);
+
+  auto *newLimitGroupNode = OptGroupNode::create(octx, newLimit, limitGroupNode->group());
+  newLimitGroupNode->dependsOn(newDedupGroup);
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(newLimitGroupNode);
+  return result;
+}
+
+std::string PushDistinctLimitDownExpandRule::toString() const {
+  return "PushDistinctLimitDownExpandRule";
+}
+
+}  // namespace opt
+}  // namespace nebula
