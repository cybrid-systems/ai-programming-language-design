new file mode 100644
index 0000000..a18bf3f
--- /dev/null
+++ b/src/graph/optimizer/rule/PushProjectDownHashInnerJoinRule.cpp
@@ -0,0 +1,141 @@
+/* Copyright (c) 2024 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include "graph/optimizer/rule/PushProjectDownHashInnerJoinRule.h"
+
+#include <algorithm>
+#include <iterator>
+#include <unordered_set>
+
+#include "common/expression/PropertyExpression.h"
+#include "graph/optimizer/OptContext.h"
+#include "graph/optimizer/OptGroup.h"
+#include "graph/planner/plan/PlanNode.h"
+#include "graph/planner/plan/Query.h"
+
+using nebula::graph::HashInnerJoin;
+using nebula::graph::PlanNode;
+using nebula::graph::Project;
+
+namespace nebula {
+namespace opt {
+
+std::unique_ptr<OptRule> PushProjectDownHashInnerJoinRule::kInstance =
+    std::unique_ptr<OptRule>(new PushProjectDownHashInnerJoinRule());
+
+PushProjectDownHashInnerJoinRule::PushProjectDownHashInnerJoinRule() {
+  RuleSet::QueryRules().addRule(this);
+}
+
+const Pattern& PushProjectDownHashInnerJoinRule::pattern() const {
+  static Pattern pattern = Pattern::create(
+      PlanNode::Kind::kProject,
+      {Pattern::create(
+          PlanNode::Kind::kHashInnerJoin,
+          {Pattern::create(PlanNode::Kind::kUnknown), Pattern::create(PlanNode::Kind::kUnknown)})});
+  return pattern;
+}
+
+StatusOr<OptRule::TransformResult> PushProjectDownHashInnerJoinRule::transform(
+    OptContext* octx, const MatchedResult& matched) const {
+  const auto* projectNode = matched.planNode({0});
+  DCHECK_EQ(projectNode->kind(), PlanNode::Kind::kProject);
+  const auto* project = static_cast<const Project*>(projectNode);
+
+  const auto* joinNode = matched.planNode({0, 0});
+  DCHECK_EQ(joinNode->kind(), PlanNode::Kind::kHashInnerJoin);
+  const auto* join = static_cast<const HashInnerJoin*>(joinNode);
+
+  // The join output is consumed only by this Project.  Otherwise changing the
+  // join's output shape would break another reader.
+  auto* joinVar = octx->qctx()->symTable()->getVar(join->outputVar());
+  if (joinVar == nullptr || joinVar->readBy.size() != 1) {
+    return TransformResult::noTransform();
+  }
+
+  const auto* columns = project->columns();
+  if (columns == nullptr || columns->columns().empty()) {
+    return TransformResult::noTransform();
+  }
+  const auto& outNames = project->colNames();
+  if (outNames.size() != columns->columns().size()) {
+    return TransformResult::noTransform();
+  }
+
+  const auto& joinColNames = join->colNames();
+  // Ambiguous source names would make the projection mapping depend on which
+  // duplicate the iterator happens to resolve; leave those plans untouched.
+  std::unordered_set<std::string> uniqueJoinCols;
+  for (const auto& colName : joinColNames) {
+    if (!uniqueJoinCols.emplace(colName).second) {
+      return TransformResult::noTransform();
+    }
+  }
+
+  const auto* leftVar = octx->qctx()->symTable()->getVar(join->leftInputVar());
+  const auto* rightVar = octx->qctx()->symTable()->getVar(join->rightInputVar());
+  if (leftVar == nullptr || rightVar == nullptr) {
+    return TransformResult::noTransform();
+  }
+  std::unordered_set<std::string> naturalCols;
+  for (const auto& colName : leftVar->colNames) {
+    naturalCols.emplace(colName);
+  }
+  for (const auto& colName : rightVar->colNames) {
+    if (std::find(leftVar->colNames.begin(), leftVar->colNames.end(), colName) ==
+        leftVar->colNames.end()) {
+      naturalCols.emplace(colName);
+    }
+  }
+
+  std::vector<graph::JoinOutputColumn> outputs;
+  outputs.reserve(columns->columns().size());
+  for (size_t i = 0; i < columns->columns().size(); ++i) {
+    const auto* expr = columns->columns()[i]->expr();
+    // `$-.col` is normally an InputProperty, but GoValidator may rewrite a
+    // pipe column to an anonymous VarProperty (empty sym).  A real `$var.col`
+    // reference could name a column belonging to a different variable with
+    // the same visible name, so keep those on a real Project.
+    if (expr == nullptr) {
+      return TransformResult::noTransform();
+    }
+    if (expr->kind() != Expression::Kind::kInputProperty &&
+        expr->kind() != Expression::Kind::kVarProperty) {
+      return TransformResult::noTransform();
+    }
+    const auto* propExpr = static_cast<const PropertyExpression*>(expr);
+    if (expr->kind() == Expression::Kind::kVarProperty && !propExpr->sym().empty()) {
+      return TransformResult::noTransform();
+    }
+    if (std::find(joinColNames.begin(), joinColNames.end(), propExpr->prop()) ==
+            joinColNames.end() ||
+        naturalCols.count(propExpr->prop()) == 0) {
+      return TransformResult::noTransform();
+    }
+    outputs.emplace_back(graph::JoinOutputColumn{propExpr->prop(), outNames[i]});
+  }
+
+  const auto* joinGroupNode = matched.result({0, 0}).node;
+  auto* newJoin = static_cast<HashInnerJoin*>(join->clone());
+  newJoin->setOutputColumns(std::move(outputs));
+  newJoin->setColNames(project->colNames());
+  newJoin->setOutputVar(project->outputVar());
+
+  auto* newGroupNode =
+      OptGroupNode::create(octx, newJoin, const_cast<OptGroup*>(matched.node->group()));
+  newGroupNode->setDeps(joinGroupNode->dependencies());
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(newGroupNode);
+  return result;
+}
+
+std::string PushProjectDownHashInnerJoinRule::toString() const {
+  return "PushProjectDownHashInnerJoinRule";
+}
+
+}  // namespace opt
+}  // namespace nebula
