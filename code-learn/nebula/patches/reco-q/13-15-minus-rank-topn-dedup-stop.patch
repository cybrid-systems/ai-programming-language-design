+folly::Future<Status> ExpandExecutor::minusDst() {
+  if (expand_->maxSteps() != 1) {
+    return Status::Error("minus fusion is only implemented for one step");
+  }
+  currentStep_++;
+  time::Duration getDstTime;
+  StorageClient* storageClient = qctx_->getStorageClient();
+  StorageClient::CommonRequestParam param(expand_->space(),
+                                          qctx_->rctx()->session()->id(),
+                                          qctx_->plan()->id(),
+                                          qctx_->plan()->isProfileEnabled());
+  std::vector<Value> vids(nextStepVids_.size());
+  std::move(nextStepVids_.begin(), nextStepVids_.end(), vids.begin());
+  // clusterIdsToHosts copies vids into the request before returning.
+  auto kept = vids;
+  return storageClient
+      ->getDstBySrc(param,
+                    vids,
+                    expand_->edgeTypes(),
+                    expand_->filter(),
+                    nullptr,
+                    &expand_->minusEdgeTypes())
+      .via(runner())
+      .ensure([this, getDstTime]() {
+        SCOPED_TIMER(&execTime_);
+        addState("total_rpc_time", getDstTime);
+      })
+      .thenValue([this, kept = std::move(kept)](StorageRpcResponse<GetDstBySrcResponse>&& resps) {
+        memory::MemoryCheckGuard guard;
+        nextStepVids_.clear();
+        SCOPED_TIMER(&execTime_);
+        auto completeness = handleCompleteness(resps, FLAGS_accept_partial_success);
+        if (!completeness.ok()) {
+          return folly::makeFuture<Status>(completeness.status());
+        }
+        bool applied = !resps.responses().empty();
+        for (const auto& resp : resps.responses()) {
+          // Unset on an older storaged, which returns only the left edge set.
+          const bool* bit = resp.get_minus_applied();
+          if (bit == nullptr || !*bit) {
+            applied = false;
+            break;
+          }
+        }
+        if (!applied) {
+          addState("minus_applied", 0);
+          return fallbackMinus(kept);
+        }
+        addState("minus_applied", 1);
+        DataSet ds;
+        // Storage names the column "_dst". append() drops every row when the
+        // headers differ, so rename before appending, same as GetDstBySrc().
+        for (auto& resp : resps.responses()) {
+          auto* dataset = resp.get_dsts();
+          if (dataset == nullptr) {
+            continue;
+          }
+          dataset->colNames = expand_->colNames();
+          ds.append(std::move(*dataset));
+        }
+        ResultBuilder builder;
+        builder.state(completeness.value());
+        builder.value(Value(std::move(ds))).iter(Iterator::Kind::kSequential);
+        finish(builder.build());
+        return folly::makeFuture<Status>(Status::OK());
+      });
+}
+
+folly::Future<Status> ExpandExecutor::fallbackMinus(std::vector<Value> vids) {
+  StorageClient* storageClient = qctx_->getStorageClient();
+  StorageClient::CommonRequestParam param(expand_->space(),
+                                          qctx_->rctx()->session()->id(),
+                                          qctx_->plan()->id(),
+                                          qctx_->plan()->isProfileEnabled());
+  // StorageRpcResponse has a const member, so it cannot be move-assigned into
+  // the vector folly::collect builds. Chain the two scans and keep only rows.
+  return storageClient->getDstBySrc(param, vids, expand_->edgeTypes())
+      .via(runner())
+      .thenValue([this, param, vids](StorageRpcResponse<GetDstBySrcResponse>&& left) {
+        memory::MemoryCheckGuard guard;
+        SCOPED_TIMER(&execTime_);
+        auto leftComplete = handleCompleteness(left, FLAGS_accept_partial_success);
+        if (!leftComplete.ok()) {
+          return folly::makeFuture<Status>(leftComplete.status());
+        }
+        std::vector<Row> leftRows;
+        for (auto& resp : left.responses()) {
+          auto* dataset = resp.get_dsts();
+          if (dataset == nullptr) {
+            continue;
+          }
+          for (auto& row : dataset->rows) {
+            leftRows.emplace_back(std::move(row));
+          }
+        }
+        auto leftState = leftComplete.value();
+        return qctx_->getStorageClient()
+            ->getDstBySrc(param, vids, expand_->minusEdgeTypes())
+            .via(runner())
+            .thenValue([this, leftRows = std::move(leftRows), leftState](
+                           StorageRpcResponse<GetDstBySrcResponse>&& right) mutable {
+              memory::MemoryCheckGuard innerGuard;
+              SCOPED_TIMER(&execTime_);
+              auto rightComplete = handleCompleteness(right, FLAGS_accept_partial_success);
+              if (!rightComplete.ok()) {
+                return folly::makeFuture<Status>(rightComplete.status());
+              }
+              robin_hood::unordered_flat_set<Value, std::hash<Value>> ban;
+              for (auto& resp : right.responses()) {
+                auto* dataset = resp.get_dsts();
+                if (dataset == nullptr) {
+                  continue;
+                }
+                for (auto& row : dataset->rows) {
+                  if (!row.values.empty()) {
+                    ban.emplace(row.values[0]);
+                  }
+                }
+              }
+              DataSet ds;
+              ds.colNames = expand_->colNames();
+              for (auto& row : leftRows) {
+                if (row.values.empty() || ban.find(row.values[0]) != ban.end()) {
+                  continue;
+                }
+                ds.rows.emplace_back(std::move(row));
+              }
+              auto state = leftState;
+              if (rightComplete.value() != Result::State::kSuccess) {
+                state = rightComplete.value();
+              }
+              ResultBuilder builder;
+              builder.state(state);
+              builder.value(Value(std::move(ds))).iter(Iterator::Kind::kSequential);
+              finish(builder.build());
+              return folly::makeFuture<Status>(Status::OK());
+            });
+      });
+}
