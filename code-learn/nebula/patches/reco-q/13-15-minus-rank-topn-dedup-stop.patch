+using nebula::graph::ExpandAll;
+using nebula::graph::PlanNode;
+using nebula::graph::Project;
+using nebula::graph::TopN;
+
+namespace nebula {
+namespace opt {
+
+std::unique_ptr<OptRule> PushRankTopNDownExpandAllRule::kInstance =
+    std::unique_ptr<PushRankTopNDownExpandAllRule>(new PushRankTopNDownExpandAllRule());
+
+const Pattern& PushRankTopNDownExpandAllRule::pattern() const {
+  static Pattern pattern = Pattern::create(
+      graph::PlanNode::Kind::kTopN,
+      {Pattern::create(graph::PlanNode::Kind::kProject,
+                       {Pattern::create(graph::PlanNode::Kind::kExpandAll)})});
+  return pattern;
+}
+
+namespace {
+
+const Expression* orderedExpr(const TopN* topn, const Project* project, const ExpandAll* expand) {
+  if (topn->factors().size() != 1 || project->columns() == nullptr) {
+    return nullptr;
+  }
+  auto index = topn->factors()[0].first;
+  if (index >= topn->colNames().size()) {
+    return nullptr;
+  }
+  const auto& name = topn->colNames()[index];
+  const Expression* expr = nullptr;
+  for (auto* col : project->columns()->columns()) {
+    if (col == nullptr || col->expr() == nullptr) {
+      continue;
+    }
+    if (col->alias() == name || col->name() == name) {
+      expr = col->expr();
+      break;
+    }
+  }
+  if (expr == nullptr) {
+    return nullptr;
+  }
+  if (expr->kind() != Expression::Kind::kVarProperty &&
+      expr->kind() != Expression::Kind::kInputProperty) {
+    return expr;
+  }
+  if (expand->edgeColumns() == nullptr) {
+    return nullptr;
+  }
+  auto prop = static_cast<const PropertyExpression*>(expr)->prop();
+  for (auto* col : expand->edgeColumns()->columns()) {
+    if (col == nullptr || col->expr() == nullptr) {
+      continue;
+    }
+    if (col->alias() == prop || col->name() == prop) {
+      return col->expr();
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+bool PushRankTopNDownExpandAllRule::match(OptContext* ctx, const MatchedResult& matched) const {
+  if (!FLAGS_enable_traverse_rank_topn) {
+    return false;
+  }
+  if (!OptRule::match(ctx, matched)) {
+    return false;
+  }
+  auto* topn = static_cast<const TopN*>(matched.planNode({0}));
+  auto* project = static_cast<const Project*>(matched.planNode({0, 0}));
+  auto* expand = static_cast<const ExpandAll*>(matched.planNode({0, 0, 0}));
+  if (expand->rankTopN() > 0) {
+    return false;
+  }
+  if (topn->offset() != 0 || topn->count() <= 0) {
+    return false;
+  }
+  if (topn->factors().size() != 1 ||
+      topn->factors()[0].second != OrderFactor::OrderType::DESCEND) {
+    return false;
+  }
+  if (expand->minSteps() != 1 || expand->maxSteps() != 1 || expand->sample() ||
+      expand->joinInput() || !expand->stepLimits().empty()) {
+    return false;
+  }
+  if (expand->vertexColumns() != nullptr && !expand->vertexColumns()->columns().empty()) {
+    return false;
+  }
+  if (expand->vertexProps() != nullptr && !expand->vertexProps()->empty()) {
+    return false;
+  }
+  auto* expr = orderedExpr(topn, project, expand);
+  return expr != nullptr && expr->kind() == Expression::Kind::kEdgeRank;
+}
+
+StatusOr<OptRule::TransformResult> PushRankTopNDownExpandAllRule::transform(
+    OptContext* ctx, const MatchedResult& matched) const {
+  auto* topnGN = matched.node;
+  auto* projectGN = matched.dependencies.front().node;
+  auto* expandGN = matched.dependencies.front().dependencies.front().node;
+  const auto* topn = static_cast<const TopN*>(topnGN->node());
+  const auto* project = static_cast<const Project*>(projectGN->node());
+  const auto* expand = static_cast<const ExpandAll*>(expandGN->node());
+
+  auto* newTopN = static_cast<TopN*>(topn->clone());
+  newTopN->setOutputVar(topn->outputVar());
+  auto* newTopNGN = OptGroupNode::create(ctx, newTopN, topnGN->group());
+
+  auto* newProject = static_cast<Project*>(project->clone());
+  auto* newExpand = static_cast<ExpandAll*>(expand->clone());
+  newExpand->setRankTopN(topn->count());
+  newProject->setInputVar(newExpand->outputVar());
+  newTopN->setInputVar(newProject->outputVar());
+
+  auto* projectGroup = OptGroup::create(ctx);
+  auto* newProjectGN = projectGroup->makeGroupNode(newProject);
+  auto* expandGroup = OptGroup::create(ctx);
+  auto* newExpandGN = expandGroup->makeGroupNode(newExpand);
+  for (auto* dep : expandGN->dependencies()) {
+    newExpandGN->dependsOn(dep);
+  }
+  newProjectGN->dependsOn(expandGroup);
+  newTopNGN->dependsOn(projectGroup);
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(newTopNGN);
+  return result;
+}
+
+std::string PushRankTopNDownExpandAllRule::toString() const {
+  return "PushRankTopNDownExpandAllRule";
+}
+
+}  // namespace opt
+}  // namespace nebula
