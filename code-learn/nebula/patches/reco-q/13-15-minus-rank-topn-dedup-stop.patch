+
+nebula::cpp2::ErrorCode GetDstBySrcProcessor::minusPart(PartitionID partId,
+                                                       const std::vector<Value>& srcIds,
+                                                       std::deque<Value>* out) {
+  std::deque<Value> left;
+  std::deque<Value> right;
+  auto code = scanDsts(&edgeContext_, partId, srcIds, &left);
+  if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+    return code;
+  }
+  code = scanDsts(&minusContext_, partId, srcIds, &right);
+  if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+    return code;
+  }
+  // Set difference, then the caller dedups. A dst present on either side once
+  // is enough: graphd MINUS also compares the already-distinct dst sets.
+  robin_hood::unordered_flat_set<Value, std::hash<Value>> ban;
+  ban.reserve(right.size());
+  for (auto& value : right) {
+    ban.emplace(std::move(value));
+  }
+  for (auto& value : left) {
+    if (ban.find(value) == ban.end()) {
+      out->emplace_back(std::move(value));
+    }
+  }
+  return nebula::cpp2::ErrorCode::SUCCEEDED;
+}
