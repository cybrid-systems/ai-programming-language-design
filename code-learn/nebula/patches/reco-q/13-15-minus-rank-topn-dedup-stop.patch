@@ -0,0 +1,85 @@
+/* Copyright (c) 2026 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include "graph/optimizer/rule/PushDedupLimitStopRule.h"
+
+#include "graph/optimizer/OptContext.h"
+#include "graph/optimizer/OptGroup.h"
+#include "graph/planner/plan/PlanNode.h"
+#include "graph/planner/plan/Query.h"
+#include "graph/service/GraphFlags.h"
+#include "graph/util/ExpressionUtils.h"
+
+using nebula::graph::Dedup;
+using nebula::graph::Limit;
+using nebula::graph::PlanNode;
+
+namespace nebula {
+namespace opt {
+
+std::unique_ptr<OptRule> PushDedupLimitStopRule::kInstance =
+    std::unique_ptr<PushDedupLimitStopRule>(new PushDedupLimitStopRule());
+
+const Pattern& PushDedupLimitStopRule::pattern() const {
+  static Pattern pattern = Pattern::create(
+      graph::PlanNode::Kind::kLimit, {Pattern::create(graph::PlanNode::Kind::kDedup)});
+  return pattern;
+}
+
+bool PushDedupLimitStopRule::match(OptContext* ctx, const MatchedResult& matched) const {
+  if (!FLAGS_enable_dedup_limit_stop) {
+    return false;
+  }
+  if (!OptRule::match(ctx, matched)) {
+    return false;
+  }
+  auto* limit = static_cast<const Limit*>(matched.planNode({0}));
+  auto* dedup = static_cast<const Dedup*>(matched.planNode({0, 0}));
+  if (dedup->stopAfter() >= 0) {
+    return false;
+  }
+  if (limit->offset() != 0 || limit->countExpr() == nullptr) {
+    return false;
+  }
+  if (!graph::ExpressionUtils::isEvaluableExpr(limit->countExpr(), ctx->qctx())) {
+    return false;
+  }
+  return limit->count(ctx->qctx()) > 0;
+}
+
+StatusOr<OptRule::TransformResult> PushDedupLimitStopRule::transform(
+    OptContext* ctx, const MatchedResult& matched) const {
+  auto* limitGN = matched.node;
+  auto* dedupGN = matched.dependencies.front().node;
+  const auto* limit = static_cast<const Limit*>(limitGN->node());
+  const auto* dedup = static_cast<const Dedup*>(dedupGN->node());
+
+  auto* newLimit = static_cast<Limit*>(limit->clone());
+  newLimit->setOutputVar(limit->outputVar());
+  auto* newLimitGN = OptGroupNode::create(ctx, newLimit, limitGN->group());
+
+  auto* newDedup = static_cast<Dedup*>(dedup->clone());
+  newDedup->setStopAfter(limit->count(ctx->qctx()));
+  newLimit->setInputVar(newDedup->outputVar());
+
+  auto* dedupGroup = OptGroup::create(ctx);
+  auto* newDedupGN = dedupGroup->makeGroupNode(newDedup);
+  for (auto* dep : dedupGN->dependencies()) {
+    newDedupGN->dependsOn(dep);
+  }
+  newLimitGN->dependsOn(dedupGroup);
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(newLimitGN);
+  return result;
+}
+
+std::string PushDedupLimitStopRule::toString() const {
+  return "PushDedupLimitStopRule";
+}
+
+}  // namespace opt
+}  // namespace nebula
