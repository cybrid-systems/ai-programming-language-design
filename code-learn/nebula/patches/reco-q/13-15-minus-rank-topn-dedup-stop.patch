+using nebula::graph::Dedup;
+using nebula::graph::Expand;
+using nebula::graph::PlanNode;
+using nebula::graph::Project;
+
+namespace nebula {
+namespace opt {
+
+std::unique_ptr<OptRule> PushMinusDownGetDstRule::kInstance =
+    std::unique_ptr<PushMinusDownGetDstRule>(new PushMinusDownGetDstRule());
+
+const Pattern& PushMinusDownGetDstRule::pattern() const {
+  static Pattern pattern = Pattern::create(
+      graph::PlanNode::Kind::kMinus,
+      {Pattern::create(graph::PlanNode::Kind::kProject,
+                       {Pattern::create(graph::PlanNode::Kind::kDedup,
+                                        {Pattern::create(graph::PlanNode::Kind::kExpand)})}),
+       Pattern::create(graph::PlanNode::Kind::kProject,
+                       {Pattern::create(graph::PlanNode::Kind::kDedup,
+                                        {Pattern::create(graph::PlanNode::Kind::kExpand)})})});
+  return pattern;
+}
+
+namespace {
+
+bool columnZero(const Project* project) {
+  if (project == nullptr || project->columns() == nullptr) {
+    return false;
+  }
+  auto cols = project->columns()->columns();
+  if (cols.size() != 1 || cols[0] == nullptr || cols[0]->expr() == nullptr) {
+    return false;
+  }
+  return cols[0]->expr()->kind() == Expression::Kind::kColumn &&
+         cols[0]->expr()->toString() == "COLUMN[0]";
+}
+
+// buildConstantInput writes one vid column into this variable before optimize.
+bool singleVid(graph::QueryContext* qctx, const std::string& var, Value* vid) {
+  if (qctx == nullptr || var.empty() || vid == nullptr) {
+    return false;
+  }
+  const auto& result = qctx->ectx()->getResult(var);
+  auto* iter = result.iterRef();
+  if (iter == nullptr || iter->size() != 1) {
+    return false;
+  }
+  if (!iter->valid()) {
+    iter->reset();
+  }
+  if (!iter->valid()) {
+    return false;
+  }
+  *vid = iter->getColumn(0);
+  return vid->isInt();
+}
+
+bool fusibleExpand(const Expand* expand) {
+  return expand != nullptr && expand->maxSteps() == 1 && !expand->joinInput() &&
+         !expand->sample() && expand->stepLimits().empty() && expand->partialAggs().empty() &&
+         expand->minusEdgeTypes().empty() && expand->filter() == nullptr &&
+         expand->edgeTypes().size() == 1 && expand->edgeTypes()[0] != 0;
+}
+
+}  // namespace
+
+bool PushMinusDownGetDstRule::match(OptContext* ctx, const MatchedResult& matched) const {
+  if (!FLAGS_enable_minus_fusion) {
+    return false;
+  }
+  if (!OptRule::match(ctx, matched)) {
+    return false;
+  }
+  auto* leftProject = static_cast<const Project*>(matched.planNode({0, 0}));
+  auto* rightProject = static_cast<const Project*>(matched.planNode({0, 1}));
+  auto* left = static_cast<const Expand*>(matched.planNode({0, 0, 0, 0}));
+  auto* right = static_cast<const Expand*>(matched.planNode({0, 1, 0, 0}));
+  if (!columnZero(leftProject) || !columnZero(rightProject)) {
+    return false;
+  }
+  if (leftProject->colNames().size() != 1) {
+    return false;
+  }
+  if (!fusibleExpand(left) || !fusibleExpand(right)) {
+    return false;
+  }
+  if (left->space() != right->space()) {
+    return false;
+  }
+  auto leftType = left->edgeTypes()[0];
+  auto rightType = right->edgeTypes()[0];
+  // Same direction. A positive type is outgoing. Different types: subtracting
+  // an edge from itself is not the Q2 expose-minus-buy shape.
+  if (leftType == rightType || (leftType > 0) != (rightType > 0)) {
+    return false;
+  }
+  Value leftVid;
+  Value rightVid;
+  if (!singleVid(ctx->qctx(), left->inputVar(), &leftVid) ||
+      !singleVid(ctx->qctx(), right->inputVar(), &rightVid) || leftVid != rightVid) {
+    return false;
+  }
+  return true;
+}
+
+StatusOr<OptRule::TransformResult> PushMinusDownGetDstRule::transform(
+    OptContext* ctx, const MatchedResult& matched) const {
+  auto* qctx = ctx->qctx();
+  auto* minus = matched.planNode();
+  auto* leftProject = static_cast<const Project*>(matched.planNode({0, 0}));
+  auto* leftExpand = static_cast<const Expand*>(matched.planNode({0, 0, 0, 0}));
+  auto* rightExpand = static_cast<const Expand*>(matched.planNode({0, 1, 0, 0}));
+  const auto* leftExpandGN = matched.result({0, 0, 0, 0}).node;
+
+  auto* expand = static_cast<Expand*>(leftExpand->clone());
+  expand->setMinusEdgeTypes(rightExpand->edgeTypes());
+
+  auto* expandGroup = OptGroup::create(ctx);
+  auto* expandGN = expandGroup->makeGroupNode(expand);
+  for (auto* dep : leftExpandGN->dependencies()) {
+    expandGN->dependsOn(dep);
+  }
+
+  auto* dedup = Dedup::make(qctx, nullptr);
+  dedup->setInputVar(expand->outputVar());
+  dedup->setColNames(expand->colNames());
+  auto* dedupGroup = OptGroup::create(ctx);
+  auto* dedupGN = dedupGroup->makeGroupNode(dedup);
+  dedupGN->dependsOn(expandGroup);
+
+  auto* pool = qctx->objPool();
+  auto* cols = pool->makeAndAdd<YieldColumns>();
+  auto alias = leftProject->colNames().empty() ? std::string() : leftProject->colNames().front();
+  cols->addColumn(new YieldColumn(ColumnExpression::make(pool, 0), alias));
+  auto* project = Project::make(qctx, nullptr, cols);
+  // The Minus group already publishes this variable. Point at it before
+  // writing column names; setOutputVar swaps the variable pointer.
+  project->setOutputVar(minus->outputVar());
+  project->setColNames(leftProject->colNames());
+  project->setInputVar(dedup->outputVar());
+  auto* projectGN = OptGroupNode::create(ctx, project, matched.node->group());
+  projectGN->dependsOn(dedupGroup);
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(projectGN);
+  return result;
+}
+
+std::string PushMinusDownGetDstRule::toString() const {
+  return "PushMinusDownGetDstRule";
+}
