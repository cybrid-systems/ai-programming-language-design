+#ifndef GRAPH_OPTIMIZER_RULE_PUSHRANKTOPNDOWNEXPANDALLRULE_H_
+#define GRAPH_OPTIMIZER_RULE_PUSHRANKTOPNDOWNEXPANDALLRULE_H_
+
+#include "graph/optimizer/OptRule.h"
+
+namespace nebula {
+namespace opt {
+
+// Annotate a 1-step ExpandAll with the TopN count when the order key is the
+// edge rank, descending.
+//
+//   TopN(ORDER BY rank DESC, LIMIT K)
+//     Project
+//       ExpandAll
+//
+// The TopN node stays. Storaged keeps every filtered edge whose rank is at
+// least the Kth on that vertex, including ties. The global top K is a subset
+// of the per-vertex top K, so graphd TopN still produces the same rows.
+//
+// Does not use TraverseSpec.limit. An older storaged treats that field as the
+// first N edges in scan order, which is the oldest rank. A missing
+// rank_topn_applied ack leaves the full scan for graphd TopN.
+//
+// Requires --enable_traverse_rank_topn.
+class PushRankTopNDownExpandAllRule final : public OptRule {
+ public:
+  const Pattern& pattern() const override;
+
+  bool match(OptContext* ctx, const MatchedResult& matched) const override;
+
+  StatusOr<TransformResult> transform(OptContext* ctx, const MatchedResult& matched) const override;
+
+  std::string toString() const override;
+
+ private:
+  PushRankTopNDownExpandAllRule() {
+    RuleSet::QueryRules().addRule(this);
+  }
+
+  static std::unique_ptr<OptRule> kInstance;
+};
+
+}  // namespace opt
+}  // namespace nebula
