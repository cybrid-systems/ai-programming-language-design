+struct RankBounds {
+  bool hasLo{false};
+  bool hasHi{false};
+  EdgeRanking lo{0};
+  EdgeRanking hi{0};
+};
+
+void intersectRankBounds(RankBounds& dst, const RankBounds& src) {
+  if (src.hasLo) {
+    if (!dst.hasLo || src.lo > dst.lo) {
+      dst.lo = src.lo;
+      dst.hasLo = true;
+    }
+  }
+  if (src.hasHi) {
+    if (!dst.hasHi || src.hi < dst.hi) {
+      dst.hi = src.hi;
+      dst.hasHi = true;
+    }
+  }
+}
+
+// Exact rank window. `edge._rank` parses as kEdgeRank, not kEdgeProperty.
+// GetDstBySrc never evaluates EdgeNode::exp_, so a superset bound would
+// change results. An empty window is encoded as lo > hi.
+bool extractRankBounds(const Expression* expr, const std::string& edgeName, RankBounds& out) {
+  if (expr == nullptr) {
+    return false;
+  }
+  switch (expr->kind()) {
+    case Expression::Kind::kLogicalAnd: {
+      const auto* logic = static_cast<const LogicalExpression*>(expr);
+      bool any = false;
+      for (auto* operand : logic->operands()) {
+        RankBounds sub;
+        if (extractRankBounds(operand, edgeName, sub)) {
+          intersectRankBounds(out, sub);
+          any = true;
+        }
+      }
+      return any;
+    }
+    case Expression::Kind::kLogicalOr:
+      return false;
+    case Expression::Kind::kRelEQ:
+    case Expression::Kind::kRelLT:
+    case Expression::Kind::kRelLE:
+    case Expression::Kind::kRelGT:
+    case Expression::Kind::kRelGE: {
+      const auto* rel = static_cast<const RelationalExpression*>(expr);
+      const Expression* left = rel->left();
+      const Expression* right = rel->right();
+      bool swapped = false;
+      const auto rankKind = [](Expression::Kind kind) {
+        return kind == Expression::Kind::kEdgeRank || kind == Expression::Kind::kEdgeProperty;
+      };
+      if (left->kind() == Expression::Kind::kConstant && rankKind(right->kind())) {
+        std::swap(left, right);
+        swapped = true;
+      }
+      if (!rankKind(left->kind()) || right->kind() != Expression::Kind::kConstant) {
+        return false;
+      }
+      const auto* prop = static_cast<const PropertyExpression*>(left);
+      if (prop->prop() != "_rank" || prop->sym() != edgeName) {
+        return false;
+      }
+      const auto* constant = static_cast<const ConstantExpression*>(right);
+      if (!constant->value().isInt()) {
+        return false;
+      }
+      const EdgeRanking v = constant->value().getInt();
+      auto kind = expr->kind();
+      if (swapped) {
+        switch (kind) {
+          case Expression::Kind::kRelLT:
+            kind = Expression::Kind::kRelGT;
+            break;
+          case Expression::Kind::kRelLE:
+            kind = Expression::Kind::kRelGE;
+            break;
+          case Expression::Kind::kRelGT:
+            kind = Expression::Kind::kRelLT;
+            break;
+          case Expression::Kind::kRelGE:
+            kind = Expression::Kind::kRelLE;
+            break;
+          default:
+            break;
+        }
+      }
+      switch (kind) {
+        case Expression::Kind::kRelGE:
+          out.hasLo = true;
+          out.lo = v;
+          return true;
+        case Expression::Kind::kRelGT:
+          if (v == std::numeric_limits<EdgeRanking>::max()) {
+            out.hasLo = out.hasHi = true;
+            out.lo = 0;
+            out.hi = -1;
+            return true;
+          }
+          out.hasLo = true;
+          out.lo = v + 1;
+          return true;
+        case Expression::Kind::kRelLE:
+          out.hasHi = true;
+          out.hi = v;
+          return true;
+        case Expression::Kind::kRelLT:
+          if (v == std::numeric_limits<EdgeRanking>::min()) {
+            out.hasLo = out.hasHi = true;
+            out.lo = 0;
+            out.hi = -1;
+            return true;
+          }
+          out.hasHi = true;
+          out.hi = v - 1;
+          return true;
+        case Expression::Kind::kRelEQ:
+          out.hasLo = out.hasHi = true;
+          out.lo = out.hi = v;
+          return true;
+        default:
+          return false;
+      }
+    }
+    default:
+      return false;
+  }
+}
+
+std::optional<RankRange> extractRankRange(const Expression* filter, const std::string& edgeName) {
+  RankBounds bounds;
+  if (!extractRankBounds(filter, edgeName, bounds)) {
+    return std::nullopt;
+  }
+  if (!bounds.hasLo && !bounds.hasHi) {
+    return std::nullopt;
+  }
+  RankRange range;
+  if (bounds.hasLo) {
+    range.lo = bounds.lo;
+  }
+  if (bounds.hasHi) {
+    range.hi = bounds.hi;
+  }
+  return range;
+}
+
