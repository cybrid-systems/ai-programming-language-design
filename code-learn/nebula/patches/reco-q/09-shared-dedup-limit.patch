@@ -0,0 +1,49 @@
+/* Copyright (c) 2024 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#ifndef GRAPH_OPTIMIZER_RULE_PUSHDISTINCTLIMITDOWNJOINEXPANDRULE_H_
+#define GRAPH_OPTIMIZER_RULE_PUSHDISTINCTLIMITDOWNJOINEXPANDRULE_H_
+
+#include "graph/optimizer/OptRule.h"
+
+namespace nebula {
+namespace opt {
+
+// Collapse the multi-source input-join shape used by a second GO:
+//
+//   Limit(k) -> Dedup -> HashInnerJoin
+//                    (left: source VIDs, right: ExpandAll(joinInput, filter))
+//
+// into a single storage-backed expand:
+//
+//   Limit(k) -> Dedup -> Expand(dedup, sharedDedupLimit, limit=k, filter)
+//
+// All source VIDs are routed to their owning storaged in one request.  The
+// storage side shares one visited set across sources/partitions, applies the
+// rank filter before inserting a dst, and stops after k distinct dsts.  The
+// graph side still performs the final global Dedup and Limit.
+//
+// The rewrite is only safe when the join output is just the projected dst
+// column, the right side is a one-step ExpandAll with joinInput=true, and the
+// filter is a rank-only conjunction (e.g. C's Q4 window).
+class PushDistinctLimitDownJoinExpandRule final : public OptRule {
+ public:
+  const Pattern &pattern() const override;
+
+  StatusOr<OptRule::TransformResult> transform(OptContext *ctx,
+                                               const MatchedResult &matched) const override;
+
+  std::string toString() const override;
+
+ private:
+  PushDistinctLimitDownJoinExpandRule();
+
+  static std::unique_ptr<OptRule> kInstance;
+};
+
+}  // namespace opt
+}  // namespace nebula
+
+#endif  // GRAPH_OPTIMIZER_RULE_PUSHDISTINCTLIMITDOWNJOINEXPANDRULE_H_
