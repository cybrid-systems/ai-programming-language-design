diff --git a/src/graph/optimizer/rule/PushDistinctLimitDownJoinExpandRule.cpp b/src/graph/optimizer/rule/PushDistinctLimitDownJoinExpandRule.cpp
new file mode 100644
index 0000000..d816fe0
--- /dev/null
+++ b/src/graph/optimizer/rule/PushDistinctLimitDownJoinExpandRule.cpp
@@ -0,0 +1,314 @@
+/* Copyright (c) 2024 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include "graph/optimizer/rule/PushDistinctLimitDownJoinExpandRule.h"
+
+#include <algorithm>
+
+#include "common/expression/ConstantExpression.h"
+#include "common/expression/LogicalExpression.h"
+#include "common/expression/PropertyExpression.h"
+#include "common/expression/RelationalExpression.h"
+#include "graph/context/QueryContext.h"
+#include "graph/context/Symbols.h"
+#include "graph/optimizer/OptContext.h"
+#include "graph/optimizer/OptGroup.h"
+#include "graph/planner/plan/Logic.h"
+#include "graph/planner/plan/PlanNode.h"
+#include "graph/planner/plan/Query.h"
+#include "graph/util/ExpressionUtils.h"
+#include "common/meta/SchemaManager.h"
+
+using nebula::graph::Dedup;
+using nebula::graph::Expand;
+using nebula::graph::ExpandAll;
+using nebula::graph::HashInnerJoin;
+using nebula::graph::Limit;
+using nebula::graph::PlanNode;
+using nebula::graph::QueryContext;
+
+namespace nebula {
+namespace opt {
+
+namespace {
+
+bool isRankProperty(const Expression* expr, const std::string& edgeName) {
+  if (expr == nullptr ||
+      (expr->kind() != Expression::Kind::kEdgeRank &&
+       expr->kind() != Expression::Kind::kEdgeProperty)) {
+    return false;
+  }
+  const auto* prop = static_cast<const PropertyExpression*>(expr);
+  return prop->prop() == "_rank" && prop->sym() == edgeName;
+}
+
+bool isRankComparison(const Expression* expr, const std::string& edgeName) {
+  if (expr == nullptr) {
+    return false;
+  }
+  if (expr->kind() != Expression::Kind::kRelEQ && expr->kind() != Expression::Kind::kRelLT &&
+      expr->kind() != Expression::Kind::kRelLE && expr->kind() != Expression::Kind::kRelGT &&
+      expr->kind() != Expression::Kind::kRelGE) {
+    return false;
+  }
+  const auto* rel = static_cast<const RelationalExpression*>(expr);
+  const Expression* left = rel->left();
+  const Expression* right = rel->right();
+  if (left->kind() == Expression::Kind::kConstant) {
+    std::swap(left, right);
+  }
+  if (!isRankProperty(left, edgeName) || right->kind() != Expression::Kind::kConstant) {
+    return false;
+  }
+  return static_cast<const ConstantExpression*>(right)->value().isInt();
+}
+
+bool isRankOnlyFilter(const Expression* expr, const std::string& edgeName) {
+  if (expr == nullptr) {
+    return false;
+  }
+  if (expr->kind() == Expression::Kind::kLogicalAnd) {
+    const auto* logic = static_cast<const LogicalExpression*>(expr);
+    if (logic->operands().empty()) {
+      return false;
+    }
+    for (const auto* operand : logic->operands()) {
+      if (!isRankOnlyFilter(operand, edgeName)) {
+        return false;
+      }
+    }
+    return true;
+  }
+  return isRankComparison(expr, edgeName);
+}
+
+bool isDstExpression(const Expression* expr) {
+  if (expr == nullptr) {
+    return false;
+  }
+  if (expr->kind() == Expression::Kind::kEdgeDst) {
+    return true;
+  }
+  if (expr->kind() != Expression::Kind::kEdgeProperty) {
+    return false;
+  }
+  const auto* prop = static_cast<const PropertyExpression*>(expr);
+  return prop->prop() == "_dst";
+}
+
+bool isInputColumn(const Expression* expr, const std::string& column) {
+  if (expr == nullptr ||
+      (expr->kind() != Expression::Kind::kInputProperty &&
+       expr->kind() != Expression::Kind::kVarProperty)) {
+    return false;
+  }
+  const auto* prop = static_cast<const PropertyExpression*>(expr);
+  return prop->prop() == column;
+}
+
+bool isExpandVidKey(const Expression* expr, const std::string& expandVar) {
+  if (expr == nullptr ||
+      (expr->kind() != Expression::Kind::kVarProperty &&
+       expr->kind() != Expression::Kind::kInputProperty)) {
+    return false;
+  }
+  const auto* prop = static_cast<const PropertyExpression*>(expr);
+  if (prop->prop() != "_expand_vid") {
+    return false;
+  }
+  return prop->kind() == Expression::Kind::kInputProperty ||
+         prop->sym() == expandVar || prop->sym().empty();
+}
+
+const graph::PlanNode* writerOf(const std::string& var, QueryContext* qctx) {
+  auto* variable = qctx->symTable()->getVar(var);
+  if (variable == nullptr || variable->writtenBy.size() != 1) {
+    return nullptr;
+  }
+  return *variable->writtenBy.begin();
+}
+
+bool rightInputComesFrom(const ExpandAll* expandAll,
+                         const std::string& leftInputVar,
+                         const std::string& leftColumn,
+                         QueryContext* qctx) {
+  std::string var = expandAll->inputVar();
+  for (int depth = 0; depth < 5 && !var.empty(); ++depth) {
+    const auto* writer = writerOf(var, qctx);
+    if (writer == nullptr) {
+      return false;
+    }
+    if (writer->inputVar() == leftInputVar) {
+      return true;
+    }
+    // Argument nodes are materialized from a named column and may not have
+    // inputVar populated at optimization time; its alias is the source column.
+    if (writer->kind() == PlanNode::Kind::kArgument) {
+      const auto* arg = static_cast<const graph::Argument*>(writer);
+      if (arg->getAlias() == leftColumn) {
+        return true;
+      }
+    }
+    var = writer->inputVar();
+  }
+  return false;
+}
+
+}  // namespace
+
+std::unique_ptr<OptRule> PushDistinctLimitDownJoinExpandRule::kInstance =
+    std::unique_ptr<PushDistinctLimitDownJoinExpandRule>(
+        new PushDistinctLimitDownJoinExpandRule());
+
+PushDistinctLimitDownJoinExpandRule::PushDistinctLimitDownJoinExpandRule() {
+  RuleSet::QueryRules().addRule(this);
+}
+
+const Pattern& PushDistinctLimitDownJoinExpandRule::pattern() const {
+  static Pattern pattern = Pattern::create(
+      PlanNode::Kind::kLimit,
+      {Pattern::create(
+          PlanNode::Kind::kDedup,
+          {Pattern::create(
+              PlanNode::Kind::kHashInnerJoin,
+              {Pattern::create(PlanNode::Kind::kUnknown),
+               Pattern::create(PlanNode::Kind::kUnknown)})})});
+  return pattern;
+}
+
+StatusOr<OptRule::TransformResult> PushDistinctLimitDownJoinExpandRule::transform(
+    OptContext* octx, const MatchedResult& matched) const {
+  auto* qctx = octx->qctx();
+  const auto* limitGroupNode = matched.node;
+  const auto* dedupGroupNode = matched.dependencies.front().node;
+  const auto* joinGroupNode = matched.dependencies.front().dependencies.front().node;
+  const auto* limit = static_cast<const Limit*>(limitGroupNode->node());
+  const auto* dedup = static_cast<const Dedup*>(dedupGroupNode->node());
+  const auto* join = static_cast<const HashInnerJoin*>(joinGroupNode->node());
+  const auto* rightNode = matched.planNode({0, 0, 0, 1});
+  if (rightNode->kind() != PlanNode::Kind::kExpandAll) {
+    return TransformResult::noTransform();
+  }
+  const auto* expandAll = static_cast<const ExpandAll*>(rightNode);
+
+  // The join output must be exactly one projected edge dst column, must be
+  // the sole consumer of the join, and its hash/probe keys must tie the left
+  // input VIDs to the right ExpandAll's _expand_vid.  A one-column check alone
+  // would also accept YIELD DISTINCT edge._rank AS r.
+  if (join->colNames().size() != 1 || !join->hasOutputColumns() ||
+      join->outputColumns().size() != 1 || dedup->inputVar() != join->outputVar() ||
+      limit->inputVar() != dedup->outputVar() || join->outputVar().empty() ||
+      expandAll->edgeColumns() == nullptr || join->hashKeys().size() != 1 ||
+      join->probeKeys().size() != 1) {
+    return TransformResult::noTransform();
+  }
+  auto* joinVar = qctx->symTable()->getVar(join->outputVar());
+  if (joinVar == nullptr || joinVar->readBy.size() != 1) {
+    return TransformResult::noTransform();
+  }
+  const auto* leftVar = qctx->symTable()->getVar(join->leftInputVar());
+  if (leftVar == nullptr || leftVar->colNames.size() != 1 ||
+      !isInputColumn(join->hashKeys().front(), leftVar->colNames.front()) ||
+      !isExpandVidKey(join->probeKeys().front(), expandAll->outputVar()) ||
+      !rightInputComesFrom(expandAll, join->leftInputVar(), leftVar->colNames.front(), qctx)) {
+    std::string hk = join->hashKeys().empty() ? "none" : join->hashKeys().front()->toString();
+    std::string pk = join->probeKeys().empty() ? "none" : join->probeKeys().front()->toString();
+    return TransformResult::noTransform();
+  }
+  const auto& outputColumn = join->outputColumns().front();
+  if (outputColumn.alias != join->colNames().front()) {
+    return TransformResult::noTransform();
+  }
+  const Expression* projectedExpr = nullptr;
+  for (const auto* column : expandAll->edgeColumns()->columns()) {
+    if (column != nullptr && column->alias() == outputColumn.source) {
+      projectedExpr = column->expr();
+      break;
+    }
+  }
+  if (!isDstExpression(projectedExpr)) {
+    return TransformResult::noTransform();
+  }
+
+  // This is the GO FROM <variable> shape: the right side preserves the source
+  // association and is joined back to the input VIDs.  Only a one-step,
+  // one-edge-type, rank-filtered expansion can be converted to GetDstBySrc.
+  // For joinInput plans GoPlanner may leave edgeTypes empty and encode the
+  // direction in edgeProps instead, so recover it before matching.
+  std::vector<EdgeType> edgeTypes = expandAll->edgeTypes();
+  if (edgeTypes.empty() && expandAll->edgeProps() != nullptr) {
+    for (const auto& prop : *expandAll->edgeProps()) {
+      if (std::find(edgeTypes.begin(), edgeTypes.end(), prop.get_type()) == edgeTypes.end()) {
+        edgeTypes.emplace_back(prop.get_type());
+      }
+    }
+  }
+  if (expandAll->maxSteps() != 1 || expandAll->sample() || !expandAll->joinInput() ||
+      !expandAll->stepLimits().empty() || edgeTypes.size() != 1 ||
+      expandAll->filter() == nullptr || join->hashKeys().size() != 1 ||
+      join->probeKeys().size() != 1) {
+    return TransformResult::noTransform();
+  }
+
+  const auto edgeType = edgeTypes.front();
+  const auto edgeName = qctx->schemaMng()->toEdgeName(
+      expandAll->space(), edgeType < 0 ? -edgeType : edgeType);
+  if (!edgeName.ok() || !isRankOnlyFilter(expandAll->filter(), edgeName.value())) {
+    return TransformResult::noTransform();
+  }
+
+  if (!graph::ExpressionUtils::isEvaluableExpr(limit->countExpr())) {
+    return TransformResult::noTransform();
+  }
+  const int64_t offset = std::max<int64_t>(limit->offset(), 0);
+  const int64_t count = limit->count(qctx);
+  if (count < 0 || offset > std::numeric_limits<int64_t>::max() - count) {
+    return TransformResult::noTransform();
+  }
+  const int64_t limitRows = offset + count;
+  auto* newExpand = Expand::make(qctx, nullptr, expandAll->space(), false, 1);
+  newExpand->setInputVar(join->leftInputVar());
+  newExpand->setOutputVar(join->outputVar());
+  newExpand->setColNames(join->colNames());
+  newExpand->setEdgeTypes({edgeType});
+  newExpand->setFilter(expandAll->filter()->clone());
+  newExpand->setDedup(true);
+  newExpand->setSharedDedupLimit(true);
+  newExpand->setLimit(limitRows);
+
+  auto* newDedup = static_cast<Dedup*>(dedup->clone());
+  auto* newLimit = static_cast<Limit*>(limit->clone());
+  newDedup->setInputVar(newExpand->outputVar());
+  newDedup->setOutputVar(dedup->outputVar());
+  newLimit->setInputVar(dedup->outputVar());
+  newLimit->setOutputVar(limit->outputVar());
+
+  // The left side is the source VID table.  The right-side ExpandAll and the
+  // join are no longer needed: the new Expand reads the same left variable and
+  // performs the storage-side dedup/filter.
+  auto* leftGroup = const_cast<OptGroup*>(matched.result({0, 0, 0, 0}).node->group());
+  auto* expandGroup = OptGroup::create(octx);
+  auto* expandGroupNode = expandGroup->makeGroupNode(newExpand);
+  expandGroupNode->dependsOn(leftGroup);
+
+  auto* dedupGroup = OptGroup::create(octx);
+  auto* newDedupGroupNode = dedupGroup->makeGroupNode(newDedup);
+  newDedupGroupNode->dependsOn(expandGroup);
+
+  auto* newLimitGroupNode = OptGroupNode::create(octx, newLimit, limitGroupNode->group());
+  newLimitGroupNode->dependsOn(dedupGroup);
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(newLimitGroupNode);
+  return result;
+}
+
+std::string PushDistinctLimitDownJoinExpandRule::toString() const {
+  return "PushDistinctLimitDownJoinExpandRule";
+}
+
+}  // namespace opt
+}  // namespace nebula
