+
+folly::Future<Status> AggregateExecutor::executeCount(size_t countItem) {
+  memory::MemoryCheckGuard guard;
+  auto* agg = asNode<Aggregate>(node());
+  auto iter = ectx_->getResult(agg->inputVar()).iter();
+  const auto* key = static_cast<const PropertyExpression*>(agg->groupKeys().front());
+  auto keyIndex = iter->getColumnIndex(key->prop());
+  if (!keyIndex.ok()) {
+    return Status::Error("aggregate key column is not materialized");
+  }
+
+  using Counts = robin_hood::unordered_flat_map<int64_t, int64_t>;
+  struct Shard {
+    std::unique_ptr<Iterator> iter;
+    size_t size{0};
+    bool bounded{true};
+    Counts counts;
+    bool allInt{true};
+    std::exception_ptr exception;
+  };
+  const bool sizeIsRowCount = iter->isSequentialIter() || iter->isPropIter();
+  const size_t rowCount = sizeIsRowCount ? iter->size() : 0;
+  const unsigned hw = std::max(1U, std::thread::hardware_concurrency());
+  const size_t workerCount = FLAGS_enable_parallel_aggregate && iter->isSequentialIter() &&
+                                     rowCount >= (1U << 20) && hw > 1
+                                 ? std::min<size_t>(8, hw)
+                                 : 1;
+  std::vector<Shard> shards(workerCount);
+  size_t begin = 0;
+  for (size_t i = 0; i < workerCount; ++i) {
+    auto& shard = shards[i];
+    shard.iter = iter->copy();
+    shard.bounded = sizeIsRowCount;
+    shard.size = rowCount / workerCount + (i < rowCount % workerCount ? 1 : 0);
+    if (begin != 0) {
+      shard.iter->reset(begin);
+    }
+    begin += shard.size;
+  }
+
+  std::atomic<bool> stop{false};
+  auto countRows = [&](size_t i) {
+    try {
+      memory::MemoryCheckGuard workerGuard;
+      auto& shard = shards[i];
+      for (size_t row = 0; shard.iter->valid() && (!shard.bounded || row < shard.size);
+           ++row, shard.iter->next()) {
+        if ((row & 1023) == 0) {
+          if (stop.load(std::memory_order_relaxed)) {
+            return;
+          }
+          if (qctx_->isKilled()) {
+            throw std::runtime_error("Execution had been killed");
+          }
+          auto status = checkMemoryWatermark();
+          if (!status.ok()) {
+            throw std::runtime_error(status.toString());
+          }
+        }
+        const auto& value = shard.iter->getColumn(keyIndex.value());
+        if (!value.isInt()) {
+          shard.allInt = false;
+          stop.store(true, std::memory_order_relaxed);
+          return;
+        }
+        auto& count = shard.counts[value.getInt()];
+        if (UNLIKELY(count == std::numeric_limits<int64_t>::max())) {
+          throw std::overflow_error("COUNT overflow");
+        }
+        ++count;
+      }
+    } catch (...) {
+      shards[i].exception = std::current_exception();
+      stop.store(true, std::memory_order_relaxed);
+    }
+  };
+
+  std::vector<std::thread> workers;
+  workers.reserve(workerCount > 0 ? workerCount - 1 : 0);
+  {
+    auto joinWorkers = folly::makeGuard([&] {
+      for (auto& worker : workers) {
+        worker.join();
+      }
+    });
+    try {
+      for (size_t i = 1; i < workerCount; ++i) {
+        workers.emplace_back(countRows, i);
+      }
+      countRows(0);
+    } catch (...) {
+      stop.store(true, std::memory_order_relaxed);
+      throw;
+    }
+  }
+  if (qctx_->isKilled()) {
+    return Status::Error("Execution had been killed");
+  }
+  for (const auto& shard : shards) {
+    if (shard.exception) {
+      std::rethrow_exception(shard.exception);
+    }
+  }
+  if (std::any_of(shards.begin(), shards.end(), [](const Shard& shard) { return !shard.allInt; })) {
+    return Status::Error("COUNT group key is not entirely INT64");
+  }
+
+  auto& counts = shards.front().counts;
+  for (size_t i = 1; i < shards.size(); ++i) {
+    for (const auto& kv : shards[i].counts) {
+      auto& count = counts[kv.first];
+      if (UNLIKELY(count > std::numeric_limits<int64_t>::max() - kv.second)) {
+        return Status::Error("COUNT overflow");
+      }
+      count += kv.second;
+    }
+    Counts().swap(shards[i].counts);
+  }
+
+  DataSet ds;
+  ds.colNames = agg->colNames();
+  ds.rows.reserve(counts.size());
+  for (const auto& kv : counts) {
+    Row row;
+    row.values.reserve(agg->groupItems().size());
+    for (size_t i = 0; i < agg->groupItems().size(); ++i) {
+      row.values.emplace_back(i == countItem ? Value(kv.second) : Value(kv.first));
+    }
+    ds.rows.emplace_back(std::move(row));
+  }
+  return finish(ResultBuilder().value(Value(std::move(ds))).build());
+}
