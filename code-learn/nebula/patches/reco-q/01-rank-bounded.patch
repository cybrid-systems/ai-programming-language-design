+// Inclusive rank bounds for a single source vertex and edge type.
+struct RankRange {
+  std::optional<EdgeRanking> lo;
+  std::optional<EdgeRanking> hi;
+};
+
+// Wraps a prefix iterator and stops once the edge rank exceeds `hi`.
+class RankBoundedKVIterator final : public kvstore::KVIterator {
+ public:
+  RankBoundedKVIterator(std::unique_ptr<kvstore::KVIterator> iter,
+                        size_t vIdLen,
+                        EdgeRanking hi)
+      : iter_(std::move(iter)), vIdLen_(vIdLen), hi_(hi) {}
+
+  bool valid() const override {
+    return iter_ && iter_->valid() &&
+           NebulaKeyUtils::getRank(vIdLen_, iter_->key()) <= hi_;
+  }
+
+  void next() override { iter_->next(); }
+
+  void prev() override { iter_->prev(); }
+
+  folly::StringPiece key() const override { return iter_->key(); }
+
+  folly::StringPiece val() const override { return iter_->val(); }
+
+ private:
+  std::unique_ptr<kvstore::KVIterator> iter_;
+  size_t vIdLen_;
+  EdgeRanking hi_;
+};
