+struct RankBounds {
+  bool hasLo{false};
+  bool hasHi{false};
+  EdgeRanking lo{0};
+  EdgeRanking hi{0};
+};
+
+void intersectRankBounds(RankBounds& dst, const RankBounds& src) {
+  if (src.hasLo) {
+    if (!dst.hasLo || src.lo > dst.lo) {
+      dst.lo = src.lo;
+      dst.hasLo = true;
+    }
+  }
+  if (src.hasHi) {
+    if (!dst.hasHi || src.hi < dst.hi) {
+      dst.hi = src.hi;
+      dst.hasHi = true;
+    }
+  }
+}
+
+bool extractRankBounds(const Expression* expr,
+                       const std::string& edgeName,
+                       RankBounds& out) {
+  if (expr == nullptr) {
+    return false;
+  }
+  switch (expr->kind()) {
+    case Expression::Kind::kLogicalAnd: {
+      const auto* logic = static_cast<const LogicalExpression*>(expr);
+      bool any = false;
+      for (auto* operand : logic->operands()) {
+        RankBounds sub;
+        if (extractRankBounds(operand, edgeName, sub)) {
+          intersectRankBounds(out, sub);
+          any = true;
+        }
+      }
+      return any;
+    }
+    case Expression::Kind::kLogicalOr:
+      // Do not derive a range from OR; only AND is a safe superset.
+      return false;
+    case Expression::Kind::kRelEQ:
+    case Expression::Kind::kRelLT:
+    case Expression::Kind::kRelLE:
+    case Expression::Kind::kRelGT:
+    case Expression::Kind::kRelGE: {
+      const auto* rel = static_cast<const RelationalExpression*>(expr);
+      const Expression* left = rel->left();
+      const Expression* right = rel->right();
+      bool swapped = false;
+      if (left->kind() == Expression::Kind::kConstant &&
+          right->kind() == Expression::Kind::kEdgeProperty) {
+        std::swap(left, right);
+        swapped = true;
+      }
+      if (left->kind() != Expression::Kind::kEdgeProperty ||
+          right->kind() != Expression::Kind::kConstant) {
+        return false;
+      }
+      const auto* prop = static_cast<const EdgePropertyExpression*>(left);
+      if (prop->prop() != "_rank" || prop->sym() != edgeName) {
+        return false;
+      }
+      const auto* constant = static_cast<const ConstantExpression*>(right);
+      if (!constant->value().isInt()) {
+        return false;
+      }
+      const EdgeRanking v = constant->value().getInt();
+      auto kind = expr->kind();
+      if (swapped) {
+        switch (kind) {
+          case Expression::Kind::kRelLT: kind = Expression::Kind::kRelGT; break;
+          case Expression::Kind::kRelLE: kind = Expression::Kind::kRelGE; break;
+          case Expression::Kind::kRelGT: kind = Expression::Kind::kRelLT; break;
+          case Expression::Kind::kRelGE: kind = Expression::Kind::kRelLE; break;
+          default: break;
+        }
+      }
+      // GT/LT use the endpoint itself: the residual filter still runs,
+      // so the range only needs to be a superset (also avoids overflow).
+      switch (kind) {
+        case Expression::Kind::kRelGE:
+        case Expression::Kind::kRelGT:
+          out.hasLo = true;
+          out.lo = v;
+          return true;
+        case Expression::Kind::kRelLE:
+        case Expression::Kind::kRelLT:
+          out.hasHi = true;
+          out.hi = v;
+          return true;
+        case Expression::Kind::kRelEQ:
+          out.hasLo = out.hasHi = true;
+          out.lo = out.hi = v;
+          return true;
+        default:
+          return false;
+      }
+    }
+    default:
+      return false;
+  }
+}
+
+std::optional<RankRange> extractRankRange(const Expression* filter,
+                                          const std::string& edgeName) {
+  RankBounds bounds;
+  if (!extractRankBounds(filter, edgeName, bounds)) {
+    return std::nullopt;
+  }
+  if (!bounds.hasLo && !bounds.hasHi) {
+    return std::nullopt;
+  }
+  RankRange range;
+  if (bounds.hasLo) {
+    range.lo = bounds.lo;
+  }
+  if (bounds.hasHi) {
+    range.hi = bounds.hi;
+  }
+  return range;
+}
