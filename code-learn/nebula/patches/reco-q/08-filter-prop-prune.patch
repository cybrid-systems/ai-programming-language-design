+bool GoValidator::isEdgeOnlyFilter(const Expression* expr) const {
+  if (expr == nullptr) {
+    return false;
+  }
+  // Filters that need graph-side columns or vertex/tag values cannot be
+  // evaluated by the storage traversal path in this first version.
+  static const std::unordered_set<Expression::Kind> unsupported = {
+      Expression::Kind::kInputProperty,
+      Expression::Kind::kVarProperty,
+      Expression::Kind::kTagProperty,
+      Expression::Kind::kLabelTagProperty,
+      Expression::Kind::kSrcProperty,
+      Expression::Kind::kDstProperty,
+      Expression::Kind::kVertex,
+      Expression::Kind::kEdge,
+      Expression::Kind::kColumn,
+      Expression::Kind::kLabelAttribute,
+      Expression::Kind::kVar,
+      Expression::Kind::kVersionedVar,
+      Expression::Kind::kMatchPathPattern,
+      Expression::Kind::kESQUERY,
+      Expression::Kind::kPathBuild,
+      Expression::Kind::kAggregate,
+      Expression::Kind::kPredicate,
+      Expression::Kind::kListComprehension,
+      Expression::Kind::kReduce};
+  if (ExpressionUtils::hasAny(expr, unsupported)) {
+    return false;
+  }
+  static const std::unordered_set<Expression::Kind> edgeRefs = {
+      Expression::Kind::kEdgeProperty,
+      Expression::Kind::kEdgeRank,
+      Expression::Kind::kEdgeSrc,
+      Expression::Kind::kEdgeDst,
+      Expression::Kind::kEdgeType};
+  return ExpressionUtils::hasAny(expr, edgeRefs);
+}
