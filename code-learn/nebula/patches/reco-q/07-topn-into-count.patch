+/* Copyright (c) 2024 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include "graph/optimizer/rule/PushTopNIntoAggregateRule.h"
+
+#include "graph/optimizer/OptContext.h"
+#include "graph/optimizer/OptGroup.h"
+#include "graph/planner/plan/PlanNode.h"
+#include "graph/planner/plan/Query.h"
+#include "graph/service/GraphFlags.h"
+
+using nebula::graph::Aggregate;
+using nebula::graph::PlanNode;
+using nebula::graph::TopN;
+
+namespace nebula {
+namespace opt {
+
+std::unique_ptr<OptRule> PushTopNIntoAggregateRule::kInstance =
+    std::unique_ptr<PushTopNIntoAggregateRule>(new PushTopNIntoAggregateRule());
+
+PushTopNIntoAggregateRule::PushTopNIntoAggregateRule() {
+  RuleSet::QueryRules().addRule(this);
+}
+
+const Pattern &PushTopNIntoAggregateRule::pattern() const {
+  static Pattern pattern = Pattern::create(
+      PlanNode::Kind::kTopN,
+      {Pattern::create(PlanNode::Kind::kAggregate)});
+  return pattern;
+}
+
+StatusOr<OptRule::TransformResult> PushTopNIntoAggregateRule::transform(
+    OptContext *ctx, const MatchedResult &matched) const {
+  if (!FLAGS_enable_aggregate_topn_fusion) {
+    return TransformResult::noTransform();
+  }
+
+  const auto *topN = static_cast<const TopN *>(matched.planNode({0}));
+  const auto *agg = static_cast<const Aggregate *>(matched.planNode({0, 0}));
+  if (topN->factors().empty() || topN->count() < 0 || topN->offset() < 0) {
+    return TransformResult::noTransform();
+  }
+  if (agg->hasTopN()) {
+    return TransformResult::noTransform();
+  }
+
+  auto *aggVar = ctx->qctx()->symTable()->getVar(agg->outputVar());
+  if (aggVar == nullptr || aggVar->readBy.size() != 1) {
+    return TransformResult::noTransform();
+  }
+  const auto &aggCols = agg->colNames();
+  for (const auto &factor : topN->factors()) {
+    if (factor.first >= aggCols.size()) {
+      return TransformResult::noTransform();
+    }
+  }
+
+  auto *newAgg = static_cast<Aggregate *>(agg->clone());
+  newAgg->setInputVar(agg->inputVar());
+  newAgg->setOutputVar(agg->outputVar());
+  newAgg->setColNames(agg->colNames());
+  newAgg->setTopN(topN->offset(), topN->count(), topN->factors());
+
+  auto *newTopN = static_cast<TopN *>(topN->clone());
+  newTopN->setInputVar(agg->outputVar());
+  newTopN->setOutputVar(topN->outputVar());
+  newTopN->setColNames(topN->colNames());
+
+  const auto *aggGroupNode = matched.result({0, 0}).node;
+  auto *newAggGroup = OptGroup::create(ctx);
+  auto *newAggGroupNode = newAggGroup->makeGroupNode(newAgg);
+  for (auto *dep : aggGroupNode->dependencies()) {
+    newAggGroupNode->dependsOn(dep);
+  }
+
+  auto *newTopNGroupNode = OptGroupNode::create(ctx, newTopN, matched.node->group());
+  newTopNGroupNode->dependsOn(newAggGroup);
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(newTopNGroupNode);
+  return result;
+}
+
+std::string PushTopNIntoAggregateRule::toString() const {
+  return "PushTopNIntoAggregateRule";
+}
+
+}  // namespace opt
+}  // namespace nebula
