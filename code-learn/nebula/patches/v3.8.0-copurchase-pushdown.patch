+TEST(Copurchase, TopProductsTieBreakAndWindow) {
+  std::vector<EdgeFact> edges = {
+      {1, 10}, {1, 12}, {2, 30}, {3, 11}, {3, 9}, {4, 100}, {5, 5},
+  };
+  auto top = topProducts(edges, 3, 10, 30);
+  ASSERT_EQ(3, top.size());
+  EXPECT_EQ(1, top[0].pid);
+  EXPECT_EQ(2, top[0].count);
+  EXPECT_EQ(12, top[0].latestTs);
+  EXPECT_EQ(2, top[1].pid);
+  EXPECT_EQ(3, top[2].pid);
+  EXPECT_EQ(1, top[2].count);
+  auto closed = topProducts(edges, 10, 10, 10);
+  ASSERT_EQ(1, closed.size());
+  EXPECT_EQ(1, closed[0].pid);
+  EXPECT_EQ(1, closed[0].count);
+}
+
+TEST(Copurchase, UserTieBreak) {
+  std::unordered_set<int64_t> focus = {1, 2, 3};
+  auto co = scoreUser(1, {{1, 10}, {2, 11}, {3, 12}}, focus, 10, 20);
+  auto purchases = scoreUser(2, {{1, 10}, {2, 11}, {9, 12}, {9, 13}}, focus, 10, 20);
+  auto later = scoreUser(3, {{1, 10}, {2, 18}, {8, 19}}, focus, 10, 20);
+  auto earlier = scoreUser(4, {{1, 10}, {2, 14}, {8, 15}}, focus, 10, 20);
+  auto largerId = scoreUser(9, {{1, 10}, {2, 14}, {8, 15}}, focus, 10, 20);
+  auto outside = scoreUser(6, {{1, 5}, {3, 21}}, focus, 10, 20);
+  EXPECT_EQ(3, co.coCount);
+  EXPECT_EQ(2, purchases.coCount);
+  EXPECT_EQ(4, purchases.purchaseCount);
+  EXPECT_EQ(13, purchases.latestTs);
+  EXPECT_EQ((std::vector<int64_t>{1, 2, 9}), purchases.productIds);
+  EXPECT_EQ(0, outside.coCount);
+  auto top = localTopUsers({co, purchases, later, earlier, largerId, outside}, 4);
+  ASSERT_EQ(4, top.size());
+  EXPECT_EQ(1, top[0].user);
+  EXPECT_EQ(2, top[1].user);
+  EXPECT_EQ(3, top[2].user);
+  EXPECT_EQ(4, top[3].user);
+}
+
+TEST(Copurchase, ExactMergeContainsGlobalTop) {
+  std::vector<std::vector<UserScore>> nodes(3);
+  std::vector<UserScore> all;
+  for (int node = 0; node < 3; ++node) {
+    for (int i = 0; i < 40; ++i) {
+      UserScore row;
+      row.user = node * 100 + i;
+      row.coCount = (i == 0 && node == 2) ? 10 : (5 - (i % 5));
+      row.purchaseCount = 20 - i;
+      row.latestTs = 1000 - i;
+      row.productIds = {node, i};
+      nodes[node].push_back(row);
+      all.push_back(row);
+    }
+  }
+  auto local = nodes;
+  for (auto& node : local) node = localTopUsers(node, 15);
+  auto merged = mergeExact(local, 15);
+  auto global = localTopUsers(all, 15);
+  ASSERT_EQ(global.size(), merged.size());
+  for (size_t i = 0; i < global.size(); ++i) {
+    EXPECT_EQ(global[i].user, merged[i].user) << i;
+    EXPECT_EQ(global[i].coCount, merged[i].coCount);
+  }
+  EXPECT_EQ(200, merged[0].user);
+  EXPECT_EQ(10, merged[0].coCount);
+}
+
+TEST(Copurchase, NaiveDropsAndUndercounts) {
+  std::vector<std::vector<UserScore>> nodes(3);
+  for (int part = 0; part < 3; ++part) {
+    std::vector<PartialHit> hits;
+    for (int i = 0; i < 15; ++i) {
+      int64_t user = part * 100 + i;
+      hits.push_back(PartialHit{user, part * 10 + 1, 50});
+      hits.push_back(PartialHit{user, part * 10 + 2, 60});
+    }
+    hits.push_back(PartialHit{1000, part * 10 + 1, 10});
+    if (part == 0) {
+      hits.push_back(PartialHit{2000, 1, 70});
+      hits.push_back(PartialHit{2000, 2, 80});
+      hits.push_back(PartialHit{2000, 1, 90});
+    } else if (part == 1) {
+      hits.push_back(PartialHit{2000, 11, 40});
+    }
+    nodes[part] = naiveLocalTop(hits, 15);
+    for (const auto& row : nodes[part]) {
+      EXPECT_NE(1000, row.user) << part;
+    }
+  }
+  bool part0Has = false;
+  bool part1Has = false;
+  for (const auto& row : nodes[0]) {
+    if (row.user == 2000) part0Has = true;
+  }
+  for (const auto& row : nodes[1]) {
+    if (row.user == 2000) part1Has = true;
+  }
+  EXPECT_TRUE(part0Has);
+  EXPECT_FALSE(part1Has);
+  auto merged = mergeNaive(nodes, 15);
+  for (const auto& row : merged) {
+    EXPECT_NE(1000, row.user);
+  }
+  const UserScore* survivor = nullptr;
+  for (const auto& row : merged) {
+    if (row.user == 2000) survivor = &row;
+  }
+  ASSERT_NE(nullptr, survivor);
+  EXPECT_EQ(2, survivor->coCount);
+  EXPECT_EQ(3, survivor->purchaseCount);
+}
+
+TEST(Copurchase, SalesLocalTopContainsGlobal) {
+  std::vector<std::vector<SalesScore>> nodes(3);
+  std::vector<SalesScore> all;
+  for (int node = 0; node < 3; ++node) {
+    for (int i = 0; i < 30; ++i) {
+      SalesScore row;
+      row.pid = node * 100 + i;
+      row.sales = (node == 1 && i == 0) ? 100000 : (1000 - i);
+      nodes[node].push_back(row);
+      all.push_back(row);
+    }
+  }
+  std::vector<std::vector<SalesScore>> local;
+  for (auto& node : nodes) local.push_back(localTopSales(node, 20));
+  auto merged = mergeSales(local, 20);
+  auto global = localTopSales(all, 20);
+  ASSERT_EQ(20, merged.size());
+  ASSERT_EQ(global.size(), merged.size());
+  for (size_t i = 0; i < global.size(); ++i) {
+    EXPECT_EQ(global[i].pid, merged[i].pid) << i;
+    EXPECT_EQ(global[i].sales, merged[i].sales);
+  }
+  EXPECT_EQ(100, merged[0].pid);
+}
+
