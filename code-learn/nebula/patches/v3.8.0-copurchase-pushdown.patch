+int64_t vidOf(const Value& vid) {
+  if (vid.isInt()) return vid.getInt();
+  if (vid.isStr() && vid.getStr().size() >= sizeof(int64_t)) {
+    int64_t raw = 0;
+    memcpy(&raw, vid.getStr().data(), sizeof(raw));
+    return raw;
+  }
+  return 0;
+}
+
+std::string keyOf(int64_t raw) {
+  return std::string(reinterpret_cast<const char*>(&raw), sizeof(raw));
+}
+
+int64_t keyVid(folly::StringPiece raw) {
+  int64_t value = 0;
+  if (raw.size() >= sizeof(int64_t)) {
+    memcpy(&value, raw.data(), sizeof(value));
+  }
+  return value;
+}
+
+}  // namespace
+
+void CopurchaseProcessor::process(const cpp2::CopurchaseRequest& req) {
+  if (!FLAGS_storaged_accept_copurchase) {
+    onFinished();
+    return;
+  }
+  auto spaceId = req.get_space_id();
+  auto code = getSpaceVidLen(spaceId);
+  if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+    for (const auto& part : req.get_parts()) {
+      pushResultCode(code, part.first);
+    }
+    onFinished();
+    return;
+  }
+  if (!isIntId_ || spaceVidLen_ != sizeof(int64_t)) {
+    for (const auto& part : req.get_parts()) {
+      pushResultCode(nebula::cpp2::ErrorCode::E_INVALID_VID, part.first);
+    }
+    onFinished();
+    return;
+  }
+
+  auto* store = dynamic_cast<kvstore::NebulaStore*>(env_->kvstore_);
+  for (const auto& part : req.get_parts()) {
+    if (store != nullptr && !store->isLeader(spaceId, part.first)) {
+      handleLeaderChanged(spaceId, part.first);
+      onFinished();
+      return;
+    }
+  }
+
+  const auto phase = req.get_phase();
+  const int64_t windowStart = req.get_window_start();
+  const int64_t windowEnd = req.get_window_end();
+  const int topK = req.get_top_k();
+  const EdgeType edgeType = req.get_edge_type();
+  const bool hasExclude = req.exclude_user_ref().has_value();
+  const int64_t excludeUser = hasExclude ? req.exclude_user_ref().value() : 0;
+  std::unordered_set<int64_t> focus(req.get_product_ids().begin(), req.get_product_ids().end());
+  int64_t scanned = 0;
+
+  auto scan = [&](PartitionID partId,
+                  int64_t srcVid,
+                  EdgeType type,
+                  std::vector<algorithm::EdgeFact>* edges) -> bool {
+    auto src = keyOf(srcVid);
+    std::string empty;
+    auto start = NebulaKeyUtils::edgePrefix(
+        spaceVidLen_, partId, src, type, windowStart, empty);
+    std::string end;
+    if (windowEnd < std::numeric_limits<int64_t>::max()) {
+      end = NebulaKeyUtils::edgePrefix(
+          spaceVidLen_, partId, src, type, windowEnd + 1, empty);
+    } else {
+      auto prefix = NebulaKeyUtils::edgePrefix(spaceVidLen_, partId, src, type);
+      end = NebulaKeyUtils::lastKey(prefix, sizeof(int64_t) + spaceVidLen_ + 1);
+    }
+    std::unique_ptr<kvstore::KVIterator> iter;
+    auto ret = env_->kvstore_->range(spaceId, partId, start, end, &iter);
+    if (ret != nebula::cpp2::ErrorCode::SUCCEEDED) {
+      pushResultCode(ret, partId);
+      return false;
+    }
+    for (; iter->valid(); iter->next()) {
+      auto key = iter->key();
+      if (!NebulaKeyUtils::isEdge(spaceVidLen_, key)) continue;
+      if (NebulaKeyUtils::getEdgeType(spaceVidLen_, key) != type) break;
+      auto ts = NebulaKeyUtils::getRank(spaceVidLen_, key);
+      if (ts < windowStart) continue;
+      if (ts > windowEnd) break;
+      scanned++;
+      edges->push_back(algorithm::EdgeFact{keyVid(NebulaKeyUtils::getDstId(spaceVidLen_, key)), ts});
+    }
+    return true;
+  };
+
+  if (phase == cpp2::CopurchasePhase::HOP1_TOP_PRODUCTS) {
+    std::vector<algorithm::ProductScore> products;
+    for (const auto& part : req.get_parts()) {
+      for (const auto& src : part.second) {
+        std::vector<algorithm::EdgeFact> edges;
+        if (!scan(part.first, vidOf(src), edgeType, &edges)) {
+          onFinished();
+          return;
+        }
+        auto top = algorithm::topProducts(edges, topK, windowStart, windowEnd);
+        products.insert(products.end(), top.begin(), top.end());
+      }
+    }
+    algorithm::keepTop(products, topK, algorithm::betterProduct);
+    std::vector<int64_t> ids;
+    std::vector<int32_t> counts;
+    std::vector<int64_t> latest;
+    ids.reserve(products.size());
+    for (const auto& row : products) {
+      ids.push_back(row.pid);
+      counts.push_back(row.count);
+      latest.push_back(row.latestTs);
+    }
+    resp_.ids_ref() = std::move(ids);
+    resp_.counts_ref() = std::move(counts);
+    resp_.latest_ts_ref() = std::move(latest);
+    resp_.rows_returned_ref() = static_cast<int64_t>(products.size());
+  } else if (phase == cpp2::CopurchasePhase::HOP2A_BUYERS) {
+    std::unordered_set<int64_t> buyers;
+    for (const auto& part : req.get_parts()) {
+      for (const auto& src : part.second) {
+        std::vector<algorithm::EdgeFact> edges;
+        if (!scan(part.first, vidOf(src), -edgeType, &edges)) {
+          onFinished();
+          return;
+        }
+        for (const auto& edge : edges) {
+          if (hasExclude && edge.other == excludeUser) continue;
+          buyers.insert(edge.other);
+        }
+      }
+    }
+    std::vector<int64_t> ids(buyers.begin(), buyers.end());
+    std::sort(ids.begin(), ids.end());
+    resp_.rows_returned_ref() = static_cast<int64_t>(ids.size());
+    resp_.ids_ref() = std::move(ids);
+  } else if (phase == cpp2::CopurchasePhase::FUSED_COCOUNT ||
+             phase == cpp2::CopurchasePhase::NAIVE_PARTIAL) {
+    std::vector<algorithm::UserScore> users;
+    if (phase == cpp2::CopurchasePhase::FUSED_COCOUNT) {
+      for (const auto& part : req.get_parts()) {
+        for (const auto& src : part.second) {
+          auto user = vidOf(src);
+          if (hasExclude && user == excludeUser) continue;
+          std::vector<algorithm::EdgeFact> edges;
+          if (!scan(part.first, user, edgeType, &edges)) {
+            onFinished();
+            return;
+          }
+          users.push_back(algorithm::scoreUser(user, edges, focus, windowStart, windowEnd));
+        }
+      }
+      users = algorithm::localTopUsers(std::move(users), topK);
+    } else {
+      std::vector<algorithm::PartialHit> hits;
+      for (const auto& part : req.get_parts()) {
+        for (const auto& src : part.second) {
+          auto product = vidOf(src);
+          std::vector<algorithm::EdgeFact> edges;
+          if (!scan(part.first, product, -edgeType, &edges)) {
+            onFinished();
+            return;
+          }
+          for (const auto& edge : edges) {
+            if (hasExclude && edge.other == excludeUser) continue;
+            hits.push_back(algorithm::PartialHit{edge.other, product, edge.ts});
+          }
+        }
+      }
+      users = algorithm::naiveLocalTop(hits, topK);
+    }
+    std::vector<cpp2::CopurchaseUserRow> rows;
+    rows.reserve(users.size());
+    for (const auto& user : users) {
+      cpp2::CopurchaseUserRow row;
+      row.user_ref() = user.user;
+      row.co_count_ref() = user.coCount;
+      row.purchase_count_ref() = user.purchaseCount;
+      row.latest_ts_ref() = user.latestTs;
+      row.product_ids_ref() = user.productIds;
+      rows.push_back(std::move(row));
+    }
+    resp_.rows_returned_ref() = static_cast<int64_t>(rows.size());
+    resp_.users_ref() = std::move(rows);
+  } else if (phase == cpp2::CopurchasePhase::HOP4_SALES) {
+    if (!req.product_tag_id_ref().has_value() || !req.sales_prop_ref().has_value()) {
+      for (const auto& part : req.get_parts()) {
+        pushResultCode(nebula::cpp2::ErrorCode::E_INVALID_PARM, part.first);
+      }
+      onFinished();
+      return;
+    }
+    auto tagId = req.product_tag_id_ref().value();
+    auto prop = req.sales_prop_ref().value();
+    std::vector<algorithm::SalesScore> sales;
+    for (const auto& part : req.get_parts()) {
+      for (const auto& src : part.second) {
+        auto pid = vidOf(src);
+        auto key = NebulaKeyUtils::tagKey(spaceVidLen_, part.first, keyOf(pid), tagId);
+        std::string value;
+        auto ret = env_->kvstore_->get(spaceId, part.first, key, &value);
+        int64_t amount = 0;
+        if (ret == nebula::cpp2::ErrorCode::SUCCEEDED) {
+          scanned++;
+          auto reader = RowReaderWrapper::getTagPropReader(
+              env_->schemaMan_, spaceId, tagId, folly::StringPiece(value));
+          if (reader) {
+            auto field = reader.getValueByName(prop);
+            if (field.isInt()) amount = field.getInt();
+          }
+        } else if (ret != nebula::cpp2::ErrorCode::E_KEY_NOT_FOUND) {
+          pushResultCode(ret, part.first);
+          onFinished();
+          return;
+        }
+        sales.push_back(algorithm::SalesScore{pid, amount});
+      }
+    }
+    sales = algorithm::localTopSales(std::move(sales), topK);
+    std::vector<int64_t> ids;
+    std::vector<int64_t> amounts;
+    for (const auto& row : sales) {
+      ids.push_back(row.pid);
+      amounts.push_back(row.sales);
+    }
+    resp_.rows_returned_ref() = static_cast<int64_t>(ids.size());
+    resp_.ids_ref() = std::move(ids);
+    resp_.sales_ref() = std::move(amounts);
+  } else {
+    for (const auto& part : req.get_parts()) {
+      pushResultCode(nebula::cpp2::ErrorCode::E_INVALID_PARM, part.first);
+    }
+    onFinished();
+    return;
+  }
+
+  resp_.rows_scanned_ref() = scanned;
+  resp_.copurchase_applied_ref() = true;
+  onFinished();
+}
+
+}  // namespace storage
+}  // namespace nebula
