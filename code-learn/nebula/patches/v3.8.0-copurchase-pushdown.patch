+StorageRpcRespFuture<cpp2::CopurchaseResponse> StorageClient::copurchase(
+    const CommonRequestParam& param,
+    std::vector<Value> vertices,
+    EdgeType edgeType,
+    cpp2::CopurchasePhase phase,
+    int64_t windowStart,
+    int64_t windowEnd,
+    std::vector<int64_t> productIds,
+    int32_t topK,
+    int64_t excludeUser,
+    int32_t productTagId,
+    std::string salesProp) {
+  auto cbStatus = getIdFromValue(param.space);
+  if (!cbStatus.ok()) {
+    return folly::makeFuture<StorageRpcResponse<cpp2::CopurchaseResponse>>(
+        std::runtime_error(cbStatus.status().toString()));
+  }
+  auto status = clusterIdsToHosts(param.space, vertices, std::move(cbStatus).value());
+  if (!status.ok()) {
+    return folly::makeFuture<StorageRpcResponse<cpp2::CopurchaseResponse>>(
+        std::runtime_error(status.status().toString()));
+  }
+
+  auto& clusters = status.value();
+  auto common = param.toReqCommon();
+  std::unordered_map<HostAddr, cpp2::CopurchaseRequest> requests;
+  for (auto& cluster : clusters) {
+    auto& req = requests[cluster.first];
+    req.space_id_ref() = param.space;
+    req.parts_ref() = std::move(cluster.second);
+    req.edge_type_ref() = edgeType;
+    req.phase_ref() = phase;
+    req.window_start_ref() = windowStart;
+    req.window_end_ref() = windowEnd;
+    req.product_ids_ref() = productIds;
+    req.top_k_ref() = topK;
+    req.exclude_user_ref() = excludeUser;
+    req.common_ref() = common;
+    if (productTagId > 0) {
+      req.product_tag_id_ref() = productTagId;
+      req.sales_prop_ref() = salesProp;
+    }
+  }
+
+  return collectResponse(param.evb,
+                         std::move(requests),
+                         [](ThriftClientType* client, const cpp2::CopurchaseRequest& r) {
+                           return client->future_copurchase(r);
+                         });
+}
