+struct Parsed {
+  int64_t user{0};
+  int64_t windowStart{0};
+  int64_t windowEnd{0};
+  bool naive{false};
+};
+
+struct HopStat {
+  int hosts{0};
+  int64_t returned{0};
+  int64_t scanned{0};
+};
+
+struct Purchase {
+  int64_t user{0};
+  int64_t product{0};
+  int64_t ts{0};
+};
+
+struct State {
+  QueryContext* qctx{nullptr};
+  folly::Executor* runner{nullptr};
+  Parsed query;
+  GraphSpaceID space{0};
+  SessionID session{0};
+  EdgeType edgeType{0};
+  TagID tagId{0};
+  bool fallback{false};
+  std::vector<int64_t> focus;
+  std::vector<algorithm::UserScore> users;
+  std::vector<algorithm::SalesScore> sales;
+  HopStat hops[4];
+  int rounds{0};
+  int64_t buyers{0};
+};
+
+bool parseQuery(const std::string& text, Parsed* out) {
+  std::string q = text;
+  while (!q.empty() && std::isspace(static_cast<unsigned char>(q.back()))) q.pop_back();
+  if (!q.empty() && q.back() == ';') q.pop_back();
+  while (!q.empty() && std::isspace(static_cast<unsigned char>(q.back()))) q.pop_back();
+  std::istringstream in(q);
+  std::string kw;
+  std::string from;
+  std::string window;
+  std::string tail;
+  char comma = 0;
+  if (!(in >> kw >> from >> out->user >> window >> out->windowStart >> comma >> out->windowEnd)) {
+    return false;
+  }
+  if (kw != "COPURCHASE" || from != "FROM" || window != "WINDOW" || comma != ',') return false;
+  if (in >> tail) {
+    if (tail != "NAIVE") return false;
+    out->naive = true;
+    if (in >> tail) return false;
+  }
+  return true;
+}
+
+std::vector<Value> asValues(const std::vector<int64_t>& ids) {
+  std::vector<Value> values;
+  values.reserve(ids.size());
+  for (auto id : ids) values.emplace_back(id);
+  return values;
+}
+
+DataSet emptyResult() {
+  DataSet ds;
+  ds.colNames = {"product", "sales"};
+  return ds;
+}
+
+DataSet toDataSet(const std::vector<algorithm::SalesScore>& rows) {
+  DataSet ds = emptyResult();
+  for (const auto& row : rows) {
+    ds.rows.emplace_back(Row({Value(row.pid), Value(row.sales)}));
+  }
+  return ds;
+}
+
+storage::StorageClient::CommonRequestParam paramOf(const State& state) {
+  return storage::StorageClient::CommonRequestParam(state.space, state.session, 0, false);
+}
+
+struct Inspect {
+  bool applied{true};
+  bool ok{true};
+  HopStat stat;
+};
+
+Inspect inspect(const storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse>& rpc) {
+  Inspect out;
+  out.stat.hosts = static_cast<int>(rpc.responses().size());
+  if (!rpc.failedParts().empty() || rpc.responses().empty()) {
+    out.ok = false;
+    out.applied = false;
+  }
+  for (const auto& resp : rpc.responses()) {
+    if (!resp.copurchase_applied_ref().has_value() || !resp.copurchase_applied_ref().value()) {
+      out.applied = false;
+    }
+    if (resp.rows_scanned_ref().has_value()) out.stat.scanned += resp.rows_scanned_ref().value();
+    if (resp.rows_returned_ref().has_value()) {
+      out.stat.returned += resp.rows_returned_ref().value();
+    }
+    if (!resp.get_result().get_failed_parts().empty()) out.ok = false;
+  }
+  return out;
+}
+
+void logPlan(const State& state) {
+  std::ostringstream users;
+  for (size_t i = 0; i < state.users.size(); ++i) {
+    if (i != 0) users << ",";
+    const auto& row = state.users[i];
+    users << row.user << ":" << row.coCount << ":" << row.purchaseCount << ":" << row.latestTs;
+  }
+  std::ostringstream products;
+  for (size_t i = 0; i < state.sales.size(); ++i) {
+    if (i != 0) products << ",";
+    products << state.sales[i].pid << ":" << state.sales[i].sales;
+  }
+  LOG(INFO) << "copurchase_plan mode=" << (state.query.naive ? "naive" : "exact")
+            << " fallback=" << (state.fallback ? 1 : 0) << " rounds=" << state.rounds
+            << " buyers=" << state.buyers
+            << " hop_rows=" << state.hops[0].returned << "," << state.hops[1].returned << ","
+            << state.hops[2].returned << "," << state.hops[3].returned
+            << " hop_hosts=" << state.hops[0].hosts << "," << state.hops[1].hosts << ","
+            << state.hops[2].hosts << "," << state.hops[3].hosts
+            << " scanned=" << state.hops[0].scanned << "," << state.hops[1].scanned << ","
+            << state.hops[2].scanned << "," << state.hops[3].scanned << " users=" << users.str()
+            << " products=" << products.str();
+}
+
+folly::Future<storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse>> callPhase(
+    const std::shared_ptr<State>& state,
+    storage::cpp2::CopurchasePhase phase,
+    const std::vector<int64_t>& vids,
+    const std::vector<int64_t>& focus,
+    int32_t topK,
+    bool withSales) {
+  auto* client = state->qctx->getStorageClient();
+  return client
+      ->copurchase(paramOf(*state),
+                   asValues(vids),
+                   state->edgeType,
+                   phase,
+                   state->query.windowStart,
+                   state->query.windowEnd,
+                   focus,
+                   topK,
+                   state->query.user,
+                   withSales ? state->tagId : 0,
+                   withSales ? FLAGS_copurchase_sales_prop : "")
+      .via(state->runner);
+}
+
+int64_t asInt(const Value& value) {
+  if (value.isInt()) return value.getInt();
+  if (value.isStr() && value.getStr().size() >= sizeof(int64_t)) {
+    int64_t raw = 0;
+    memcpy(&raw, value.getStr().data(), sizeof(raw));
+    return raw;
+  }
+  return 0;
+}
+
+std::vector<Purchase> readEdges(
+    const storage::StorageRpcResponse<storage::cpp2::GetNeighborsResponse>& rpc,
+    bool inbound,
+    int* hosts) {
+  std::vector<Purchase> rows;
+  *hosts = static_cast<int>(rpc.responses().size());
+  for (const auto& resp : rpc.responses()) {
+    if (!resp.vertices_ref().has_value()) continue;
+    const auto& ds = resp.vertices_ref().value();
+    int col = -1;
+    for (size_t i = 0; i < ds.colNames.size(); ++i) {
+      if (ds.colNames[i].compare(0, 5, "_edge") == 0) {
+        col = static_cast<int>(i);
+        break;
+      }
+    }
+    if (col < 0) continue;
+    for (const auto& row : ds.rows) {
+      if (col >= static_cast<int>(row.values.size()) || !row.values[col].isList()) continue;
+      for (const auto& edge : row.values[col].getList().values) {
+        if (!edge.isList()) continue;
+        const auto& props = edge.getList().values;
+        if (props.size() < 4) continue;
+        // In-edge keys store the product in src and the buyer in dst.
+        Purchase purchase;
+        purchase.ts = asInt(props[2]);
+        if (inbound) {
+          purchase.product = asInt(props[0]);
+          purchase.user = asInt(props[3]);
+        } else {
+          purchase.user = asInt(props[0]);
+          purchase.product = asInt(props[3]);
+        }
+        rows.push_back(purchase);
+      }
+    }
+  }
+  return rows;
+}
+
+folly::Future<std::vector<Purchase>> fetchEdges(const std::shared_ptr<State>& state,
+                                                const std::vector<int64_t>& vids,
+                                                bool inbound,
+                                                HopStat* stat) {
+  storage::cpp2::EdgeProp prop;
+  EdgeType type = inbound ? -state->edgeType : state->edgeType;
+  prop.type_ref() = type;
+  prop.props_ref() = std::vector<std::string>{kSrc, kType, kRank, kDst};
+  auto props = std::make_shared<std::vector<storage::cpp2::EdgeProp>>(1, std::move(prop));
+  auto types = std::vector<EdgeType>{type};
+  auto direction =
+      inbound ? storage::cpp2::EdgeDirection::IN_EDGE : storage::cpp2::EdgeDirection::OUT_EDGE;
+  auto* client = state->qctx->getStorageClient();
+  return client
+      ->getNeighbors(paramOf(*state),
+                     {kVid},
+                     asValues(vids),
+                     types,
+                     direction,
+                     nullptr,
+                     nullptr,
+                     props.get(),
+                     nullptr,
+                     false,
+                     false,
+                     {},
+                     std::numeric_limits<int64_t>::max(),
+                     nullptr,
+                     nullptr)
+      .via(state->runner)
+      .thenValue([props, stat, inbound](
+                     storage::StorageRpcResponse<storage::cpp2::GetNeighborsResponse> rpc) {
+        int hosts = 0;
+        auto rows = readEdges(rpc, inbound, &hosts);
+        stat->hosts = hosts;
+        stat->returned = static_cast<int64_t>(rows.size());
+        stat->scanned = stat->returned;
+        return rows;
+      });
+}
+
+folly::Future<StatusOr<DataSet>> finishWithSales(const std::shared_ptr<State>& state,
+                                                 std::vector<int64_t> pids);
+
+folly::Future<StatusOr<DataSet>> fallback(const std::shared_ptr<State>& state) {
+  state->fallback = true;
+  state->rounds = 0;
+  state->buyers = 0;
+  state->users.clear();
+  state->sales.clear();
+  state->focus.clear();
+  for (auto& hop : state->hops) hop = HopStat();
+  return fetchEdges(state, {state->query.user}, false, &state->hops[0])
+      .thenValue([state](std::vector<Purchase> edges) {
+        state->rounds++;
+        std::vector<algorithm::EdgeFact> facts;
+        facts.reserve(edges.size());
+        for (const auto& edge : edges) {
+          if (!algorithm::inWindow(edge.ts, state->query.windowStart, state->query.windowEnd)) {
+            continue;
+          }
+          facts.push_back(algorithm::EdgeFact{edge.product, edge.ts});
+        }
+        auto top = algorithm::topProducts(
+            facts, FLAGS_copurchase_top_products, state->query.windowStart, state->query.windowEnd);
+        state->focus.clear();
+        for (const auto& row : top) state->focus.push_back(row.pid);
+        if (state->focus.empty()) {
+          logPlan(*state);
+          return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+        }
+        return fetchEdges(state, state->focus, true, &state->hops[1])
+            .thenValue([state](std::vector<Purchase> inbound) {
+              state->rounds++;
+              std::unordered_set<int64_t> buyers;
+              std::vector<algorithm::PartialHit> hits;
+              for (const auto& edge : inbound) {
+                if (!algorithm::inWindow(
+                        edge.ts, state->query.windowStart, state->query.windowEnd)) {
+                  continue;
+                }
+                if (edge.user == state->query.user) continue;
+                buyers.insert(edge.user);
+                hits.push_back(algorithm::PartialHit{edge.user, edge.product, edge.ts});
+              }
+              if (state->query.naive) {
+                int32_t nparts = 1;
+                auto parts = state->qctx->getMetaClient()->partsNum(state->space);
+                if (parts.ok() && parts.value() > 0) nparts = parts.value();
+                std::vector<std::vector<algorithm::PartialHit>> byPart(static_cast<size_t>(nparts));
+                for (const auto& hit : hits) {
+                  auto part = static_cast<int32_t>(hit.product % nparts);
+                  if (part < 0) part += nparts;
+                  byPart[static_cast<size_t>(part)].push_back(hit);
+                }
+                std::vector<std::vector<algorithm::UserScore>> nodes;
+                for (const auto& partHits : byPart) {
+                  if (!partHits.empty()) {
+                    nodes.push_back(
+                        algorithm::naiveLocalTop(partHits, FLAGS_copurchase_top_users));
+                  }
+                }
+                state->users = algorithm::mergeNaive(nodes, FLAGS_copurchase_top_users);
+                std::vector<int64_t> chosen;
+                for (const auto& user : state->users) chosen.push_back(user.user);
+                if (chosen.empty()) {
+                  logPlan(*state);
+                  return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+                }
+                return fetchEdges(state, chosen, false, &state->hops[2])
+                    .thenValue([state](std::vector<Purchase> outbound) {
+                      state->rounds++;
+                      std::unordered_map<int64_t, std::vector<int64_t>> products;
+                      for (const auto& edge : outbound) {
+                        if (!algorithm::inWindow(
+                                edge.ts, state->query.windowStart, state->query.windowEnd)) {
+                          continue;
+                        }
+                        products[edge.user].push_back(edge.product);
+                      }
+                      std::unordered_set<int64_t> pids;
+                      for (auto& user : state->users) {
+                        auto& list = products[user.user];
+                        std::sort(list.begin(), list.end());
+                        list.erase(std::unique(list.begin(), list.end()), list.end());
+                        user.productIds = list;
+                        pids.insert(list.begin(), list.end());
+                      }
+                      return finishWithSales(state, std::vector<int64_t>(pids.begin(), pids.end()));
+                    });
+              }
+              std::vector<int64_t> ids(buyers.begin(), buyers.end());
+              state->buyers = static_cast<int64_t>(ids.size());
+              if (ids.empty()) {
+                logPlan(*state);
+                return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+              }
+              return fetchEdges(state, ids, false, &state->hops[2])
+                  .thenValue([state](std::vector<Purchase> outbound) {
+                    state->rounds++;
+                    std::unordered_map<int64_t, std::vector<algorithm::EdgeFact>> byUser;
+                    for (const auto& edge : outbound) {
+                      byUser[edge.user].push_back(algorithm::EdgeFact{edge.product, edge.ts});
+                    }
+                    std::unordered_set<int64_t> focus(state->focus.begin(), state->focus.end());
+                    std::vector<algorithm::UserScore> scores;
+                    for (const auto& item : byUser) {
+                      if (item.first == state->query.user) continue;
+                      scores.push_back(algorithm::scoreUser(item.first,
+                                                            item.second,
+                                                            focus,
+                                                            state->query.windowStart,
+                                                            state->query.windowEnd));
+                    }
+                    state->users = algorithm::localTopUsers(std::move(scores),
+                                                            FLAGS_copurchase_top_users);
+                    std::unordered_set<int64_t> pids;
+                    for (const auto& user : state->users) {
+                      pids.insert(user.productIds.begin(), user.productIds.end());
+                    }
+                    return finishWithSales(state, std::vector<int64_t>(pids.begin(), pids.end()));
+                  });
+            });
+      });
+}
+
+folly::Future<StatusOr<DataSet>> finishWithSales(const std::shared_ptr<State>& state,
+                                                 std::vector<int64_t> pids) {
+  if (pids.empty()) {
+    logPlan(*state);
+    return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+  }
+  if (state->fallback) {
+    storage::cpp2::VertexProp prop;
+    prop.tag_ref() = state->tagId;
+    prop.props_ref() = std::vector<std::string>{FLAGS_copurchase_sales_prop};
+    auto props = std::make_shared<std::vector<storage::cpp2::VertexProp>>(1, std::move(prop));
+    DataSet input({kVid});
+    for (auto pid : pids) input.rows.emplace_back(Row({Value(pid)}));
+    auto* client = state->qctx->getStorageClient();
+    return client
+        ->getProps(paramOf(*state), std::move(input), props.get(), nullptr, nullptr, false)
+        .via(state->runner)
+        .thenValue([state, props](storage::StorageRpcResponse<storage::cpp2::GetPropResponse> rpc) {
+          state->rounds++;
+          state->hops[3].hosts = static_cast<int>(rpc.responses().size());
+          std::vector<algorithm::SalesScore> sales;
+          for (const auto& resp : rpc.responses()) {
+            if (!resp.props_ref().has_value()) continue;
+            for (const auto& row : resp.props_ref().value().rows) {
+              if (row.values.size() < 2) continue;
+              algorithm::SalesScore score;
+              score.pid = asInt(row.values[0]);
+              score.sales = row.values[1].isInt() ? row.values[1].getInt() : 0;
+              sales.push_back(score);
+            }
+          }
+          state->hops[3].returned = static_cast<int64_t>(sales.size());
+          state->hops[3].scanned = state->hops[3].returned;
+          state->sales = algorithm::localTopSales(std::move(sales), FLAGS_copurchase_top_sales);
+          logPlan(*state);
+          return StatusOr<DataSet>(toDataSet(state->sales));
+        });
+  }
+
+  return callPhase(state,
+                   storage::cpp2::CopurchasePhase::HOP4_SALES,
+                   pids,
+                   {},
+                   FLAGS_copurchase_top_sales,
+                   true)
+      .thenValue([state](storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> rpc)
+                     -> folly::Future<StatusOr<DataSet>> {
+        auto seen = inspect(rpc);
+        state->hops[3] = seen.stat;
+        state->rounds++;
+        if (!seen.applied) return fallback(state);
+        if (!seen.ok) {
+          return folly::makeFuture<StatusOr<DataSet>>(Status::Error("copurchase hop4 failed"));
+        }
+        std::vector<std::vector<algorithm::SalesScore>> nodes;
+        for (const auto& resp : rpc.responses()) {
+          if (!resp.ids_ref().has_value()) continue;
+          const auto& ids = resp.ids_ref().value();
+          const auto& amounts =
+              resp.sales_ref().has_value() ? resp.sales_ref().value() : std::vector<int64_t>{};
+          std::vector<algorithm::SalesScore> node;
+          for (size_t i = 0; i < ids.size() && i < amounts.size(); ++i) {
+            node.push_back(algorithm::SalesScore{ids[i], amounts[i]});
+          }
+          nodes.push_back(std::move(node));
+        }
+        state->sales = algorithm::mergeSales(nodes, FLAGS_copurchase_top_sales);
+        logPlan(*state);
+        return folly::makeFuture<StatusOr<DataSet>>(toDataSet(state->sales));
+      });
+}
+
+folly::Future<StatusOr<DataSet>> afterBuyers(const std::shared_ptr<State>& state) {
+  if (state->query.naive) {
+    return callPhase(state,
+                     storage::cpp2::CopurchasePhase::NAIVE_PARTIAL,
+                     state->focus,
+                     state->focus,
+                     FLAGS_copurchase_top_users,
+                     false)
+        .thenValue([state](storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> rpc)
+                       -> folly::Future<StatusOr<DataSet>> {
+          auto seen = inspect(rpc);
+          state->hops[2] = seen.stat;
+          state->rounds++;
+          if (!seen.applied) return fallback(state);
+          if (!seen.ok) {
+            return folly::makeFuture<StatusOr<DataSet>>(Status::Error("copurchase naive failed"));
+          }
+          std::vector<std::vector<algorithm::UserScore>> nodes;
+          for (const auto& resp : rpc.responses()) {
+            std::vector<algorithm::UserScore> node;
+            if (resp.users_ref().has_value()) {
+              for (const auto& row : resp.users_ref().value()) {
+                algorithm::UserScore score;
+                score.user = row.get_user();
+                score.coCount = row.get_co_count();
+                score.purchaseCount = row.get_purchase_count();
+                score.latestTs = row.get_latest_ts();
+                score.productIds = row.get_product_ids();
+                node.push_back(std::move(score));
+              }
+            }
+            nodes.push_back(std::move(node));
+          }
+          state->users = algorithm::mergeNaive(nodes, FLAGS_copurchase_top_users);
+          state->hops[1] = state->hops[2];
+          state->hops[2] = HopStat();
+          std::vector<int64_t> chosen;
+          chosen.reserve(state->users.size());
+          for (const auto& user : state->users) chosen.push_back(user.user);
+          state->buyers = static_cast<int64_t>(chosen.size());
+          if (chosen.empty()) {
+            logPlan(*state);
+            return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+          }
+          // Product ids on the partial rows are only the focus products that
+          // lived on that part. Fetch the chosen users' own out-edges for the
+          // sales hop. Do not replace the naive scores with these exact counts.
+          return callPhase(state,
+                           storage::cpp2::CopurchasePhase::FUSED_COCOUNT,
+                           chosen,
+                           state->focus,
+                           static_cast<int32_t>(chosen.size()),
+                           false)
+              .thenValue([state](storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> rpc)
+                             -> folly::Future<StatusOr<DataSet>> {
+                auto seen = inspect(rpc);
+                state->hops[2] = seen.stat;
+                state->rounds++;
+                if (!seen.applied) return fallback(state);
+                if (!seen.ok) {
+                  return folly::makeFuture<StatusOr<DataSet>>(
+                      Status::Error("copurchase naive products failed"));
+                }
+                std::unordered_map<int64_t, std::vector<int64_t>> products;
+                for (const auto& resp : rpc.responses()) {
+                  if (!resp.users_ref().has_value()) continue;
+                  for (const auto& row : resp.users_ref().value()) {
+                    products[row.get_user()] = row.get_product_ids();
+                  }
+                }
+                std::unordered_set<int64_t> pids;
+                for (auto& user : state->users) {
+                  auto it = products.find(user.user);
+                  if (it == products.end()) continue;
+                  user.productIds = it->second;
+                  pids.insert(it->second.begin(), it->second.end());
+                }
+                return finishWithSales(state, std::vector<int64_t>(pids.begin(), pids.end()));
+              });
+        });
+  }
+
+  return callPhase(state,
+                   storage::cpp2::CopurchasePhase::HOP2A_BUYERS,
+                   state->focus,
+                   state->focus,
+                   0,
+                   false)
+      .thenValue([state](storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> rpc)
+                     -> folly::Future<StatusOr<DataSet>> {
+        auto seen = inspect(rpc);
+        state->hops[1] = seen.stat;
+        state->rounds++;
+        if (!seen.applied) return fallback(state);
+        if (!seen.ok) {
+          return folly::makeFuture<StatusOr<DataSet>>(Status::Error("copurchase hop2a failed"));
+        }
+        std::unordered_set<int64_t> buyers;
+        for (const auto& resp : rpc.responses()) {
+          if (!resp.ids_ref().has_value()) continue;
+          buyers.insert(resp.ids_ref().value().begin(), resp.ids_ref().value().end());
+        }
+        std::vector<int64_t> ids(buyers.begin(), buyers.end());
+        state->buyers = static_cast<int64_t>(ids.size());
+        if (ids.empty()) {
+          logPlan(*state);
+          return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+        }
+        return callPhase(state,
+                         storage::cpp2::CopurchasePhase::FUSED_COCOUNT,
+                         ids,
+                         state->focus,
+                         FLAGS_copurchase_top_users,
+                         false)
+            .thenValue([state](storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> fused)
+                           -> folly::Future<StatusOr<DataSet>> {
+              auto fusedSeen = inspect(fused);
+              state->hops[2] = fusedSeen.stat;
+              state->rounds++;
+              if (!fusedSeen.applied) return fallback(state);
+              if (!fusedSeen.ok) {
+                return folly::makeFuture<StatusOr<DataSet>>(
+                    Status::Error("copurchase fused failed"));
+              }
+              std::vector<std::vector<algorithm::UserScore>> nodes;
+              for (const auto& resp : fused.responses()) {
+                std::vector<algorithm::UserScore> node;
+                if (resp.users_ref().has_value()) {
+                  for (const auto& row : resp.users_ref().value()) {
+                    algorithm::UserScore score;
+                    score.user = row.get_user();
+                    score.coCount = row.get_co_count();
+                    score.purchaseCount = row.get_purchase_count();
+                    score.latestTs = row.get_latest_ts();
+                    score.productIds = row.get_product_ids();
+                    node.push_back(std::move(score));
+                  }
+                }
+                nodes.push_back(std::move(node));
+              }
+              state->users = algorithm::mergeExact(nodes, FLAGS_copurchase_top_users);
+              std::unordered_set<int64_t> pids;
+              for (const auto& user : state->users) {
+                pids.insert(user.productIds.begin(), user.productIds.end());
+              }
+              return finishWithSales(state, std::vector<int64_t>(pids.begin(), pids.end()));
+            });
+      });
+}
+
+folly::Future<StatusOr<DataSet>> pushdown(const std::shared_ptr<State>& state) {
+  return callPhase(state,
+                   storage::cpp2::CopurchasePhase::HOP1_TOP_PRODUCTS,
+                   {state->query.user},
+                   {},
+                   FLAGS_copurchase_top_products,
+                   false)
+      .thenValue([state](storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> rpc)
+                     -> folly::Future<StatusOr<DataSet>> {
+        auto seen = inspect(rpc);
+        state->hops[0] = seen.stat;
+        state->rounds++;
+        if (!seen.applied) return fallback(state);
+        if (!seen.ok) {
+          return folly::makeFuture<StatusOr<DataSet>>(Status::Error("copurchase hop1 failed"));
+        }
+        std::vector<algorithm::ProductScore> products;
+        for (const auto& resp : rpc.responses()) {
+          if (!resp.ids_ref().has_value()) continue;
+          const auto& ids = resp.ids_ref().value();
+          const auto& counts =
+              resp.counts_ref().has_value() ? resp.counts_ref().value() : std::vector<int32_t>{};
+          const auto& latest =
+              resp.latest_ts_ref().has_value() ? resp.latest_ts_ref().value() : std::vector<int64_t>{};
+          for (size_t i = 0; i < ids.size(); ++i) {
+            algorithm::ProductScore score;
+            score.pid = ids[i];
+            score.count = i < counts.size() ? counts[i] : 0;
+            score.latestTs = i < latest.size() ? latest[i] : 0;
+            products.push_back(score);
+          }
+        }
+        algorithm::keepTop(products, FLAGS_copurchase_top_products, algorithm::betterProduct);
+        for (const auto& row : products) state->focus.push_back(row.pid);
+        if (state->focus.empty()) {
+          logPlan(*state);
+          return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+        }
+        return afterBuyers(state);
+      });
+}
+
+}  // namespace
+
+bool CopurchaseDriver::match(const std::string& query) {
+  size_t i = 0;
+  while (i < query.size() && std::isspace(static_cast<unsigned char>(query[i]))) ++i;
+  const std::string prefix = "COPURCHASE";
+  if (query.compare(i, prefix.size(), prefix) != 0) return false;
+  return i + prefix.size() == query.size() ||
+         std::isspace(static_cast<unsigned char>(query[i + prefix.size()]));
+}
+
+folly::Future<StatusOr<DataSet>> CopurchaseDriver::run(QueryContext* qctx) {
+  auto state = std::make_shared<State>();
+  state->qctx = qctx;
+  if (!parseQuery(qctx->rctx()->query(), &state->query)) {
+    return folly::makeFuture<StatusOr<DataSet>>(Status::SyntaxError("COPURCHASE"));
+  }
+  auto space = qctx->rctx()->session()->space();
+  if (space.id == kInvalidSpaceID) {
+    return folly::makeFuture<StatusOr<DataSet>>(Status::Error("No space selected"));
+  }
+  state->space = space.id;
+  state->session = qctx->rctx()->session()->id();
+  auto edgeType = qctx->getMetaClient()->getEdgeTypeByNameFromCache(space.id, FLAGS_copurchase_edge);
+  auto tagId = qctx->getMetaClient()->getTagIDByNameFromCache(space.id, FLAGS_copurchase_tag);
+  if (!edgeType.ok() || !tagId.ok()) {
+    return folly::makeFuture<StatusOr<DataSet>>(
+        Status::Error("copurchase schema: edge %s tag %s",
+                      FLAGS_copurchase_edge.c_str(),
+                      FLAGS_copurchase_tag.c_str()));
+  }
+  state->edgeType = edgeType.value();
+  state->tagId = tagId.value();
+  state->runner = qctx->rctx()->runner();
+  if (state->runner == nullptr) {
+    state->runner = &folly::InlineExecutor::instance();
+  }
+  return pushdown(state).thenError(
+      folly::tag_t<std::exception>{}, [state](const std::exception& ex) {
+        if (state->fallback) {
+          return folly::makeFuture<StatusOr<DataSet>>(Status::Error("%s", ex.what()));
+        }
+        LOG(WARNING) << "copurchase pushdown failed: " << ex.what();
+        return fallback(state);
+      });
+}
