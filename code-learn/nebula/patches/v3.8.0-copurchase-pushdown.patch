+#ifndef COMMON_ALGORITHM_COPURCHASE_H_
+#define COMMON_ALGORITHM_COPURCHASE_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+// Co-purchase ranking. The window is inclusive on both ends: a purchase whose
+// edge rank (the timestamp) is windowStart or windowEnd counts.
+//
+// Product order: purchase count desc, latest timestamp desc, product id asc.
+// User order: coCount desc, purchaseCount desc, latestTs desc, user id asc.
+//   coCount is the number of distinct focus products bought inside the window.
+//   purchaseCount is the number of in-window purchase edges, including repeats
+//   of the same product and products outside the focus set.
+//   latestTs is the max in-window edge rank. A user with coCount 0 is dropped.
+// Sales order: sales desc, product id asc.
+//
+// Exactness: every out-edge of a user lives on that user's partition, so a
+// user's coCount is computed on exactly one storaged. The union of per-node
+// top-k therefore contains the global top-k. Sales is a vertex property, so
+// the same argument applies to per-node top-k by sales.
+//
+// The naive path scores a user only from the focus products that live on one
+// product partition, keeps a local top-k, then sums those partial rows. A user
+// who is below top-k on every partition is missing, and a survivor's sum
+// undercounts any partition that dropped them.
+
+namespace nebula {
+namespace algorithm {
+
+struct ProductScore {
+  int64_t pid{0};
+  int32_t count{0};
+  int64_t latestTs{0};
+};
+
+struct UserScore {
+  int64_t user{0};
+  int32_t coCount{0};
+  int32_t purchaseCount{0};
+  int64_t latestTs{std::numeric_limits<int64_t>::min()};
+  std::vector<int64_t> productIds;
+};
+
+struct SalesScore {
+  int64_t pid{0};
+  int64_t sales{0};
+};
+
+struct EdgeFact {
+  int64_t other{0};
+  int64_t ts{0};
+};
+
+struct PartialHit {
+  int64_t buyer{0};
+  int64_t product{0};
+  int64_t ts{0};
+};
+
+inline bool betterProduct(const ProductScore& a, const ProductScore& b) {
+  if (a.count != b.count) return a.count > b.count;
+  if (a.latestTs != b.latestTs) return a.latestTs > b.latestTs;
+  return a.pid < b.pid;
+}
+
+inline bool betterUser(const UserScore& a, const UserScore& b) {
+  if (a.coCount != b.coCount) return a.coCount > b.coCount;
+  if (a.purchaseCount != b.purchaseCount) return a.purchaseCount > b.purchaseCount;
+  if (a.latestTs != b.latestTs) return a.latestTs > b.latestTs;
+  return a.user < b.user;
+}
+
+inline bool betterSales(const SalesScore& a, const SalesScore& b) {
+  if (a.sales != b.sales) return a.sales > b.sales;
+  return a.pid < b.pid;
+}
+
+template <typename T, typename Better>
+inline void keepTop(std::vector<T>& rows, int k, Better better) {
+  if (k < 0) k = 0;
+  if (static_cast<int>(rows.size()) > k) {
+    std::nth_element(rows.begin(), rows.begin() + k, rows.end(), better);
+    rows.resize(static_cast<size_t>(k));
+  }
+  std::sort(rows.begin(), rows.end(), better);
+}
+
+inline bool inWindow(int64_t ts, int64_t windowStart, int64_t windowEnd) {
+  return ts >= windowStart && ts <= windowEnd;
+}
+
+inline std::vector<ProductScore> topProducts(const std::vector<EdgeFact>& edges,
+                                            int k,
+                                            int64_t windowStart,
+                                            int64_t windowEnd) {
+  struct Acc {
+    int32_t count{0};
+    int64_t ts{std::numeric_limits<int64_t>::min()};
+  };
+  std::unordered_map<int64_t, Acc> byPid;
+  for (const auto& edge : edges) {
+    if (!inWindow(edge.ts, windowStart, windowEnd)) continue;
+    auto& acc = byPid[edge.other];
+    acc.count++;
+    if (edge.ts > acc.ts) acc.ts = edge.ts;
+  }
+  std::vector<ProductScore> rows;
+  rows.reserve(byPid.size());
+  for (const auto& item : byPid) {
+    rows.push_back(ProductScore{item.first, item.second.count, item.second.ts});
+  }
+  keepTop(rows, k, betterProduct);
+  return rows;
+}
+
+inline UserScore scoreUser(int64_t user,
+                           const std::vector<EdgeFact>& edges,
+                           const std::unordered_set<int64_t>& focus,
+                           int64_t windowStart,
+                           int64_t windowEnd) {
+  UserScore score;
+  score.user = user;
+  std::unordered_set<int64_t> focusSeen;
+  std::unordered_set<int64_t> products;
+  for (const auto& edge : edges) {
+    if (!inWindow(edge.ts, windowStart, windowEnd)) continue;
+    score.purchaseCount++;
+    if (edge.ts > score.latestTs) score.latestTs = edge.ts;
+    products.insert(edge.other);
+    if (focus.count(edge.other) != 0) focusSeen.insert(edge.other);
+  }
+  score.coCount = static_cast<int32_t>(focusSeen.size());
+  score.productIds.assign(products.begin(), products.end());
+  std::sort(score.productIds.begin(), score.productIds.end());
+  return score;
+}
+
+inline std::vector<UserScore> localTopUsers(std::vector<UserScore> rows, int k) {
+  rows.erase(std::remove_if(rows.begin(),
+                            rows.end(),
+                            [](const UserScore& row) { return row.coCount <= 0; }),
+             rows.end());
+  keepTop(rows, k, betterUser);
+  return rows;
+}
+
+inline std::vector<UserScore> naiveLocalTop(const std::vector<PartialHit>& hits, int k) {
+  struct Acc {
+    std::unordered_set<int64_t> pids;
+    int32_t purchases{0};
+    int64_t ts{std::numeric_limits<int64_t>::min()};
+  };
+  std::unordered_map<int64_t, Acc> byUser;
+  for (const auto& hit : hits) {
+    auto& acc = byUser[hit.buyer];
+    acc.pids.insert(hit.product);
+    acc.purchases++;
+    if (hit.ts > acc.ts) acc.ts = hit.ts;
+  }
+  std::vector<UserScore> rows;
+  rows.reserve(byUser.size());
+  for (auto& item : byUser) {
+    UserScore score;
+    score.user = item.first;
+    score.coCount = static_cast<int32_t>(item.second.pids.size());
+    score.purchaseCount = item.second.purchases;
+    score.latestTs = item.second.ts;
+    score.productIds.assign(item.second.pids.begin(), item.second.pids.end());
+    std::sort(score.productIds.begin(), score.productIds.end());
+    if (score.coCount > 0) rows.push_back(std::move(score));
+  }
+  keepTop(rows, k, betterUser);
+  return rows;
+}
+
+// Each user is owned by one node. A duplicate keeps the better full score.
+inline std::vector<UserScore> mergeExact(const std::vector<std::vector<UserScore>>& nodes, int k) {
+  std::unordered_map<int64_t, UserScore> acc;
+  for (const auto& node : nodes) {
+    for (const auto& row : node) {
+      auto it = acc.find(row.user);
+      if (it == acc.end() || betterUser(row, it->second)) {
+        acc[row.user] = row;
+      }
+    }
+  }
+  std::vector<UserScore> rows;
+  rows.reserve(acc.size());
+  for (auto& item : acc) rows.push_back(std::move(item.second));
+  keepTop(rows, k, betterUser);
+  return rows;
+}
+
+// Partials are summed only for users some node chose to return. coCount is
+// the number of distinct focus products in those returned rows.
+inline std::vector<UserScore> mergeNaive(const std::vector<std::vector<UserScore>>& nodes, int k) {
+  struct Acc {
+    std::unordered_set<int64_t> pids;
+    int32_t purchases{0};
+    int64_t ts{std::numeric_limits<int64_t>::min()};
+  };
+  std::unordered_map<int64_t, Acc> byUser;
+  for (const auto& node : nodes) {
+    for (const auto& row : node) {
+      auto& acc = byUser[row.user];
+      acc.pids.insert(row.productIds.begin(), row.productIds.end());
+      acc.purchases += row.purchaseCount;
+      if (row.latestTs > acc.ts) acc.ts = row.latestTs;
+    }
+  }
+  std::vector<UserScore> rows;
+  rows.reserve(byUser.size());
+  for (auto& item : byUser) {
+    UserScore score;
+    score.user = item.first;
+    score.coCount = static_cast<int32_t>(item.second.pids.size());
+    score.purchaseCount = item.second.purchases;
+    score.latestTs = item.second.ts;
+    score.productIds.assign(item.second.pids.begin(), item.second.pids.end());
+    std::sort(score.productIds.begin(), score.productIds.end());
+    rows.push_back(std::move(score));
+  }
+  keepTop(rows, k, betterUser);
+  return rows;
+}
+
+inline std::vector<SalesScore> localTopSales(std::vector<SalesScore> rows, int k) {
+  std::unordered_map<int64_t, int64_t> byPid;
+  for (const auto& row : rows) byPid[row.pid] = row.sales;
+  rows.clear();
+  rows.reserve(byPid.size());
+  for (const auto& item : byPid) rows.push_back(SalesScore{item.first, item.second});
+  keepTop(rows, k, betterSales);
+  return rows;
+}
+
+inline std::vector<SalesScore> mergeSales(const std::vector<std::vector<SalesScore>>& nodes, int k) {
+  std::vector<SalesScore> rows;
+  for (const auto& node : nodes) {
+    rows.insert(rows.end(), node.begin(), node.end());
+  }
+  return localTopSales(std::move(rows), k);
+}
+
