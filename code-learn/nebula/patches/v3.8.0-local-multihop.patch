new file mode 100644
index 0000000..d0adef6
--- /dev/null
+++ b/src/common/algorithm/test/LocalMultiHopTest.cpp
@@ -0,0 +1,219 @@
+/* Copyright (c) 2026 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <unordered_map>
+#include <unordered_set>
+
+#include "common/algorithm/LocalMultiHop.h"
+
+namespace nebula {
+namespace algorithm {
+namespace {
+
+using Graph = std::unordered_map<int64_t, std::vector<int64_t>>;
+
+std::unordered_set<int64_t> asSet(const std::vector<int64_t>& vals) {
+  return std::unordered_set<int64_t>(vals.begin(), vals.end());
+}
+
+NeighborScan<int64_t> scanOf(const Graph& graph, int64_t vid, bool failAt = false) {
+  NeighborScan<int64_t> scan;
+  if (failAt) {
+    scan.failed = true;
+    return scan;
+  }
+  auto it = graph.find(vid);
+  if (it != graph.end()) scan.dsts = it->second;
+  return scan;
+}
+
+TEST(LocalMultiHopDecisionTest, FlagAffinityFrontierAndSteps) {
+  EXPECT_FALSE(shouldLocalMultiHop(false, 1.0, 0.6, 3, 10, 10000, 3));
+  EXPECT_FALSE(shouldLocalMultiHop(true, 1.0, 0.6, 1, 10, 10000, 3));
+  EXPECT_FALSE(shouldLocalMultiHop(true, 0.0, 0.6, 3, 10, 10000, 3));
+  EXPECT_FALSE(shouldLocalMultiHop(true, 0.59, 0.6, 3, 10, 10000, 3));
+  EXPECT_FALSE(shouldLocalMultiHop(true, 1.0, 0.6, 3, 0, 10000, 3));
+  EXPECT_FALSE(shouldLocalMultiHop(true, 1.0, 0.6, 3, 10001, 10000, 3));
+  EXPECT_TRUE(shouldLocalMultiHop(true, 0.6, 0.6, 3, 10, 10000, 3));
+  // hopsLeft above maxSteps is still allowed; the request is clipped.
+  EXPECT_TRUE(shouldLocalMultiHop(true, 1.0, 0.6, 5, 10, 10000, 3));
+  EXPECT_EQ(3, clipLocalMultiHopSteps(5, 3));
+  EXPECT_EQ(2, clipLocalMultiHopSteps(2, 3));
+  EXPECT_EQ(0, clipLocalMultiHopSteps(0, 3));
+}
+
+TEST(LocalMultiHopTest, ThreeHopAllLocalYieldsOnlyFinal) {
+  Graph g{{1, {2, 3}}, {2, {4}}, {3, {4}}, {4, {5}}};
+  auto allLocal = [](int64_t) { return true; };
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 3, 3, 0, 0, 0, allLocal, [&](int64_t v) { return scanOf(g, v); });
+  EXPECT_FALSE(result.failed);
+  EXPECT_FALSE(result.truncated);
+  EXPECT_EQ(3, result.stepsDone);
+  EXPECT_EQ(asSet({5}), asSet(result.yielded));
+  EXPECT_TRUE(result.remoteVids.empty());
+  EXPECT_TRUE(result.carry.empty());
+}
+
+TEST(LocalMultiHopTest, EmptyAndNoEdges) {
+  auto allLocal = [](int64_t) { return true; };
+  Graph empty;
+  auto none = runLocalMultiHop<int64_t>(
+      {}, 3, 3, 0, 0, 0, allLocal, [&](int64_t v) { return scanOf(empty, v); });
+  EXPECT_EQ(0, none.stepsDone);
+  EXPECT_TRUE(none.yielded.empty());
+
+  auto island = runLocalMultiHop<int64_t>(
+      {7}, 3, 3, 0, 0, 0, allLocal, [&](int64_t v) { return scanOf(empty, v); });
+  EXPECT_EQ(1, island.stepsDone);
+  EXPECT_TRUE(island.yielded.empty());
+  EXPECT_TRUE(island.remoteVids.empty());
+}
+
+TEST(LocalMultiHopTest, DedupWithinHopAndCycle) {
+  Graph multi{{1, {2, 2, 3}}, {2, {3}}, {3, {}}};
+  auto allLocal = [](int64_t) { return true; };
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 1, 1, 0, 0, 0, allLocal, [&](int64_t v) { return scanOf(multi, v); });
+  EXPECT_EQ(asSet({2, 3}), asSet(result.yielded));
+
+  Graph cycle{{1, {2}}, {2, {1}}};
+  auto two = runLocalMultiHop<int64_t>(
+      {1}, 2, 2, 0, 0, 0, allLocal, [&](int64_t v) { return scanOf(cycle, v); });
+  EXPECT_EQ(asSet({1}), asSet(two.yielded));
+  EXPECT_EQ(2, two.stepsDone);
+}
+
+TEST(LocalMultiHopTest, RemoteBoundaryStopsThatBranch) {
+  // 4 lives on another partition. 2 and 3 stay local and both point at 4.
+  Graph g{{1, {2, 3}}, {2, {4}}, {3, {4}}, {4, {5}}};
+  auto local = [](int64_t v) { return v != 4 && v != 5; };
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 3, 3, 0, 0, 0, local, [&](int64_t v) { return scanOf(g, v); });
+  EXPECT_FALSE(result.truncated);
+  EXPECT_TRUE(result.yielded.empty());
+  EXPECT_EQ(asSet({4}), asSet(result.remoteVids));
+  ASSERT_EQ(1, result.remoteDepth.size());
+  EXPECT_EQ(2, result.remoteDepth[0]);
+  EXPECT_EQ(2, result.stepsDone);
+}
+
+TEST(LocalMultiHopTest, SameVidAtTwoDepthsIsExpandedTwice) {
+  // 4 is remote both one hop and two hops from 1. GO 3 must still yield 5,
+  // which is only three hops on the longer path (1-2-4-5).
+  Graph g{{1, {2, 4}}, {2, {4}}, {4, {5}}};
+  auto local = [](int64_t v) { return v != 4 && v != 5; };
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 3, 3, 0, 0, 0, local, [&](int64_t v) { return scanOf(g, v); });
+  ASSERT_EQ(2, result.remoteVids.size());
+  EXPECT_EQ(4, result.remoteVids[0]);
+  EXPECT_EQ(4, result.remoteVids[1]);
+  std::vector<int32_t> depths = result.remoteDepth;
+  std::sort(depths.begin(), depths.end());
+  EXPECT_EQ(std::vector<int32_t>({1, 2}), depths);
+  auto shallow = consumeLocalMultiHop<int64_t>(3, false, true, result.stepsDone, false,
+                                               result.yielded, result.remoteVids,
+                                               result.remoteDepth, result.carry);
+  bool sawOne = false;
+  bool sawTwo = false;
+  for (const auto& wave : shallow.waves) {
+    if (wave.hopsLeft == 2) sawTwo = true;
+    if (wave.hopsLeft == 1) sawOne = true;
+  }
+  EXPECT_TRUE(sawOne);
+  EXPECT_TRUE(sawTwo);
+}
+
+TEST(LocalMultiHopTest, YieldEveryHopForMToN) {
+  Graph g{{1, {2}}, {2, {3}}, {3, {4}}};
+  auto allLocal = [](int64_t) { return true; };
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 3, 1, 0, 0, 0, allLocal, [&](int64_t v) { return scanOf(g, v); });
+  EXPECT_EQ(asSet({2, 3, 4}), asSet(result.yielded));
+  EXPECT_EQ(3, result.stepsDone);
+}
+
+TEST(LocalMultiHopTest, CappedStepsReturnCarry) {
+  Graph g{{1, {2}}, {2, {3}}, {3, {4}}};
+  auto allLocal = [](int64_t) { return true; };
+  // minYield > maxSteps: walk 2 hops, yield nothing, carry the frontier.
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 2, 5, 0, 0, 0, allLocal, [&](int64_t v) { return scanOf(g, v); });
+  EXPECT_TRUE(result.yielded.empty());
+  EXPECT_EQ(2, result.stepsDone);
+  EXPECT_EQ(asSet({3}), asSet(result.carry));
+  EXPECT_FALSE(result.truncated);
+}
+
+TEST(LocalMultiHopTest, RowBudgetDropsPartialStep) {
+  Graph g{{1, {2, 3}}, {2, {4}}, {3, {5}}};
+  auto allLocal = [](int64_t) { return true; };
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 2, 2, /*rowBudget=*/1, 0, 0, allLocal, [&](int64_t v) { return scanOf(g, v); });
+  EXPECT_TRUE(result.truncated);
+  EXPECT_TRUE(result.yielded.empty());
+  EXPECT_EQ(asSet({1}), asSet(result.carry));
+  EXPECT_EQ(0, result.stepsDone);
+}
+
+TEST(LocalMultiHopTest, ScanFailureIsNotARemoteBoundary) {
+  Graph g{{1, {2}}};
+  auto allLocal = [](int64_t) { return true; };
+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 2, 2, 0, 0, 0, allLocal, [&](int64_t) { return scanOf(g, 1, true); });
+  EXPECT_TRUE(result.failed);
+  EXPECT_TRUE(result.yielded.empty());
+  EXPECT_FALSE(result.truncated);
+}
+
+TEST(LocalMultiHopConsumeTest, OldServerIsOneHop) {
+  auto out = consumeLocalMultiHop<int64_t>(3, false, false, 0, false, {2, 3}, {}, {}, {});
+  EXPECT_TRUE(out.yieldNow.empty());
+  ASSERT_EQ(1, out.waves.size());
+  EXPECT_EQ(2, out.waves[0].hopsLeft);
+  EXPECT_TRUE(out.waves[0].allowMulti);
+  EXPECT_EQ(asSet({2, 3}), asSet(out.waves[0].vids));
+
+  auto last = consumeLocalMultiHop<int64_t>(1, false, false, 0, false, {9}, {}, {}, {});
+  EXPECT_EQ(asSet({9}), asSet(last.yieldNow));
+  EXPECT_TRUE(last.waves.empty());
+}
+
+TEST(LocalMultiHopConsumeTest, RemoteContinuesAndFinalRemoteIsYielded) {
+  auto mid = consumeLocalMultiHop<int64_t>(3, false, true, 2, false, {}, {4}, {2}, {});
+  EXPECT_TRUE(mid.yieldNow.empty());
+  ASSERT_EQ(1, mid.waves.size());
+  EXPECT_EQ(1, mid.waves[0].hopsLeft);
+  EXPECT_TRUE(mid.waves[0].allowMulti);
+  EXPECT_EQ(asSet({4}), asSet(mid.waves[0].vids));
+
+  auto done = consumeLocalMultiHop<int64_t>(3, false, true, 3, false, {5}, {9}, {3}, {});
+  EXPECT_EQ(asSet({5, 9}), asSet(done.yieldNow));
+  EXPECT_TRUE(done.waves.empty());
+}
+
+TEST(LocalMultiHopConsumeTest, MToNYieldsRemoteAtIntermediateDepth) {
+  auto out = consumeLocalMultiHop<int64_t>(3, true, true, 2, false, {2}, {8}, {1}, {});
+  EXPECT_EQ(asSet({2, 8}), asSet(out.yieldNow));
+  ASSERT_EQ(1, out.waves.size());
+  EXPECT_EQ(2, out.waves[0].hopsLeft);
+  EXPECT_EQ(asSet({8}), asSet(out.waves[0].vids));
+}
+
+TEST(LocalMultiHopConsumeTest, TruncatedCarryStaysOnSingleHop) {
+  auto out = consumeLocalMultiHop<int64_t>(3, false, true, 1, true, {}, {}, {}, {2, 3});
+  EXPECT_TRUE(out.yieldNow.empty());
+  ASSERT_EQ(1, out.waves.size());
+  EXPECT_FALSE(out.waves[0].allowMulti);
+  EXPECT_EQ(2, out.waves[0].hopsLeft);
+  EXPECT_EQ(asSet({2, 3}), asSet(out.waves[0].vids));
+}
+
