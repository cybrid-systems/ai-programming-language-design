+void GetDstBySrcProcessor::runMultiHop(const cpp2::GetDstBySrcRequest& req) {
+  memory::MemoryCheckGuard guard;
+  auto partsNumRet = env_->metaClient_->partsNum(spaceId_);
+  if (!partsNumRet.ok()) {
+    for (const auto& partEntry : req.get_parts()) {
+      pushResultCode(nebula::cpp2::ErrorCode::E_SPACE_NOT_FOUND, partEntry.first);
+    }
+    onFinished();
+    return;
+  }
+  const int32_t numParts = partsNumRet.value();
+  const int32_t maxSteps = *req.get_max_steps();
+  const int32_t minYield = req.min_yield_step_ref().value_or(maxSteps);
+  const int32_t rowBudget = req.row_budget_ref().value_or(0);
+  const int32_t frontierBudget = req.frontier_budget_ref().value_or(0);
+  auto* store = dynamic_cast<kvstore::NebulaStore*>(env_->kvstore_);
+
+  auto keyOf = [this](const Value& vid) {
+    if (this->isIntId_) {
+      int64_t raw = vid.getInt();
+      return std::string(reinterpret_cast<const char*>(&raw), sizeof(raw));
+    }
+    return vid.getStr();
+  };
+  auto asValue = [this](const Value& vid) {
+    if (this->isIntId_ && vid.isStr() && vid.getStr().size() == sizeof(int64_t)) {
+      int64_t raw = 0;
+      memcpy(&raw, vid.getStr().data(), sizeof(raw));
+      return Value(raw);
+    }
+    return vid;
+  };
+  auto isLocal = [&](const Value& vid) {
+    if (store == nullptr) return false;
+    auto part = env_->metaClient_->partId(numParts, keyOf(vid));
+    return store->isLeader(spaceId_, part);
+  };
+
+  std::vector<Value> starts;
+  bool leaderMiss = false;
+  for (const auto& partEntry : req.get_parts()) {
+    for (const auto& src : partEntry.second) {
+      Value vid = asValue(src);
+      if (!isLocal(vid)) {
+        auto part = env_->metaClient_->partId(numParts, keyOf(vid));
+        handleLeaderChanged(spaceId_, part);
+        leaderMiss = true;
+      } else {
+        starts.emplace_back(std::move(vid));
+      }
+    }
+  }
+  if (leaderMiss) {
+    onFinished();
+    return;
+  }
+
+  contexts_.emplace_back(RuntimeContext(planContext_.get()));
+  std::deque<Value> buf;
+  auto plan = buildPlan(&contexts_.front(), &buf);
+  PartitionID failedPart = 0;
+  nebula::cpp2::ErrorCode failedCode = nebula::cpp2::ErrorCode::SUCCEEDED;
+  auto neighbors = [&](const Value& vid) {
+    algorithm::NeighborScan<Value> scan;
+    if (failedCode != nebula::cpp2::ErrorCode::SUCCEEDED) {
+      scan.failed = true;
+      return scan;
+    }
+    buf.clear();
+    auto key = keyOf(vid);
+    auto part = env_->metaClient_->partId(numParts, key);
+    auto code = plan.go(part, key);
+    if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+      failedCode = code;
+      failedPart = part;
+      handleErrorCode(code, spaceId_, part);
+      scan.failed = true;
+      return scan;
+    }
+    scan.dsts.assign(buf.begin(), buf.end());
+    return scan;
+  };
+
+  auto walked = algorithm::runLocalMultiHop<Value>(starts,
+                                                   maxSteps,
+                                                   minYield,
+                                                   rowBudget,
+                                                   frontierBudget,
+                                                   /*maxOutDegree=*/0,
+                                                   isLocal,
+                                                   neighbors);
+  if (walked.failed || failedCode != nebula::cpp2::ErrorCode::SUCCEEDED) {
+    onFinished();
+    return;
+  }
+
+  const auto remoteCount = static_cast<int32_t>(walked.remoteVids.size());
+  const auto stepsDone = walked.stepsDone;
+  resultDataSet_.rows.clear();
+  resultDataSet_.rows.reserve(walked.yielded.size());
+  for (const auto& vid : walked.yielded) {
+    resultDataSet_.rows.emplace_back(Row({vid}));
+  }
+  resp_.dsts_ref() = std::move(resultDataSet_);
+  if (!walked.remoteVids.empty()) {
+    resp_.remote_vids_ref() = std::move(walked.remoteVids);
+    resp_.remote_depth_ref() = std::move(walked.remoteDepth);
+  }
+  if (!walked.carry.empty()) {
+    resp_.carry_vids_ref() = std::move(walked.carry);
+  }
+  resp_.steps_done_ref() = stepsDone;
+  resp_.truncated_ref() = walked.truncated;
+  resp_.multihop_applied_ref() = true;
+  if (UNLIKELY(profileDetailFlag_)) {
+    profileDetail("LocalMultiHopSteps", stepsDone);
+    profileDetail("LocalMultiHopRemote", remoteCount);
+  }
+  onFinished();
+}
