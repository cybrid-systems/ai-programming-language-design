diff --git a/src/common/algorithm/LocalMultiHop.h b/src/common/algorithm/LocalMultiHop.h
new file mode 100644
index 0000000..758b685
--- /dev/null
+++ b/src/common/algorithm/LocalMultiHop.h
@@ -0,0 +1,261 @@
+/* Copyright (c) 2026 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#ifndef COMMON_ALGORITHM_LOCALMULTIHOP_H_
+#define COMMON_ALGORITHM_LOCALMULTIHOP_H_
+
+#include <cstdint>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace nebula {
+namespace algorithm {
+
+// Gate used by Expand / ExpandAll. There is no OptRule: 3.8 already plans
+// multi-step GO as a hop loop inside the executor. This predicate is the
+// whole "should we collapse the loop" decision.
+inline bool shouldLocalMultiHop(bool enabled,
+                                double affinity,
+                                double affinityThreshold,
+                                int32_t hopsLeft,
+                                int32_t frontierSize,
+                                int32_t maxFrontier,
+                                int32_t maxSteps) {
+  if (!enabled) return false;
+  if (hopsLeft <= 1) return false;
+  if (frontierSize <= 0) return false;
+  if (maxFrontier > 0 && frontierSize > maxFrontier) return false;
+  if (maxSteps > 0 && hopsLeft > maxSteps) {
+    // Still worth a capped call. The caller clips the request to maxSteps
+    // and continues. Rejecting the whole query here would skip the affinity
+    // win on GO 4+ STEPS.
+  }
+  if (affinity < affinityThreshold) return false;
+  return true;
+}
+
+// How many hops to ask storage for. Never more than maxSteps, never more
+// than hopsLeft, and at least 1 when the caller has already decided to try.
+inline int32_t clipLocalMultiHopSteps(int32_t hopsLeft, int32_t maxSteps) {
+  if (hopsLeft < 1) return 0;
+  if (maxSteps > 0 && hopsLeft > maxSteps) return maxSteps;
+  return hopsLeft;
+}
+
+template <typename Vid>
+struct NeighborScan {
+  std::vector<Vid> dsts;
+  // A real storage error. Not the same as "this dst lives on another host".
+  bool failed{false};
+};
+
+template <typename Vid>
+struct LocalMultiHopResult {
+  std::vector<Vid> yielded;
+  std::vector<Vid> remoteVids;
+  std::vector<int32_t> remoteDepth;
+  // Local vids at depth stepsDone that still need expansion (budget, or the
+  // caller asked for more hops than maxSteps). Not yielded here.
+  std::vector<Vid> carry;
+  int32_t stepsDone{0};
+  bool truncated{false};
+  bool failed{false};
+};
+
+// Local BFS.
+// isLocal(vid) is true when this storaged leads vid's partition.
+// neighbors(vid) scans one vertex. A failed scan aborts the walk.
+// minYield > maxSteps means "walk maxSteps but yield nothing"; the last
+// local frontier is returned in carry.
+// maxOutDegree <= 0 disables the per-vertex degree cap (3.8's existing
+// per-vertex edge limit still applies inside the scan callback).
+// rowBudget / frontierBudget <= 0 disable those caps.
+template <typename Vid, typename IsLocal, typename Neighbors>
+LocalMultiHopResult<Vid> runLocalMultiHop(const std::vector<Vid>& starts,
+                                          int32_t maxSteps,
+                                          int32_t minYield,
+                                          int32_t rowBudget,
+                                          int32_t frontierBudget,
+                                          int32_t maxOutDegree,
+                                          IsLocal isLocal,
+                                          Neighbors neighbors) {
+  LocalMultiHopResult<Vid> result;
+  if (maxSteps <= 0) return result;
+
+  std::unordered_set<Vid> frontier(starts.begin(), starts.end());
+  int32_t scanned = 0;
+
+  // Dedup only inside one hop. The same vid reached again at a deeper hop
+  // is a different distance and must be expanded again, matching GetDstBySrc.
+  auto rememberRemote = [&](std::unordered_set<Vid>& seen, const Vid& vid, int32_t depth) {
+    if (seen.insert(vid).second) {
+      result.remoteVids.push_back(vid);
+      result.remoteDepth.push_back(depth);
+    }
+  };
+
+  for (int32_t step = 1; step <= maxSteps; ++step) {
+    if (frontier.empty()) {
+      result.stepsDone = step - 1;
+      return result;
+    }
+    std::unordered_set<Vid> next;
+    std::unordered_set<Vid> yieldedThisStep;
+    std::unordered_set<Vid> seenRemote;
+    bool budgetHit = false;
+    for (const auto& vid : frontier) {
+      if (!isLocal(vid)) {
+        rememberRemote(seenRemote, vid, step - 1);
+        continue;
+      }
+      NeighborScan<Vid> scan = neighbors(vid);
+      if (scan.failed) {
+        result.failed = true;
+        result.stepsDone = step - 1;
+        return result;
+      }
+      if (maxOutDegree > 0 && static_cast<int32_t>(scan.dsts.size()) > maxOutDegree) {
+        // Hand the vertex back unexpanded. Redo this hop on graphd so the
+        // cap does not drop edges the single-hop path would have returned.
+        result.truncated = true;
+        result.stepsDone = step - 1;
+        result.carry.assign(frontier.begin(), frontier.end());
+        result.remoteVids.clear();
+        result.remoteDepth.clear();
+        result.yielded.clear();
+        return result;
+      }
+      for (const auto& dst : scan.dsts) {
+        ++scanned;
+        if (rowBudget > 0 && scanned > rowBudget) {
+          budgetHit = true;
+          break;
+        }
+        if (!isLocal(dst)) {
+          rememberRemote(seenRemote, dst, step);
+          continue;
+        }
+        if (!next.insert(dst).second) {
+          continue;
+        }
+        if (step >= minYield && yieldedThisStep.insert(dst).second) {
+          result.yielded.push_back(dst);
+        }
+      }
+      if (budgetHit) break;
+    }
+    if (budgetHit) {
+      result.truncated = true;
+      result.stepsDone = step - 1;
+      result.carry.assign(frontier.begin(), frontier.end());
+      result.remoteVids.clear();
+      result.remoteDepth.clear();
+      result.yielded.clear();
+      return result;
+    }
+    result.stepsDone = step;
+    if (frontierBudget > 0 && static_cast<int32_t>(next.size()) > frontierBudget) {
+      result.truncated = true;
+      result.carry.assign(next.begin(), next.end());
+      return result;
+    }
+    frontier.swap(next);
+  }
+
+  if (minYield > maxSteps) {
+    result.carry.assign(frontier.begin(), frontier.end());
+  }
+  return result;
+}
+
+template <typename Vid>
+struct HopWave {
+  int32_t hopsLeft{0};
+  bool allowMulti{false};
+  std::vector<Vid> vids;
+};
+
+template <typename Vid>
+struct ConsumeResult {
+  std::vector<Vid> yieldNow;
+  std::vector<HopWave<Vid>> waves;
+};
+
+// Turn one storage response into "rows to emit" and "frontiers still to walk".
+// applied=false means the server ignored multi-hop fields (old storaged, or
+// storaged_accept_local_multihop=false) and dsts are a single hop.
+// truncated frontiers must not be sent back into multi-hop.
+template <typename Vid>
+ConsumeResult<Vid> consumeLocalMultiHop(int32_t hopsLeft,
+                                        bool yieldAll,
+                                        bool applied,
+                                        int32_t stepsDone,
+                                        bool truncated,
+                                        const std::vector<Vid>& dsts,
+                                        const std::vector<Vid>& remoteVids,
+                                        const std::vector<int32_t>& remoteDepth,
+                                        const std::vector<Vid>& carry) {
+  ConsumeResult<Vid> out;
+  auto push = [&](int32_t left, bool multi, const Vid& vid) {
+    if (left <= 0) {
+      out.yieldNow.push_back(vid);
+      return;
+    }
+    for (auto& wave : out.waves) {
+      if (wave.hopsLeft == left && wave.allowMulti == multi) {
+        wave.vids.push_back(vid);
+        return;
+      }
+    }
+    HopWave<Vid> wave;
+    wave.hopsLeft = left;
+    wave.allowMulti = multi;
+    wave.vids.push_back(vid);
+    out.waves.push_back(std::move(wave));
+  };
+
+  if (!applied) {
+    for (const auto& vid : dsts) {
+      if (yieldAll || hopsLeft <= 1) {
+        out.yieldNow.push_back(vid);
+      }
+      if (hopsLeft > 1) {
+        push(hopsLeft - 1, true, vid);
+      }
+    }
+    return out;
+  }
+
+  out.yieldNow = dsts;
+  const bool multi = !truncated;
+  auto handle = [&](const Vid& vid, int32_t depth) {
+    const int32_t left = hopsLeft - depth;
+    if (left > 0) {
+      if (yieldAll && depth > 0) {
+        out.yieldNow.push_back(vid);
+      }
+      push(left, multi, vid);
+    } else if (left == 0) {
+      out.yieldNow.push_back(vid);
+    }
+  };
+  const size_t n = std::min(remoteVids.size(), remoteDepth.size());
+  for (size_t i = 0; i < n; ++i) {
+    handle(remoteVids[i], remoteDepth[i]);
+  }
+  for (const auto& vid : carry) {
+    const int32_t left = hopsLeft - stepsDone;
+    if (left > 0) {
+      push(left, multi, vid);
+    }
+  }
+  return out;
+}
+
+}  // namespace algorithm
+}  // namespace nebula
+
+#endif  // COMMON_ALGORITHM_LOCALMULTIHOP_H_
