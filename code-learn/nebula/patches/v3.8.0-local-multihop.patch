diff --git a/src/graph/executor/query/LocalMultiHopDriveBody.inl b/src/graph/executor/query/LocalMultiHopDriveBody.inl
new file mode 100644
index 0000000..9bc6daf
--- /dev/null
+++ b/src/graph/executor/query/LocalMultiHopDriveBody.inl
@@ -0,0 +1,148 @@
+// Included inside ExpandExecutor::driveDstWalk and ExpandAllExecutor::driveDstWalk.
+// Both classes provide expand_, handleCompleteness, qctx, runner, addState, finish.
+if (qctx()->isKilled()) {
+  return folly::makeFuture<Status>(Status::Error("Execution had been killed"));
+}
+while (!state->jobs.empty() && state->jobs.back().vids.empty()) {
+  state->jobs.pop_back();
+}
+if (state->jobs.empty()) {
+  DataSet ds;
+  ds.colNames = expand_->colNames();
+  if (state->yieldAll) {
+    ds.rows.reserve(state->yielded.size());
+    for (const auto& vid : state->yielded) {
+      Row row;
+      row.values.emplace_back(vid);
+      ds.rows.emplace_back(std::move(row));
+    }
+  } else {
+    ds.rows.reserve(state->finals.size());
+    for (const auto& vid : state->finals) {
+      Row row;
+      row.values.emplace_back(vid);
+      ds.rows.emplace_back(std::move(row));
+    }
+  }
+  finish(ResultBuilder().value(Value(std::move(ds))).build());
+  return folly::makeFuture<Status>(Status::OK());
+}
+
+auto job = std::move(state->jobs.back());
+state->jobs.pop_back();
+{
+  std::unordered_set<Value> uniq(job.vids.begin(), job.vids.end());
+  job.vids.assign(uniq.begin(), uniq.end());
+}
+if (job.hopsLeft <= 0) {
+  if (state->yieldAll) {
+    state->yielded.insert(state->yielded.end(), job.vids.begin(), job.vids.end());
+  } else {
+    state->finals.insert(job.vids.begin(), job.vids.end());
+  }
+  return driveDstWalk(state);
+}
+
+const bool multi =
+    job.allowMulti && algorithm::shouldLocalMultiHop(FLAGS_enable_local_multihop,
+                                                     FLAGS_local_multihop_affinity,
+                                                     FLAGS_local_multihop_affinity_threshold,
+                                                     job.hopsLeft,
+                                                     static_cast<int32_t>(job.vids.size()),
+                                                     FLAGS_local_multihop_max_frontier,
+                                                     FLAGS_local_multihop_max_steps);
+const int32_t reqSteps =
+    multi ? algorithm::clipLocalMultiHopSteps(job.hopsLeft, FLAGS_local_multihop_max_steps) : 1;
+int32_t minYield = state->yieldAll ? 1 : job.hopsLeft;
+if (multi && minYield > reqSteps) {
+  minYield = reqSteps + 1;
+}
+
+time::Duration rpcTime;
+StorageClient* storageClient = qctx_->getStorageClient();
+StorageClient::CommonRequestParam param(expand_->space(),
+                                        qctx_->rctx()->session()->id(),
+                                        qctx_->plan()->id(),
+                                        qctx_->plan()->isProfileEnabled());
+const int32_t rpcIndex = state->rpc++;
+return storageClient
+    ->getDstBySrc(param,
+                  job.vids,
+                  expand_->edgeTypes(),
+                  reqSteps,
+                  minYield,
+                  FLAGS_local_multihop_row_budget,
+                  FLAGS_local_multihop_frontier_budget)
+    .via(runner())
+    .ensure([this, rpcTime]() {
+      SCOPED_TIMER(&execTime_);
+      addState("total_rpc_time", rpcTime);
+    })
+    .thenValue([this, state, job, multi, rpcIndex](auto&& resps) {
+      memory::MemoryCheckGuard guard;
+      SCOPED_TIMER(&execTime_);
+      auto& hostLatency = resps.hostLatency();
+      for (size_t i = 0; i < hostLatency.size(); ++i) {
+        size_t size = 0;
+        auto& one = resps.responses()[i];
+        if (one.dsts_ref().has_value()) {
+          size = one.get_dsts()->rows.size();
+        }
+        auto info = util::collectRespProfileData(one.result, hostLatency[i], size);
+        addState(folly::sformat("step{} resp [{}]", rpcIndex, i), info);
+      }
+      auto completeness = handleCompleteness(resps, FLAGS_accept_partial_success);
+      if (!completeness.ok()) {
+        return folly::makeFuture<Status>(completeness.status());
+      }
+      for (auto& one : resps.responses()) {
+        const bool applied = multi && one.multihop_applied_ref().value_or(false);
+        std::vector<Value> dsts;
+        if (one.dsts_ref().has_value()) {
+          for (const auto& row : one.get_dsts()->rows) {
+            if (!row.values.empty()) dsts.push_back(row.values[0]);
+          }
+        }
+        std::vector<Value> remote;
+        std::vector<int32_t> depth;
+        std::vector<Value> carry;
+        int32_t stepsDone = 0;
+        bool truncated = false;
+        if (applied) {
+          if (one.remote_vids_ref().has_value()) remote = one.remote_vids_ref().value();
+          if (one.remote_depth_ref().has_value()) depth = one.remote_depth_ref().value();
+          if (one.carry_vids_ref().has_value()) carry = one.carry_vids_ref().value();
+          stepsDone = one.steps_done_ref().value_or(0);
+          truncated = one.truncated_ref().value_or(false);
+          addState(folly::sformat("local_multihop[{}]", rpcIndex),
+                   folly::sformat("applied=1 steps_done={} remote={} carry={} truncated={}",
+                                  stepsDone,
+                                  remote.size(),
+                                  carry.size(),
+                                  truncated ? 1 : 0));
+        }
+        auto consumed = algorithm::consumeLocalMultiHop<Value>(job.hopsLeft,
+                                                              state->yieldAll,
+                                                              applied,
+                                                              stepsDone,
+                                                              truncated,
+                                                              dsts,
+                                                              remote,
+                                                              depth,
+                                                              carry);
+        if (state->yieldAll) {
+          state->yielded.insert(
+              state->yielded.end(), consumed.yieldNow.begin(), consumed.yieldNow.end());
+        } else {
+          state->finals.insert(consumed.yieldNow.begin(), consumed.yieldNow.end());
+        }
+        for (auto& wave : consumed.waves) {
+          DstWalkState::Job next;
+          next.vids = std::move(wave.vids);
+          next.hopsLeft = wave.hopsLeft;
+          next.allowMulti = wave.allowMulti;
+          state->jobs.push_back(std::move(next));
+        }
+      }
+      return driveDstWalk(state);
+    });
