+std::unordered_set<int64_t> singleHopFinal(const Graph& graph,
+                                           const std::vector<int64_t>& seeds,
+                                           int32_t steps) {
+  std::unordered_set<int64_t> frontier(seeds.begin(), seeds.end());
+  for (int32_t step = 0; step < steps; ++step) {
+    std::unordered_set<int64_t> next;
+    for (auto vid : frontier) {
+      auto it = graph.find(vid);
+      if (it == graph.end()) continue;
+      next.insert(it->second.begin(), it->second.end());
+    }
+    frontier.swap(next);
+  }
+  return frontier;
+}
+
+// Replay what graphd does after an early stop: carry and earlier remotes are
+// expanded one hop at a time, with no second multi-hop call.
+std::unordered_set<int64_t> resumeSingleHop(const Graph& graph,
+                                            int32_t hopsLeft,
+                                            const LocalMultiHopResult<int64_t>& walked,
+                                            bool requireSingle) {
+  auto consumed = consumeLocalMultiHop<int64_t>(hopsLeft,
+                                                false,
+                                                true,
+                                                walked.stepsDone,
+                                                walked.truncated || walked.earlyStop,
+                                                walked.yielded,
+                                                walked.remoteVids,
+                                                walked.remoteDepth,
+                                                walked.carry);
+  std::unordered_set<int64_t> finals(consumed.yieldNow.begin(), consumed.yieldNow.end());
+  std::vector<HopWave<int64_t>> waves = std::move(consumed.waves);
+  while (!waves.empty()) {
+    auto wave = std::move(waves.back());
+    waves.pop_back();
+    if (requireSingle) {
+      EXPECT_FALSE(wave.allowMulti);
+    }
+    if (wave.hopsLeft <= 0) {
+      finals.insert(wave.vids.begin(), wave.vids.end());
+      continue;
+    }
+    std::unordered_set<int64_t> dsts;
+    for (auto vid : wave.vids) {
+      auto it = graph.find(vid);
+      if (it == graph.end()) continue;
+      dsts.insert(it->second.begin(), it->second.end());
+    }
+    if (wave.hopsLeft == 1) {
+      finals.insert(dsts.begin(), dsts.end());
+    } else {
+      HopWave<int64_t> next;
+      next.hopsLeft = wave.hopsLeft - 1;
+      next.allowMulti = false;
+      next.vids.assign(dsts.begin(), dsts.end());
+      waves.push_back(std::move(next));
+    }
+  }
+  return finals;
+}
