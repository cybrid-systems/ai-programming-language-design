+// One GetDstBySrc fans out to every leader. Replies for the same remaining
+// depth must be one frontier again. Leaving each host as its own job turns
+// a 3-hop baseline into a chain of sequential RPCs.
+template <typename Job>
+inline void mergeSameHop(std::vector<Job>& jobs, Job next) {
+  for (auto& existing : jobs) {
+    if (existing.hopsLeft == next.hopsLeft && existing.allowMulti == next.allowMulti) {
+      existing.vids.insert(existing.vids.end(),
+                           std::make_move_iterator(next.vids.begin()),
+                           std::make_move_iterator(next.vids.end()));
+      return;
+    }
+  }
+  jobs.push_back(std::move(next));
+}
