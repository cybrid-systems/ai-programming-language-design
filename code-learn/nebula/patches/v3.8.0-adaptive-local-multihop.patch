+
+// Query shape for the in-process controller. 3.8's Expand node has no tag:
+// a simple GO is space + edge types + hop count, plus whether every hop is
+// yielded (GO M TO N) or only the last one. Two spaces that share an edge
+// name do not share stats.
+struct AdaptiveShape {
+  int32_t space{0};
+  std::vector<int32_t> edges;
+  int32_t steps{0};
+  bool yieldAll{false};
+
+  bool operator<(const AdaptiveShape& other) const {
+    if (space != other.space) return space < other.space;
+    if (steps != other.steps) return steps < other.steps;
+    if (yieldAll != other.yieldAll) return yieldAll < other.yieldAll;
+    return edges < other.edges;
+  }
+};
+
+inline AdaptiveShape makeAdaptiveShape(int32_t space,
+                                      const std::vector<int32_t>& edgeTypes,
+                                      int32_t steps,
+                                      bool yieldAll) {
+  AdaptiveShape shape;
+  shape.space = space;
+  shape.edges = edgeTypes;
+  std::sort(shape.edges.begin(), shape.edges.end());
+  shape.edges.erase(std::unique(shape.edges.begin(), shape.edges.end()), shape.edges.end());
+  shape.steps = steps;
+  shape.yieldAll = yieldAll;
+  return shape;
+}
+
+// rttUs is a configured stand-in for the cost model, used only while one of
+// the two arms has no latency sample. It is not a measured round trip.
+// Once both arms have samples, choose() compares those latencies and ignores
+// rttUs.
+struct AdaptiveConfig {
+  double exploreRate{0.05};
+  double ewmaAlpha{0.2};
+  double minLocalRatio{0.6};
+  double rttUs{5000};
+};
+
+struct AdaptiveSnapshot {
+  int32_t multiN{0};
+  int32_t baseN{0};
+  int32_t ratioN{0};
+  double multiLat{0};
+  double baseLat{0};
+  double multiRatio{0};
+  bool lastEarly{false};
+  int32_t lastHop{0};
+};
+
+// In-process, per graphd. Not shared across graphd processes and not
+// recovered from meta. A restart is a cold start.
+class AdaptiveController {
+ public:
+  // draw is uniform in [0, 1). exploreRate flips the exploit choice.
+  bool choose(const AdaptiveShape& shape, const AdaptiveConfig& cfg, double draw) {
+    std::lock_guard<std::mutex> guard(mu_);
+    const Slot& slot = slots_[shape];
+    bool exploit = exploitOf(slot, shape, cfg);
+    const double rate = clampRate(cfg.exploreRate);
+    if (draw < rate) return !exploit;
+    return exploit;
+  }
+
+  void observe(const AdaptiveShape& shape,
+               const AdaptiveConfig& cfg,
+               bool usedMulti,
+               double latencyUs,
+               double localRatio,
+               bool earlyStop,
+               int32_t continueHop) {
+    std::lock_guard<std::mutex> guard(mu_);
+    Slot& slot = slots_[shape];
+    const double alpha = clampAlpha(cfg.ewmaAlpha);
+    if (usedMulti) {
+      ewma(slot.multiLat, slot.multiN, latencyUs, alpha);
+      if (localRatio >= 0.0) {
+        ewma(slot.multiRatio, slot.ratioN, localRatio, alpha);
+      }
+      slot.lastEarly = earlyStop;
+      slot.lastHop = continueHop;
+    } else {
+      ewma(slot.baseLat, slot.baseN, latencyUs, alpha);
+    }
+  }
+
+  AdaptiveSnapshot snapshot(const AdaptiveShape& shape) const {
+    std::lock_guard<std::mutex> guard(mu_);
+    AdaptiveSnapshot out;
+    auto it = slots_.find(shape);
+    if (it == slots_.end()) return out;
+    const Slot& slot = it->second;
+    out.multiN = slot.multiN;
+    out.baseN = slot.baseN;
+    out.ratioN = slot.ratioN;
+    out.multiLat = slot.multiLat;
+    out.baseLat = slot.baseLat;
+    out.multiRatio = slot.multiRatio;
+    out.lastEarly = slot.lastEarly;
+    out.lastHop = slot.lastHop;
+    return out;
+  }
+
+  void clear() {
+    std::lock_guard<std::mutex> guard(mu_);
+    slots_.clear();
+  }
+
+  double nextDraw() {
+    std::lock_guard<std::mutex> guard(mu_);
+    std::uniform_real_distribution<double> dist(0.0, 1.0);
+    return dist(rng_);
+  }
+
+ private:
+  struct Slot {
+    double multiLat{0};
+    double baseLat{0};
+    double multiRatio{0};
+    int32_t multiN{0};
+    int32_t baseN{0};
+    int32_t ratioN{0};
+    bool lastEarly{false};
+    int32_t lastHop{0};
+  };
+
+  static void ewma(double& acc, int32_t& n, double sample, double alpha) {
+    if (n <= 0) acc = sample;
+    else acc = alpha * sample + (1.0 - alpha) * acc;
+    if (n < 1000000000) ++n;
+  }
+
+  static double clampRate(double rate) {
+    if (rate < 0.0) return 0.0;
+    if (rate > 1.0) return 1.0;
+    return rate;
+  }
+
+  static double clampAlpha(double alpha) {
+    if (!(alpha > 0.0 && alpha <= 1.0)) return 0.2;
+    return alpha;
+  }
+
+  // Cold start is an optimistic multi-hop try. The storaged guard is the
+  // safety net: a low local-dst ratio returns after one hop, so that try
+  // costs about the same number of round trips as the single-hop baseline.
+  //
+  // With only multi-hop samples:
+  //   - guard fired at hop 1: saved round trips are 0. Prefer baseline.
+  //   - guard fired later: saved round trips are (hop - 1). Keep multi-hop
+  //     when that beats a small bookkeeping overhead.
+  //   - guard did not fire: saved = (steps-1)*localRatio, extra waves from
+  //     the remote fringe = (1-localRatio)*(steps-1). Keep multi-hop when
+  //     the saved term is larger. rttUs cancels as long as it is positive.
+  //
+  // With both samples, the lower EWMA latency wins. A tie prefers baseline.
+  static bool exploitOf(const Slot& slot, const AdaptiveShape& shape, const AdaptiveConfig& cfg) {
+    if (slot.multiN == 0 && slot.baseN == 0) return true;
+    if (slot.multiN > 0 && slot.baseN > 0) {
+      return slot.multiLat + 1.0 < slot.baseLat;
+    }
+    if (slot.multiN > 0) {
+      const double rtt = cfg.rttUs > 0.0 ? cfg.rttUs : 1.0;
+      if (slot.lastEarly && slot.lastHop <= 1) return false;
+      if (slot.lastEarly && slot.lastHop > 1) {
+        const double saved = static_cast<double>(slot.lastHop - 1);
+        const double benefit = saved * rtt;
+        const double overhead = 0.05 * rtt;
+        return benefit > overhead;
+      }
+      if (slot.ratioN == 0) return true;
+      const double steps = static_cast<double>(shape.steps > 0 ? shape.steps : 1);
+      const double ratio = slot.multiRatio;
+      const double saved = (steps - 1.0) * ratio;
+      const double extra = (1.0 - ratio) * (steps - 1.0);
+      return saved * rtt > extra * rtt;
+    }
+    // Baseline samples only. Distribution may have changed, and the guard
+    // bounds a wrong multi-hop try. Try it again; epsilon covers the rest.
+    return true;
+  }
+
+  mutable std::mutex mu_;
+  std::map<AdaptiveShape, Slot> slots_;
+  std::mt19937 rng_{std::random_device{}()};
+};
+
+inline AdaptiveController& adaptiveController() {
+  static AdaptiveController inst;
+  return inst;
+}
+
+struct WalkLaunch {
+  bool useDriver{false};
+  bool adaptive{false};
+  bool choseMulti{false};
+  AdaptiveShape shape{};
+};
+
+// Adaptive replaces the static affinity gate for this launch. Static
+// multi-hop still requires enable + affinity, and it does not turn the
+// per-hop guard on (the caller sends min_local_ratio 0).
+inline WalkLaunch planLocalWalk(bool adaptiveEnabled,
+                                bool staticEnabled,
+                                double staticAffinity,
+                                double affinityThreshold,
+                                int32_t hops,
+                                int32_t frontier,
+                                int32_t maxFrontier,
+                                int32_t maxSteps,
+                                const AdaptiveShape& shape,
+                                const AdaptiveConfig& cfg,
+                                AdaptiveController& ctl,
+                                double draw) {
+  WalkLaunch out;
+  out.shape = shape;
+  const bool hopsOk = shouldLocalMultiHop(true, 1.0, 0.0, hops, frontier, maxFrontier, maxSteps);
+  if (!hopsOk) return out;
+  if (adaptiveEnabled) {
+    out.useDriver = true;
+    out.adaptive = true;
+    out.choseMulti = ctl.choose(shape, cfg, draw);
+    return out;
+  }
+  if (shouldLocalMultiHop(staticEnabled,
+                          staticAffinity,
+                          affinityThreshold,
+                          hops,
+                          frontier,
+                          maxFrontier,
+                          maxSteps)) {
+    out.useDriver = true;
+    out.choseMulti = true;
+  }
+  return out;
+}
+
