+  auto result = runLocalMultiHop<int64_t>(
+      {1}, 3, 3, 0, 0, 0, local, [&](int64_t v) { return scanOf(g, v); }, 0.4);
+  EXPECT_TRUE(result.earlyStop);
+  EXPECT_EQ(2, result.continueHop);
+  EXPECT_EQ(asSet({4}), asSet(result.carry));
+  ASSERT_EQ(1, result.remoteVids.size());
+  EXPECT_EQ(4, result.remoteVids[0]);
+  EXPECT_EQ(1, result.remoteDepth[0]);
+
+  auto out = consumeLocalMultiHop<int64_t>(3, false, true, result.stepsDone, true, result.yielded,
+                                           result.remoteVids, result.remoteDepth, result.carry);
+  bool sawTwo = false;
+  bool sawOne = false;
+  for (const auto& wave : out.waves) {
+    EXPECT_FALSE(wave.allowMulti);
+    if (wave.hopsLeft == 2 && asSet(wave.vids).count(4)) sawTwo = true;
+    if (wave.hopsLeft == 1 && asSet(wave.vids).count(4)) sawOne = true;
+  }
+  EXPECT_TRUE(sawTwo);
+  EXPECT_TRUE(sawOne);
+  EXPECT_TRUE(out.yieldNow.empty());
+}
