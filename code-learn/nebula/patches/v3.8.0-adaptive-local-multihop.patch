+TEST(LocalMultiHopTest, EarlyStopMatchesSingleHopOnTwoDepths) {
+  // 5 is only three hops along 1-2-4-5. Dropping the local dst 2 at the
+  // guard would lose 5 and keep only 6.
+  Graph g{{1, {2, 4}}, {2, {4}}, {4, {5}}, {5, {6}}};
+  auto local = [](int64_t v) { return v < 4; };
+  auto expect = singleHopFinal(g, {1}, 3);
+  EXPECT_EQ(asSet({5, 6}), expect);
+  auto guarded = runLocalMultiHop<int64_t>(
+      {1}, 3, 3, 0, 0, 0, local, [&](int64_t v) { return scanOf(g, v); }, 0.6);
+  EXPECT_TRUE(guarded.earlyStop);
+  EXPECT_EQ(1, guarded.continueHop);
+  EXPECT_EQ(asSet({2, 4}), asSet(guarded.carry));
+  EXPECT_EQ(expect, resumeSingleHop(g, 3, guarded, true));
+
+  auto unguarded = runLocalMultiHop<int64_t>(
+      {1}, 3, 3, 0, 0, 0, local, [&](int64_t v) { return scanOf(g, v); }, 0.0);
+  EXPECT_FALSE(unguarded.earlyStop);
+  EXPECT_EQ(expect, resumeSingleHop(g, 3, unguarded, false));
+}
