+TEST(Copurchase, AffinityVidMatchesHashPart) {
+  for (int parts : {1, 3, 9, 16}) {
+    for (int partIndex = 0; partIndex < parts; ++partIndex) {
+      for (int64_t seq = 0; seq < 50; ++seq) {
+        const int64_t vid = affinityVid(seq, partIndex, parts);
+        EXPECT_GE(vid, 0);
+        EXPECT_EQ(partIndex + 1, partOfInt64(vid, parts)) << vid;
+      }
+    }
+  }
+}
+
+TEST(Copurchase, MirrorSuffixGroupsOneProduct) {
+  const auto a = mirrorSuffix(12, 100, 10, 1);
+  const auto b = mirrorSuffix(12, 100, 20, 2);
+  const auto c = mirrorSuffix(12, 101, 10, 1);
+  EXPECT_TRUE(mirrorSameProduct(a, b));
+  EXPECT_FALSE(mirrorSameProduct(a, c));
+  EXPECT_LT(a, b);
+}
+
+// Eight seeds. Affinity placement puts one community on one part of one host,
+// so the vids the chain touches prove a single host. A cross edge puts a
+// product on another host and the proof fails. Split products still keep the
+// true top users under coarseKeep.
+TEST(Copurchase, AffinityProofAndCoarseEightSeeds) {
+  constexpr int kParts = 9;
+  constexpr int kHosts = 3;
+  std::unordered_map<int32_t, int32_t> partHost;
+  std::vector<std::vector<int32_t>> hostParts(kHosts);
+  for (int part = 1; part <= kParts; ++part) {
+    const int host = (part - 1) % kHosts;
+    partHost[part] = host;
+    hostParts[host].push_back(part);
+  }
+  for (int seed = 1; seed <= 8; ++seed) {
+    std::mt19937 rng(static_cast<uint32_t>(seed) * 10007u);
+    std::uniform_int_distribution<int> hostPick(0, kHosts - 1);
+    std::uniform_int_distribution<int> cross(0, 9);
+    struct Edge {
+      int64_t user;
+      int64_t product;
+      int64_t ts;
+    };
+    std::vector<Edge> edges;
+    std::vector<int64_t> users;
+    std::vector<int64_t> products;
+    int64_t userSeq = 1;
+    int64_t productSeq = 1;
+    for (int host = 0; host < kHosts; ++host) {
+      const int32_t part = hostParts[host][0];
+      const int partIndex = part - 1;
+      for (int i = 0; i < 40; ++i) {
+        users.push_back(affinityVid(userSeq++, partIndex, kParts));
+      }
+      for (int i = 0; i < 6; ++i) {
+        products.push_back(affinityVid(productSeq++, partIndex, kParts));
+      }
+    }
+    std::unordered_map<int64_t, int64_t> sales;
+    for (size_t i = 0; i < products.size(); ++i) sales[products[i]] = 1000 - static_cast<int64_t>(i);
+    for (size_t u = 0; u < users.size(); ++u) {
+      const int home = partHost[partOfInt64(users[u], kParts)];
+      for (int e = 0; e < 4; ++e) {
+        int64_t product = products[(home * 6 + (u + e) % 6) % products.size()];
+        if (seed % 2 == 0 && cross(rng) == 0) {
+          product = products[static_cast<size_t>(hostPick(rng)) * 6 % products.size()];
+        }
+        edges.push_back(Edge{users[u], product, 100 + static_cast<int64_t>((u + e) % 50)});
+      }
+    }
+    const int64_t startUser = users[static_cast<size_t>(seed) % users.size()];
+    std::unordered_map<int64_t, int32_t> count;
+    std::unordered_map<int64_t, int64_t> latest;
+    for (const auto& edge : edges) {
+      if (edge.user != startUser || edge.ts < 100 || edge.ts > 200) continue;
+      count[edge.product]++;
+      if (edge.ts > latest[edge.product]) latest[edge.product] = edge.ts;
+    }
+    std::vector<ProductScore> focusRows;
+    for (const auto& item : count) {
+      focusRows.push_back(ProductScore{item.first, item.second, latest[item.first]});
+    }
+    keepTop(focusRows, 5, betterProduct);
+    std::vector<int64_t> focus;
+    for (const auto& row : focusRows) focus.push_back(row.pid);
+    std::unordered_set<int64_t> focusSet(focus.begin(), focus.end());
+    std::unordered_map<int64_t, std::vector<EdgeFact>> out;
+    for (const auto& edge : edges) {
+      if (edge.ts < 100 || edge.ts > 200) continue;
+      out[edge.user].push_back(EdgeFact{edge.product, edge.ts});
+    }
+    std::vector<UserScore> scored;
+    for (const auto& item : out) {
+      if (item.first == startUser) continue;
+      auto row = scoreUser(item.first, item.second, focusSet, 100, 200);
+      if (row.coCount > 0) scored.push_back(std::move(row));
+    }
+    auto truth = localTopUsers(scored, 15);
+    std::vector<int64_t> touched = {startUser};
+    touched.insert(touched.end(), focus.begin(), focus.end());
+    for (const auto& row : truth) {
+      touched.push_back(row.user);
+      touched.insert(touched.end(), row.productIds.begin(), row.productIds.end());
+    }
+    auto proof = proveLocalChain(touched, kParts, partHost);
+    bool crossEdge = false;
+    for (auto pid : focus) {
+      if (partHost[partOfInt64(pid, kParts)] != partHost[partOfInt64(startUser, kParts)]) {
+        crossEdge = true;
+      }
+    }
+    for (const auto& row : truth) {
+      if (partHost[partOfInt64(row.user, kParts)] != partHost[partOfInt64(startUser, kParts)]) {
+        crossEdge = true;
+      }
+      for (auto pid : row.productIds) {
+        if (partHost[partOfInt64(pid, kParts)] != partHost[partOfInt64(startUser, kParts)]) {
+          crossEdge = true;
+        }
+      }
+    }
+    if (!truth.empty()) {
+      EXPECT_EQ(!crossEdge, proof.complete) << "seed " << seed;
+    }
+
+    std::unordered_map<int32_t, int32_t> focusOnHost;
+    for (auto pid : focus) focusOnHost[partHost[partOfInt64(pid, kParts)]]++;
+    std::unordered_map<int32_t, std::vector<CoBuyer>> byHost;
+    for (const auto& row : scored) {
+      std::unordered_map<int32_t, int32_t> local;
+      for (auto pid : row.productIds) {
+        if (focusSet.count(pid) == 0) continue;
+        local[partHost[partOfInt64(pid, kParts)]]++;
+      }
+      for (const auto& item : local) {
+        const int32_t onHost = focusOnHost[item.first];
+        const int32_t missing = static_cast<int32_t>(focus.size()) - onHost;
+        byHost[item.first].push_back(CoBuyer{row.user, item.second, item.second + missing});
+      }
+    }
+    std::unordered_set<int64_t> kept;
+    for (auto& item : byHost) {
+      auto ids = coarseKeep(item.second, 15, nullptr);
+      kept.insert(ids.begin(), ids.end());
+    }
+    for (const auto& row : truth) {
+      EXPECT_TRUE(kept.count(row.user) != 0) << "seed " << seed << " user " << row.user;
+    }
+  }
+}
+
 }  // namespace algorithm
 }  // namespace nebula
