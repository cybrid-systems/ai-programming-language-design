+// INT64 vid partition. MetaClient::partId copies 8 little-endian bytes into a
+// uint64 and returns vid % numParts + 1. Positive vids are that integer.
+inline int32_t partOfInt64(int64_t vid, int32_t numParts) {
+  if (numParts <= 0) return 0;
+  const uint64_t raw = static_cast<uint64_t>(vid);
+  return static_cast<int32_t>(raw % static_cast<uint64_t>(numParts)) + 1;
+}
+
+// seq >= 0, partIndex in [0, numParts). The vid hashes to part partIndex+1
+// without changing Nebula's hash. Existing data does not move; only new vids
+// chosen this way land on the requested part.
+inline int64_t affinityVid(int64_t seq, int32_t partIndex, int32_t numParts) {
+  return seq * static_cast<int64_t>(numParts) + static_cast<int64_t>(partIndex);
+}
+
+// One community lives on one part of one host. hostParts are the part ids
+// (1-based) that host leads. Communities rotate across those parts.
+inline int32_t communityPart(int32_t community, const std::vector<int32_t>& hostParts) {
+  if (hostParts.empty()) return 0;
+  const auto n = static_cast<int32_t>(hostParts.size());
+  const int32_t idx = community % n;
+  return hostParts[static_cast<size_t>(idx < 0 ? idx + n : idx)];
+}
+
+// True only when every vid's part is present and maps to the same host.
+// A missing part or a second host is not a local chain. The caller passes the
+// live leader map; this function does not guess.
+struct ChainProof {
+  bool complete{false};
+  int32_t host{-1};
+  std::vector<int32_t> parts;
+};
+
+inline ChainProof proveLocalChain(const std::vector<int64_t>& vids,
+                                  int32_t numParts,
+                                  const std::unordered_map<int32_t, int32_t>& partToHost) {
+  ChainProof proof;
+  int32_t host = -1;
+  for (const auto vid : vids) {
+    const int32_t part = partOfInt64(vid, numParts);
+    proof.parts.push_back(part);
+    auto it = partToHost.find(part);
+    if (it == partToHost.end()) {
+      proof.complete = false;
+      proof.host = host;
+      return proof;
+    }
+    if (host < 0) {
+      host = it->second;
+    } else if (host != it->second) {
+      proof.complete = false;
+      proof.host = host;
+      return proof;
+    }
+  }
+  std::sort(proof.parts.begin(), proof.parts.end());
+  proof.parts.erase(std::unique(proof.parts.begin(), proof.parts.end()), proof.parts.end());
+  proof.host = host;
+  proof.complete = host >= 0 && !vids.empty();
+  return proof;
+}
+
+// Per-host coarse prune. `missing` is the number of focus products whose
+// canonical in-edges are not on this host. lower is the focus products this
+// host actually saw. upper = lower + missing.
+//
+// The k-th highest lower on this host is <= the global k-th exact coCount:
+// every lower is <= that buyer's true coCount, and the k-th of a subset cannot
+// exceed the k-th of the full set. A buyer with upper < threshold therefore
+// has true coCount < threshold <= global k-th, so dropping them cannot remove
+// a member of the true top k. Buyers at the threshold stay, ties included.
+//
+// The union of the kept sets, over every host that scanned its own products,
+// still contains the true top k. A buyer whose true coCount reaches the global
+// k-th has upper >= that coCount on every host that sees them, so each such
+// host keeps them and ships every product it saw. Graphd must not treat a
+// missing host as missing=0.
+inline std::vector<int64_t> coarseKeep(const std::vector<CoBuyer>& buyers, int k, int32_t* pruned) {
+  return pruneCandidates(buyers, k, pruned);
+}
+
+// Inverted index stored on the source part, in the same raft batch as the
+// out-edge. Key order is edge type, destination (product), rank, source.
+// The prefix of (edge type, product) lists buyers who live on THIS part only.
+// It is not a copy of the canonical in-edge, which lives on the product part.
+inline std::string mirrorSuffix(int32_t edgeType, int64_t dstVid, int64_t rank, int64_t srcVid) {
+  auto append32 = [](std::string* out, uint32_t value) {
+    char bytes[4];
+    for (int i = 3; i >= 0; --i) {
+      bytes[i] = static_cast<char>(value & 0xff);
+      value >>= 8;
+    }
+    out->append(bytes, 4);
+  };
+  auto append64 = [](std::string* out, uint64_t value) {
+    char bytes[8];
+    for (int i = 7; i >= 0; --i) {
+      bytes[i] = static_cast<char>(value & 0xff);
+      value >>= 8;
+    }
+    out->append(bytes, 8);
+  };
+  std::string name = "cpv1";
+  append32(&name, static_cast<uint32_t>(edgeType));
+  append64(&name, static_cast<uint64_t>(dstVid));
+  append64(&name, static_cast<uint64_t>(rank));
+  append64(&name, static_cast<uint64_t>(srcVid));
+  return name;
+}
+
+inline bool mirrorSameProduct(const std::string& a, const std::string& b) {
+  const size_t prefix = 4 + 4 + 8;
+  return a.size() >= prefix && b.size() >= prefix && a.compare(0, prefix, b, 0, prefix) == 0;
+}
+
 }  // namespace algorithm
 }  // namespace nebula
 
