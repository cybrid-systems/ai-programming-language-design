+bool guardHolds(const std::shared_ptr<State>& state,
+                const storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse>& rpc) {
+  if (rpc.responses().size() != 1 || rpc.hostLatency().size() != 1) return false;
+  const auto host = std::get<0>(rpc.hostLatency().front());
+  const auto& resp = rpc.responses().front();
+  if (!resp.touched_parts_ref().has_value() || resp.touched_parts_ref().value().empty()) return false;
+  auto* client = state->qctx->getStorageClient();
+  for (auto part : resp.touched_parts_ref().value()) {
+    auto leader = client->getLeader(state->space, static_cast<PartitionID>(part));
+    if (!leader.ok() || !(leader.value() == host)) return false;
+  }
+  return true;
+}
+
+std::string vidBytes(int64_t raw) {
+  return std::string(reinterpret_cast<const char*>(&raw), sizeof(raw));
+}
+
+bool localityAllows(const std::shared_ptr<State>& state) {
+  if (state->query.naive || state->query.noaffinity || !FLAGS_copurchase_affinity) {
+    state->affinityReason = "off";
+    return false;
+  }
+  if (FLAGS_copurchase_affinity_force) {
+    state->affinityReason = "force";
+    return true;
+  }
+  auto* meta = state->qctx->getMetaClient();
+  auto parts = meta->partsNum(state->space);
+  if (!parts.ok() || parts.value() <= 0) {
+    state->affinityReason = "parts";
+    return false;
+  }
+  const int32_t numParts = parts.value();
+  const auto userPart = meta->partId(numParts, vidBytes(state->query.user));
+  const int64_t stale = FLAGS_local_multihop_prior_stale_ms;
+  const bool perEntry = FLAGS_local_multihop_prior_per_entry;
+  auto ratio = meta->localDstRatioForEdges(
+      state->space, userPart, std::vector<int32_t>{state->edgeType}, stale, perEntry);
+  if (!ratio.ok()) {
+    state->affinityReason = "no_ratio";
+    return false;
+  }
+  state->outRatio = ratio.value();
+  if (state->outRatio + 1e-12 < FLAGS_copurchase_affinity_min_ratio) {
+    state->affinityReason = "ratio";
+    return false;
+  }
+  auto* storage = state->qctx->getStorageClient();
+  auto home = storage->getLeader(state->space, userPart);
+  if (!home.ok()) {
+    state->affinityReason = "leader";
+    return false;
+  }
+  bool anyCov = false;
+  double minCov = 1.0;
+  for (PartitionID part = 1; part <= static_cast<PartitionID>(numParts); ++part) {
+    auto leader = storage->getLeader(state->space, part);
+    if (!leader.ok() || !(leader.value() == home.value())) continue;
+    auto cov = meta->localDstRatioForEdges(
+        state->space, part, std::vector<int32_t>{-state->edgeType}, stale, perEntry);
+    if (!cov.ok()) continue;
+    anyCov = true;
+    if (cov.value() < minCov) minCov = cov.value();
+  }
+  if (!anyCov) {
+    state->affinityReason = "no_cov";
+    return false;
+  }
+  state->buyerCov = minCov;
+  if (minCov + 1e-12 < FLAGS_copurchase_affinity_min_ratio) {
+    state->affinityReason = "cov";
+    return false;
+  }
+  state->affinityReason = "stats";
+  return true;
+}
+
+algorithm::UserScore userFromRow(const storage::cpp2::CopurchaseUserRow& row) {
+  algorithm::UserScore score;
+  score.user = row.get_user();
+  score.coCount = row.get_co_count();
+  score.purchaseCount = row.get_purchase_count();
+  score.latestTs = row.get_latest_ts();
+  score.productIds = row.get_product_ids();
+  return score;
+}
+
+folly::Future<StatusOr<DataSet>> maybeAffinity(const std::shared_ptr<State>& state) {
+  if (!localityAllows(state)) return pushdown(state);
+  return callPhase(state,
+                   storage::cpp2::CopurchasePhase::LOCAL_CHAIN,
+                   {state->query.user},
+                   {},
+                   FLAGS_copurchase_top_products,
+                   true,
+                   false,
+                   FLAGS_copurchase_top_users,
+                   FLAGS_copurchase_top_sales)
+      .thenValue([state](storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> rpc)
+                     -> folly::Future<StatusOr<DataSet>> {
+        auto seen = take(state, rpc);
+        state->hops[0] = seen.stat;
+        state->rounds = 1;
+        auto restart = [&]() {
+          state->localHit = false;
+          state->rounds = 0;
+          state->focus.clear();
+          state->users.clear();
+          state->sales.clear();
+          for (auto& hop : state->hops) hop = HopStat();
+          return pushdown(state);
+        };
+        if (seen.limit) return fail(state, "limit");
+        if (!seen.applied || !seen.ok || !guardHolds(state, rpc)) {
+          state->affinityReason = !seen.applied ? "not_applied" : "guard";
+          state->localStop = 0;
+          return restart();
+        }
+        const auto& resp = rpc.responses().front();
+        const int32_t stop = resp.local_stop_ref().has_value() ? resp.local_stop_ref().value() : 0;
+        state->localStop = stop;
+        const bool complete =
+            stop == 1 && resp.local_complete_ref().has_value() && resp.local_complete_ref().value();
+        if (complete) {
+          state->localHit = true;
+          if (resp.users_ref().has_value()) {
+            for (const auto& row : resp.users_ref().value()) {
+              state->users.push_back(userFromRow(row));
+            }
+          }
+          state->buyers = static_cast<int64_t>(state->users.size());
+          state->sent = state->buyers;
+          if (resp.ids_ref().has_value()) {
+            const auto& ids = resp.ids_ref().value();
+            const auto& sales =
+                resp.sales_ref().has_value() ? resp.sales_ref().value() : std::vector<int64_t>{};
+            for (size_t i = 0; i < ids.size(); ++i) {
+              algorithm::SalesScore score;
+              score.pid = ids[i];
+              score.sales = i < sales.size() ? sales[i] : 0;
+              state->sales.push_back(score);
+            }
+          }
+          state->hops[1].returned = state->buyers;
+          state->hops[2].returned = state->buyers;
+          state->hops[3].returned = static_cast<int64_t>(state->sales.size());
+          logPlan(*state);
+          return folly::makeFuture<StatusOr<DataSet>>(toDataSet(state->sales));
+        }
+        if (stop == 2 && resp.ids_ref().has_value()) {
+          state->focus = resp.ids_ref().value();
+          state->hops[0].returned = static_cast<int64_t>(state->focus.size());
+          if (state->focus.empty()) {
+            logPlan(*state);
+            return folly::makeFuture<StatusOr<DataSet>>(emptyResult());
+          }
+          return afterBuyers(state);
+        }
+        if (stop == 3 && resp.ids_ref().has_value()) {
+          std::vector<algorithm::UserScore> local;
+          if (resp.users_ref().has_value()) {
+            for (const auto& row : resp.users_ref().value()) {
+              if (row.score_exact_ref().has_value() && row.score_exact_ref().value()) {
+                local.push_back(userFromRow(row));
+              }
+            }
+          }
+          state->focus = resp.ids_ref().value();
+          std::vector<int64_t> remote =
+              resp.remote_ids_ref().has_value() ? resp.remote_ids_ref().value() : std::vector<int64_t>{};
+          if (remote.empty()) {
+            state->users = algorithm::localTopUsers(std::move(local), FLAGS_copurchase_top_users);
+            std::unordered_set<int64_t> pids;
+            for (const auto& user : state->users) {
+              pids.insert(user.productIds.begin(), user.productIds.end());
+            }
+            return finishWithSales(state, std::vector<int64_t>(pids.begin(), pids.end()));
+          }
+          return callPhase(state,
+                           storage::cpp2::CopurchasePhase::FUSED_COCOUNT,
+                           remote,
+                           state->focus,
+                           FLAGS_copurchase_top_users,
+                           false)
+              .thenValue([state, local = std::move(local)](
+                             storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> fused)
+                             -> folly::Future<StatusOr<DataSet>> {
+                auto fusedSeen = take(state, fused);
+                state->hops[2] = fusedSeen.stat;
+                state->rounds++;
+                if (fusedSeen.limit) return fail(state, "limit");
+                if (!fusedSeen.applied) return fail(state, "not_applied");
+                if (!fusedSeen.ok) return fail(state, "rpc");
+                std::vector<algorithm::UserScore> remoteScores;
+                for (const auto& one : fused.responses()) {
+                  if (!one.users_ref().has_value()) continue;
+                  for (const auto& row : one.users_ref().value()) {
+                    remoteScores.push_back(userFromRow(row));
+                  }
+                }
+                state->users = algorithm::mergeExact({local, remoteScores}, FLAGS_copurchase_top_users);
+                state->buyers = static_cast<int64_t>(local.size() + remoteScores.size());
+                state->sent = state->buyers;
+                std::unordered_set<int64_t> pids;
+                for (const auto& user : state->users) {
+                  pids.insert(user.productIds.begin(), user.productIds.end());
+                }
+                return finishWithSales(state, std::vector<int64_t>(pids.begin(), pids.end()));
+              });
+        }
+        if (stop == 4 && resp.users_ref().has_value()) {
+          for (const auto& row : resp.users_ref().value()) state->users.push_back(userFromRow(row));
+          std::vector<algorithm::SalesScore> known;
+          if (resp.ids_ref().has_value()) {
+            const auto& ids = resp.ids_ref().value();
+            const auto& sales =
+                resp.sales_ref().has_value() ? resp.sales_ref().value() : std::vector<int64_t>{};
+            for (size_t i = 0; i < ids.size(); ++i) {
+              known.push_back(algorithm::SalesScore{ids[i], i < sales.size() ? sales[i] : 0});
+            }
+          }
+          std::vector<int64_t> remote =
+              resp.remote_ids_ref().has_value() ? resp.remote_ids_ref().value() : std::vector<int64_t>{};
+          if (remote.empty()) {
+            state->sales = algorithm::localTopSales(std::move(known), FLAGS_copurchase_top_sales);
+            logPlan(*state);
+            return folly::makeFuture<StatusOr<DataSet>>(toDataSet(state->sales));
+          }
+          return callPhase(state,
+                           storage::cpp2::CopurchasePhase::HOP4_SALES,
+                           remote,
+                           {},
+                           FLAGS_copurchase_top_sales,
+                           true)
+              .thenValue([state, known = std::move(known)](
+                             storage::StorageRpcResponse<storage::cpp2::CopurchaseResponse> salesRpc)
+                             -> folly::Future<StatusOr<DataSet>> {
+                auto salesSeen = take(state, salesRpc);
+                state->hops[3] = salesSeen.stat;
+                state->rounds++;
+                if (salesSeen.limit) return fail(state, "limit");
+                if (!salesSeen.applied) return fail(state, "not_applied");
+                if (!salesSeen.ok) return fail(state, "rpc");
+                std::vector<algorithm::SalesScore> rows = known;
+                for (const auto& one : salesRpc.responses()) {
+                  if (!one.ids_ref().has_value()) continue;
+                  const auto& ids = one.ids_ref().value();
+                  const auto& amounts =
+                      one.sales_ref().has_value() ? one.sales_ref().value() : std::vector<int64_t>{};
+                  for (size_t i = 0; i < ids.size(); ++i) {
+                    rows.push_back(algorithm::SalesScore{ids[i], i < amounts.size() ? amounts[i] : 0});
+                  }
+                }
+                state->sales = algorithm::localTopSales(std::move(rows), FLAGS_copurchase_top_sales);
+                logPlan(*state);
+                return folly::makeFuture<StatusOr<DataSet>>(toDataSet(state->sales));
+              });
+        }
+        state->affinityReason = "stop";
+        state->localStop = stop;
+        return restart();
+      });
+}
