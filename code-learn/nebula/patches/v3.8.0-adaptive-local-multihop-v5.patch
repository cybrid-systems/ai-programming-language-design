+// A sample timestamp is stale when it is older than maxAgeMs. maxAgeMs <= 0
+// never expires. A missing timestamp is stale. The caller treats stale as
+// uncertain, not as a confident baseline or a confident multihop.
+inline bool ratioEntryFresh(int64_t tsMs, int64_t nowMs, int64_t maxAgeMs) {
+  if (tsMs <= 0) return false;
+  if (maxAgeMs <= 0) return true;
+  if (nowMs < tsMs) return true;
+  return nowMs - tsMs <= maxAgeMs;
+}
