+StatusOr<double> MetaClient::localDstRatioForEdges(GraphSpaceID spaceId,
+                                                  PartitionID partId,
+                                                  const std::vector<int32_t>& edgeTypes,
+                                                  int64_t maxAgeMs,
+                                                  bool perEntry) const {
+  folly::SharedMutex::ReadHolder holder(localDstRatioLock_);
+  const int64_t now = time::WallClock::fastNowInMilliSec();
+  auto find = [&](int32_t edge) -> const LocalDstRatioSample* {
+    for (const auto& entry : localDstEntries_) {
+      if (entry.space == spaceId && entry.part == partId && entry.edge == edge) return &entry;
+    }
+    return nullptr;
+  };
+  if (edgeTypes.empty()) {
+    bool any = false;
+    double minRatio = 0;
+    for (const auto& entry : localDstEntries_) {
+      if (entry.space != spaceId || entry.part != partId) continue;
+      if (perEntry && !algorithm::ratioEntryFresh(entry.tsMs, now, maxAgeMs)) {
+        return Status::Error("stale local-dst sample");
+      }
+      if (!any || entry.ratio < minRatio) minRatio = entry.ratio;
+      any = true;
+    }
+    if (!any) return Status::Error("no local-dst sample");
+    return minRatio;
+  }
+  bool haveTyped = false;
+  for (int32_t edge : edgeTypes) {
+    if (find(edge) != nullptr) haveTyped = true;
+  }
+  bool any = false;
+  double minRatio = 0;
+  for (int32_t edge : edgeTypes) {
+    const LocalDstRatioSample* entry = find(edge);
+    if (entry == nullptr && !haveTyped) entry = find(0);
+    if (entry == nullptr) return Status::Error("no local-dst sample");
+    if (perEntry && !algorithm::ratioEntryFresh(entry->tsMs, now, maxAgeMs)) {
+      return Status::Error("stale local-dst sample");
+    }
+    if (!any || entry->ratio < minRatio) minRatio = entry->ratio;
+    any = true;
+  }
+  if (!any) return Status::Error("no local-dst sample");
+  return minRatio;
+}
