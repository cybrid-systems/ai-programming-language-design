+  for (const auto& item : items) {
+    reservoirConsider(once, seenOnce, localOnce, item.first, 2, item.second);
+  }
+  for (size_t i = 0; i < 3; ++i) {
+    reservoirConsider(chunked, seenChunk, localChunk, items[i].first, 2, items[i].second);
+  }
+  for (size_t i = 3; i < items.size(); ++i) {
+    reservoirConsider(chunked, seenChunk, localChunk, items[i].first, 2, items[i].second);
+  }
+  EXPECT_EQ(once, chunked);
+  EXPECT_EQ(seenOnce, seenChunk);
+  EXPECT_EQ(localOnce, localChunk);
+}
