+const std::string& MetaKeyUtils::localDstRatioPrefix() {
+  return kLocalDstRatioTable;
+}
+
+std::string MetaKeyUtils::localDstRatioKey(GraphSpaceID spaceId,
+                                           PartitionID partId,
+                                           int32_t edgeType) {
+  std::string key;
+  key.reserve(kLocalDstRatioTable.size() + sizeof(GraphSpaceID) + sizeof(PartitionID) +
+              sizeof(int32_t));
+  key.append(kLocalDstRatioTable.data(), kLocalDstRatioTable.size())
+      .append(reinterpret_cast<const char*>(&spaceId), sizeof(GraphSpaceID))
+      .append(reinterpret_cast<const char*>(&partId), sizeof(PartitionID))
+      .append(reinterpret_cast<const char*>(&edgeType), sizeof(int32_t));
+  return key;
+}
+
+std::string MetaKeyUtils::localDstRatioVal(double ratio, int64_t tsMs, int64_t version) {
+  std::string val;
+  val.resize(sizeof(double) + sizeof(int64_t) * 2);
+  char* p = &val[0];
+  memcpy(p, &ratio, sizeof(double));
+  p += sizeof(double);
+  memcpy(p, &tsMs, sizeof(int64_t));
+  p += sizeof(int64_t);
+  memcpy(p, &version, sizeof(int64_t));
+  return val;
+}
+
+bool MetaKeyUtils::parseLocalDstRatioKey(folly::StringPiece rawKey, LocalDstRatioRecord* out) {
+  const size_t need = kLocalDstRatioTable.size() + sizeof(GraphSpaceID) + sizeof(PartitionID) +
+                      sizeof(int32_t);
+  if (out == nullptr || rawKey.size() < need) return false;
+  if (memcmp(rawKey.data(), kLocalDstRatioTable.data(), kLocalDstRatioTable.size()) != 0) {
+    return false;
+  }
+  size_t offset = kLocalDstRatioTable.size();
+  out->space = *reinterpret_cast<const GraphSpaceID*>(rawKey.data() + offset);
+  offset += sizeof(GraphSpaceID);
+  out->part = *reinterpret_cast<const PartitionID*>(rawKey.data() + offset);
+  offset += sizeof(PartitionID);
+  out->edge = *reinterpret_cast<const int32_t*>(rawKey.data() + offset);
+  return true;
+}
+
+bool MetaKeyUtils::parseLocalDstRatioVal(folly::StringPiece rawVal, LocalDstRatioRecord* out) {
+  const size_t need = sizeof(double) + sizeof(int64_t) * 2;
+  if (out == nullptr || rawVal.size() < need) return false;
+  size_t offset = 0;
+  memcpy(&out->ratio, rawVal.data() + offset, sizeof(double));
+  offset += sizeof(double);
+  memcpy(&out->tsMs, rawVal.data() + offset, sizeof(int64_t));
+  offset += sizeof(int64_t);
+  memcpy(&out->version, rawVal.data() + offset, sizeof(int64_t));
+  return true;
+}
