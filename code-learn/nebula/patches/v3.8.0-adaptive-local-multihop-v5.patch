+void loadLocalDstRatio(nebula::kvstore::KVStore* kv) {
+  if (gLocalDstRatioLoaded || kv == nullptr) return;
+  std::string prefix = nebula::MetaKeyUtils::localDstRatioPrefix();
+  std::unique_ptr<nebula::kvstore::KVIterator> iter;
+  auto code = kv->prefix(nebula::kDefaultSpaceId, nebula::kDefaultPartId, prefix, &iter);
+  if (code == nebula::cpp2::ErrorCode::E_LEADER_CHANGED) {
+    // Followers see the request before the client has followed the leader.
+    return;
+  }
+  if (code != nebula::cpp2::ErrorCode::SUCCEEDED || iter == nullptr) {
+    LOG(WARNING) << "local_dst_ratio_kv_load failed code=" << static_cast<int>(code);
+    return;
+  }
+  int32_t n = 0;
+  for (; iter->valid(); iter->next()) {
+    nebula::MetaKeyUtils::LocalDstRatioRecord rec;
+    if (!nebula::MetaKeyUtils::parseLocalDstRatioKey(iter->key(), &rec)) continue;
+    if (!nebula::MetaKeyUtils::parseLocalDstRatioVal(iter->val(), &rec)) continue;
+    gLocalDstRatio[rec.space][rec.part][rec.edge] =
+        LocalDstRec{rec.ratio, rec.tsMs, rec.version};
+    ++n;
+  }
+  gLocalDstRatioLoaded = true;
+  LOG(INFO) << "local_dst_ratio_kv_load entries=" << n;
+}
+
