new file mode 100644
index 0000000..12c8cab
--- /dev/null
+++ b/src/graph/util/DstOnlyEdgeFilter.h
@@ -0,0 +1,150 @@
+/* Copyright (c) 2026 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#ifndef GRAPH_UTIL_DSTONLYEDGEFILTER_H_
+#define GRAPH_UTIL_DSTONLYEDGEFILTER_H_
+
+#include "common/expression/ExprVisitorImpl.h"
+#include "common/expression/Expression.h"
+
+namespace nebula {
+namespace graph {
+
+// Predicates that GetDstBySrc can evaluate while scanning one vertex's edges.
+// The RPC returns only dst vids, so the predicate must be computable from the
+// edge key and the edge value. Tag, src/dst vertex, input and variable
+// expressions stay on the GetNeighbors plan.
+class DstOnlyEdgeFilterVisitor final : public ExprVisitorImpl {
+ public:
+  bool canPush() const {
+    return !rejected_;
+  }
+
+  void visit(UnaryExpression* expr) override {
+    auto kind = expr->kind();
+    if (kind == Expression::Kind::kUnaryIncr || kind == Expression::Kind::kUnaryDecr) {
+      rejected_ = true;
+      return;
+    }
+    ExprVisitorImpl::visit(expr);
+  }
+
+  void visit(SubscriptExpression*) override {
+    rejected_ = true;
+  }
+  void visit(AttributeExpression*) override {
+    rejected_ = true;
+  }
+  void visit(LabelAttributeExpression*) override {
+    rejected_ = true;
+  }
+  void visit(LabelExpression*) override {
+    rejected_ = true;
+  }
+  void visit(UUIDExpression*) override {
+    rejected_ = true;
+  }
+  void visit(VariableExpression*) override {
+    rejected_ = true;
+  }
+  void visit(VersionedVariableExpression*) override {
+    rejected_ = true;
+  }
+  void visit(LabelTagPropertyExpression*) override {
+    rejected_ = true;
+  }
+  void visit(TagPropertyExpression*) override {
+    rejected_ = true;
+  }
+  void visit(InputPropertyExpression*) override {
+    rejected_ = true;
+  }
+  void visit(VariablePropertyExpression*) override {
+    rejected_ = true;
+  }
+  void visit(DestPropertyExpression*) override {
+    rejected_ = true;
+  }
+  void visit(SourcePropertyExpression*) override {
+    rejected_ = true;
+  }
+  void visit(VertexExpression*) override {
+    rejected_ = true;
+  }
+  void visit(EdgeExpression*) override {
+    rejected_ = true;
+  }
+  void visit(ColumnExpression*) override {
+    rejected_ = true;
+  }
+  void visit(AggregateExpression*) override {
+    rejected_ = true;
+  }
+  void visit(CaseExpression*) override {
+    rejected_ = true;
+  }
+  void visit(PredicateExpression*) override {
+    rejected_ = true;
+  }
+  void visit(ListComprehensionExpression*) override {
+    rejected_ = true;
+  }
+  void visit(ReduceExpression*) override {
+    rejected_ = true;
+  }
+  void visit(SubscriptRangeExpression*) override {
+    rejected_ = true;
+  }
+  void visit(MatchPathPatternExpression*) override {
+    rejected_ = true;
+  }
+  void visit(PathBuildExpression*) override {
+    rejected_ = true;
+  }
+
+  void visit(EdgePropertyExpression* expr) override {
+    rejectStar(expr->sym());
+  }
+  void visit(EdgeSrcIdExpression* expr) override {
+    rejectStar(expr->sym());
+  }
+  void visit(EdgeTypeExpression* expr) override {
+    rejectStar(expr->sym());
+  }
+  void visit(EdgeRankExpression* expr) override {
+    rejectStar(expr->sym());
+  }
+  void visit(EdgeDstIdExpression* expr) override {
+    rejectStar(expr->sym());
+  }
+
+ private:
+  void rejectStar(const std::string& sym) {
+    if (sym.empty() || sym == "*") {
+      rejected_ = true;
+    }
+  }
+
+  bool rejected_{false};
+};
+
+class DstOnlyEdgeFilter {
+ public:
+  // True when every leaf is an edge key/property (named, not "*"), a constant,
+  // or a function/arithmetic/logical/relational combination of those.
+  static bool canPush(const Expression* expr) {
+    if (expr == nullptr) {
+      return false;
+    }
+    DstOnlyEdgeFilterVisitor visitor;
+    const_cast<Expression*>(expr)->accept(&visitor);
+    return visitor.canPush();
+  }
+};
+
+}  // namespace graph
+}  // namespace nebula
+
+#endif  // GRAPH_UTIL_DSTONLYEDGEFILTER_H_
