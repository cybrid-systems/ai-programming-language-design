+nebula::cpp2::ErrorCode GetDstBySrcProcessor::buildEdgeFilter(const cpp2::GetDstBySrcRequest& req) {
+  if (!req.filter_ref().has_value()) {
+    return nebula::cpp2::ErrorCode::SUCCEEDED;
+  }
+  const auto* filterStr = req.get_filter();
+  if (filterStr == nullptr || filterStr->empty()) {
+    return nebula::cpp2::ErrorCode::SUCCEEDED;
+  }
+  auto* pool = &this->planContext_->objPool_;
+  filter_ = Expression::decode(pool, *filterStr);
+  if (filter_ == nullptr) {
+    return nebula::cpp2::ErrorCode::E_INVALID_FILTER;
+  }
+  // Do not call checkExp(). It inserts the referenced property into propContexts_,
+  // and GetDstBySrcNode requires that list to stay { _dst }. The row reader can
+  // still see every column.
+  return validateEdgeFilter(filter_);
+}
+
+nebula::cpp2::ErrorCode GetDstBySrcProcessor::validateEdgeFilter(const Expression* exp) {
+  if (exp == nullptr) {
+    return nebula::cpp2::ErrorCode::E_INVALID_FILTER;
+  }
+  auto recurseUnary = [this](const Expression* e) {
+    return validateEdgeFilter(static_cast<const UnaryExpression*>(e)->operand());
+  };
+  switch (exp->kind()) {
+    case Expression::Kind::kConstant:
+      return nebula::cpp2::ErrorCode::SUCCEEDED;
+    case Expression::Kind::kUnaryPlus:
+    case Expression::Kind::kUnaryNegate:
+    case Expression::Kind::kUnaryNot:
+    case Expression::Kind::kIsNull:
+    case Expression::Kind::kIsNotNull:
+    case Expression::Kind::kIsEmpty:
+    case Expression::Kind::kIsNotEmpty:
+      return recurseUnary(exp);
+    case Expression::Kind::kAdd:
+    case Expression::Kind::kMinus:
+    case Expression::Kind::kMultiply:
+    case Expression::Kind::kDivision:
+    case Expression::Kind::kMod:
+    case Expression::Kind::kRelEQ:
+    case Expression::Kind::kRelNE:
+    case Expression::Kind::kRelLT:
+    case Expression::Kind::kRelLE:
+    case Expression::Kind::kRelGT:
+    case Expression::Kind::kRelGE:
+    case Expression::Kind::kRelREG:
+    case Expression::Kind::kRelIn:
+    case Expression::Kind::kRelNotIn:
+    case Expression::Kind::kContains:
+    case Expression::Kind::kNotContains:
+    case Expression::Kind::kStartsWith:
+    case Expression::Kind::kNotStartsWith:
+    case Expression::Kind::kEndsWith:
+    case Expression::Kind::kNotEndsWith: {
+      auto* binary = static_cast<const BinaryExpression*>(exp);
+      auto code = validateEdgeFilter(binary->left());
+      if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+        return code;
+      }
+      return validateEdgeFilter(binary->right());
+    }
+    case Expression::Kind::kLogicalAnd:
+    case Expression::Kind::kLogicalOr:
+    case Expression::Kind::kLogicalXor: {
+      auto* logical = static_cast<const LogicalExpression*>(exp);
+      for (const auto* operand : logical->operands()) {
+        auto code = validateEdgeFilter(operand);
+        if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+          return code;
+        }
+      }
+      return nebula::cpp2::ErrorCode::SUCCEEDED;
+    }
+    case Expression::Kind::kTypeCasting:
+      return validateEdgeFilter(static_cast<const TypeCastingExpression*>(exp)->operand());
+    case Expression::Kind::kFunctionCall: {
+      auto* call = static_cast<const FunctionCallExpression*>(exp);
+      for (const auto* arg : call->args()->args()) {
+        auto code = validateEdgeFilter(arg);
+        if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+          return code;
+        }
+      }
+      return nebula::cpp2::ErrorCode::SUCCEEDED;
+    }
+    case Expression::Kind::kList: {
+      auto* list = static_cast<const ListExpression*>(exp);
+      for (const auto* item : list->items()) {
+        auto code = validateEdgeFilter(item);
+        if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+          return code;
+        }
+      }
+      return nebula::cpp2::ErrorCode::SUCCEEDED;
+    }
+    case Expression::Kind::kSet: {
+      auto* set = static_cast<const SetExpression*>(exp);
+      for (const auto* item : set->items()) {
+        auto code = validateEdgeFilter(item);
+        if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+          return code;
+        }
+      }
+      return nebula::cpp2::ErrorCode::SUCCEEDED;
+    }
+    case Expression::Kind::kMap: {
+      auto* map = static_cast<const MapExpression*>(exp);
+      for (const auto& item : map->items()) {
+        auto code = validateEdgeFilter(item.second);
+        if (code != nebula::cpp2::ErrorCode::SUCCEEDED) {
+          return code;
+        }
+      }
+      return nebula::cpp2::ErrorCode::SUCCEEDED;
+    }
+    case Expression::Kind::kEdgeProperty:
+    case Expression::Kind::kEdgeSrc:
+    case Expression::Kind::kEdgeType:
+    case Expression::Kind::kEdgeRank:
+    case Expression::Kind::kEdgeDst:
+      return validateEdgeRef(static_cast<const PropertyExpression*>(exp));
+    default:
+      return nebula::cpp2::ErrorCode::E_INVALID_FILTER;
+  }
+}
+
+nebula::cpp2::ErrorCode GetDstBySrcProcessor::validateEdgeRef(const PropertyExpression* exp) {
+  const auto& edgeName = exp->sym();
+  if (edgeName.empty() || edgeName == "*") {
+    return nebula::cpp2::ErrorCode::E_INVALID_FILTER;
+  }
+  auto edgeRet = this->env_->schemaMan_->toEdgeType(spaceId_, edgeName);
+  if (!edgeRet.ok()) {
+    VLOG(1) << "Can't find edge " << edgeName << " in space " << spaceId_;
+    return nebula::cpp2::ErrorCode::E_EDGE_NOT_FOUND;
+  }
+  auto edgeType = edgeRet.value();
+  if (edgeContext_.indexMap_.count(edgeType) == 0 &&
+      edgeContext_.indexMap_.count(-edgeType) == 0) {
+    VLOG(1) << "Edge " << edgeName << " is not in this getDstBySrc request";
+    return nebula::cpp2::ErrorCode::E_INVALID_FILTER;
+  }
+  auto schemaIter = edgeContext_.schemas_.find(std::abs(edgeType));
+  if (schemaIter == edgeContext_.schemas_.end() || schemaIter->second.empty()) {
+    return nebula::cpp2::ErrorCode::E_EDGE_NOT_FOUND;
+  }
+  if (exp->kind() != Expression::Kind::kEdgeProperty) {
+    return nebula::cpp2::ErrorCode::SUCCEEDED;
+  }
+  const auto& propName = exp->prop();
+  if (propName == kSrc || propName == kDst || propName == kRank || propName == kType) {
+    return nebula::cpp2::ErrorCode::SUCCEEDED;
+  }
+  if (schemaIter->second.back()->field(propName) == nullptr) {
+    VLOG(1) << "Can't find prop " << propName << " on edge " << edgeName;
+    return nebula::cpp2::ErrorCode::E_EDGE_PROP_NOT_FOUND;
+  }
   return nebula::cpp2::ErrorCode::SUCCEEDED;
 }
 
