@@ -0,0 +1,95 @@
+/* Copyright (c) 2026 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include <gtest/gtest.h>
+
+#include "common/base/ObjectPool.h"
+#include "common/expression/EdgeExpression.h"
+#include "common/expression/FunctionCallExpression.h"
+#include "common/expression/LogicalExpression.h"
+#include "common/expression/PropertyExpression.h"
+#include "common/expression/RelationalExpression.h"
+#include "graph/util/DstOnlyEdgeFilter.h"
+
+namespace nebula {
+namespace graph {
+
+class DstOnlyEdgeFilterTest : public ::testing::Test {
+ protected:
+  ObjectPool pool_;
+};
+
+TEST_F(DstOnlyEdgeFilterTest, EdgeTimestampComparison) {
+  auto* expr = RelationalExpression::makeGT(
+      &pool_,
+      EdgePropertyExpression::make(&pool_, "buy", "ts"),
+      ConstantExpression::make(&pool_, Value(1L)));
+  EXPECT_TRUE(DstOnlyEdgeFilter::canPush(expr));
+}
+
+TEST_F(DstOnlyEdgeFilterTest, AndOfEdgePropsAndNow) {
+  auto* ts = RelationalExpression::makeGT(
+      &pool_,
+      EdgePropertyExpression::make(&pool_, "buy", "ts"),
+      FunctionCallExpression::make(&pool_, "now"));
+  auto* amount = RelationalExpression::makeGT(
+      &pool_,
+      EdgePropertyExpression::make(&pool_, "buy", "amount"),
+      ConstantExpression::make(&pool_, Value(0L)));
+  auto* expr = LogicalExpression::makeAnd(&pool_, ts, amount);
+  EXPECT_TRUE(DstOnlyEdgeFilter::canPush(expr));
+}
+
+TEST_F(DstOnlyEdgeFilterTest, NullExpr) {
+  EXPECT_FALSE(DstOnlyEdgeFilter::canPush(nullptr));
+}
+
+TEST_F(DstOnlyEdgeFilterTest, StarEdgeRejected) {
+  auto* expr = RelationalExpression::makeGT(
+      &pool_,
+      EdgePropertyExpression::make(&pool_, "*", "ts"),
+      ConstantExpression::make(&pool_, Value(1L)));
+  EXPECT_FALSE(DstOnlyEdgeFilter::canPush(expr));
+}
+
+TEST_F(DstOnlyEdgeFilterTest, DestPropertyRejected) {
+  auto* edge = RelationalExpression::makeGT(
+      &pool_,
+      EdgePropertyExpression::make(&pool_, "buy", "ts"),
+      ConstantExpression::make(&pool_, Value(1L)));
+  auto* dst = RelationalExpression::makeGT(
+      &pool_,
+      DestPropertyExpression::make(&pool_, "user", "age"),
+      ConstantExpression::make(&pool_, Value(1L)));
+  auto* expr = LogicalExpression::makeAnd(&pool_, edge, dst);
+  EXPECT_FALSE(DstOnlyEdgeFilter::canPush(expr));
+}
+
+TEST_F(DstOnlyEdgeFilterTest, SourcePropertyRejected) {
+  auto* expr = RelationalExpression::makeEQ(
+      &pool_,
+      SourcePropertyExpression::make(&pool_, "item", "type"),
+      ConstantExpression::make(&pool_, Value("beauty")));
+  EXPECT_FALSE(DstOnlyEdgeFilter::canPush(expr));
+}
+
+TEST_F(DstOnlyEdgeFilterTest, WholeEdgeFunctionRejected) {
+  // rank(edge) is a function over the edge expression, not EdgeRankExpression.
+  auto* rank = FunctionCallExpression::make(&pool_, "rank", {EdgeExpression::make(&pool_)});
+  auto* expr =
+      RelationalExpression::makeGT(&pool_, rank, ConstantExpression::make(&pool_, Value(1L)));
+  EXPECT_FALSE(DstOnlyEdgeFilter::canPush(expr));
+}
+
+TEST_F(DstOnlyEdgeFilterTest, NamedEdgeRankAllowed) {
+  auto* expr = RelationalExpression::makeGT(
+      &pool_,
+      EdgeRankExpression::make(&pool_, "buy"),
+      ConstantExpression::make(&pool_, Value(1L)));
+  EXPECT_TRUE(DstOnlyEdgeFilter::canPush(expr));
+}
+
+}  // namespace graph
+}  // namespace nebula
