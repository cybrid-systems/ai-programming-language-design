+TEST(AdaptiveMultiHopTest, RepeatedHop1StopOverridesStaleLatency) {
+  AdaptiveController ctl;
+  AdaptiveConfig cfg;
+  cfg.exploreRate = 0;
+  cfg.earlyFlip = true;
+  cfg.minLocalRatio = 0.6;
+  auto shape = makeAdaptiveShape(1, {1}, 3, false);
+  shape.part = 4;
+  ctl.observe(shape, cfg, false, 22000, -1, false, 0);
+  ctl.observe(shape, cfg, true, 7000, 1.0, false, 0);
+  EXPECT_TRUE(ctl.choose(shape, cfg, 0.5));
+  ctl.observe(shape, cfg, true, 22000, 0.2, true, 1);
+  EXPECT_EQ(1, ctl.snapshot(shape).hop1Streak);
+  EXPECT_TRUE(ctl.choose(shape, cfg, 0.5));
+  ctl.observe(shape, cfg, true, 22000, 0.2, true, 1);
+  EXPECT_EQ(2, ctl.snapshot(shape).hop1Streak);
+  EXPECT_FALSE(ctl.choose(shape, cfg, 0.5));
+  // Affinity returns on the probe. The streak clears and the fast sample wins.
+  ctl.observe(shape, cfg, true, 7000, 1.0, false, 0);
+  EXPECT_EQ(0, ctl.snapshot(shape).hop1Streak);
+  EXPECT_EQ(0, ctl.snapshot(shape).earlyN);
+  EXPECT_TRUE(ctl.choose(shape, cfg, 0.5));
+  auto other = shape;
+  other.part = 5;
+  EXPECT_TRUE(ctl.choose(other, cfg, 0.5));
+  EXPECT_EQ(0, ctl.snapshot(other).multiN);
+}
