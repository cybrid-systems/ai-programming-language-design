+// One multi-hop RPC per source partition, and one shared single-hop job for
+// the partitions that chose baseline. All of those jobs are parallel, so the
+// first hop is still one round trip. Returns false when the vids are not
+// INT64 or the space has no partition count; the caller uses the v1 key.
+inline bool fillPerPartJobs(DstWalkState& state,
+                            const std::unordered_set<Value>& vids,
+                            int32_t hops,
+                            int32_t numParts,
+                            const algorithm::AdaptiveShape& shape,
+                            const algorithm::AdaptiveConfig& cfg,
+                            algorithm::AdaptiveController& ctl) {
+  if (numParts <= 0 || vids.empty()) return false;
+  std::map<int32_t, std::vector<Value>> byPart;
+  for (const auto& vid : vids) {
+    if (!vid.isInt()) return false;
+    byPart[algorithm::partOfIntVid(vid.getInt(), numParts)].push_back(vid);
+  }
+  state.perPart = true;
+  state.adaptive = true;
+  state.shape = shape;
+  DstWalkState::Job base;
+  base.hopsLeft = hops;
+  base.allowMulti = true;
+  base.choseMulti = false;
+  base.parallel = true;
+  bool anyBase = false;
+  for (auto& entry : byPart) {
+    auto shapePart = shape;
+    shapePart.part = entry.first;
+    const bool multi = ctl.choose(shapePart, cfg, ctl.nextDraw());
+    DstWalkState::PartObs obs;
+    obs.choseMulti = multi;
+    state.partObs.emplace(entry.first, obs);
+    if (multi) {
+      DstWalkState::Job job;
+      job.vids = std::move(entry.second);
+      job.hopsLeft = hops;
+      job.allowMulti = true;
+      job.choseMulti = true;
+      job.parallel = true;
+      job.parts.push_back(entry.first);
+      state.jobs.push_back(std::move(job));
+    } else {
+      anyBase = true;
+      base.vids.insert(base.vids.end(), entry.second.begin(), entry.second.end());
+      base.parts.push_back(entry.first);
+    }
+  }
+  if (anyBase) {
+    state.jobs.push_back(std::move(base));
+  }
+  return !state.jobs.empty();
+}
