+++ b/src/storage/LocalDstRatioSampler.cpp	2026-10-31 05:58:10.546920068 +0000
@@ -0,0 +1,118 @@
+/* Copyright (c) 2026 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#include "storage/LocalDstRatioSampler.h"
+
+#include <chrono>
+
+#include "common/time/Duration.h"
+#include "common/utils/NebulaKeyUtils.h"
+#include "kvstore/NebulaStore.h"
+
+DEFINE_int32(local_dst_ratio_sample_interval_secs,
+             10,
+             "Seconds between local-dst ratio samples. 0 disables the scan.");
+DEFINE_int32(local_dst_ratio_sample_edges,
+             64,
+             "Maximum edge keys read on one part in one sample pass.");
+DEFINE_int32(local_dst_ratio_sample_parts,
+             32,
+             "Maximum leader parts visited in one sample pass.");
+
+namespace nebula {
+namespace storage {
+
+LocalDstRatioSampler::LocalDstRatioSampler(kvstore::KVStore* store, meta::MetaClient* meta)
+    : store_(store), meta_(meta) {}
+
+LocalDstRatioSampler::~LocalDstRatioSampler() {
+  stop();
+}
+
+void LocalDstRatioSampler::start() {
+  if (FLAGS_local_dst_ratio_sample_interval_secs <= 0) {
+    LOG(INFO) << "local_dst_ratio sampler disabled";
+    return;
+  }
+  stopped_.store(false);
+  thread_ = std::thread([this] { loop(); });
+}
+
+void LocalDstRatioSampler::stop() {
+  stopped_.store(true);
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+}
+
+void LocalDstRatioSampler::loop() {
+  while (!stopped_.load()) {
+    for (int i = 0; i < FLAGS_local_dst_ratio_sample_interval_secs * 10; ++i) {
+      if (stopped_.load()) return;
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+    if (stopped_.load()) return;
+    int64_t edges = 0;
+    int64_t parts = 0;
+    time::Duration clock;
+    auto sample = sampleOnce(&edges, &parts);
+    const auto us = clock.elapsedInUSec();
+    LOG(INFO) << "local_dst_ratio_sample parts=" << parts << " edges=" << edges << " us=" << us
+              << " spaces=" << sample.size();
+    if (meta_ != nullptr) {
+      meta_->publishLocalDstRatio(std::move(sample));
+    }
+  }
+}
+
+meta::MetaClient::LocalDstRatioMap LocalDstRatioSampler::sampleOnce(int64_t* edges,
+                                                                    int64_t* parts) {
+  meta::MetaClient::LocalDstRatioMap out;
+  auto* store = dynamic_cast<kvstore::NebulaStore*>(store_);
+  if (store == nullptr || meta_ == nullptr) return out;
+  std::unordered_map<GraphSpaceID, std::vector<meta::cpp2::LeaderInfo>> leaders;
+  store->allLeader(leaders);
+  const int32_t edgeCap = std::max(1, FLAGS_local_dst_ratio_sample_edges);
+  const int32_t partCap = std::max(1, FLAGS_local_dst_ratio_sample_parts);
+  int32_t visitedParts = 0;
+  for (const auto& spaceEntry : leaders) {
+    if (visitedParts >= partCap) break;
+    const GraphSpaceID spaceId = spaceEntry.first;
+    auto vidLenRet = meta_->getSpaceVidLen(spaceId);
+    auto partsRet = meta_->partsNum(spaceId);
+    if (!vidLenRet.ok() || !partsRet.ok()) continue;
+    const int32_t vidLen = vidLenRet.value();
+    const int32_t numParts = partsRet.value();
+    for (const auto& leader : spaceEntry.second) {
+      if (visitedParts >= partCap) break;
+      const PartitionID partId = leader.get_part_id();
+      if (!store->isLeader(spaceId, partId)) continue;
+      std::unique_ptr<kvstore::KVIterator> iter;
+      auto edgePrefix = NebulaKeyUtils::edgePrefix(partId);
+      auto code = store_->prefix(spaceId, partId, edgePrefix, &iter);
+      if (code != nebula::cpp2::ErrorCode::SUCCEEDED || iter == nullptr) continue;
+      int32_t seen = 0;
+      int32_t local = 0;
+      for (; iter->valid() && seen < edgeCap; iter->next()) {
+        auto key = iter->key();
+        if (!NebulaKeyUtils::isEdge(vidLen, key)) continue;
+        auto dst = NebulaKeyUtils::getDstId(vidLen, key);
+        std::string dstId(dst.data(), dst.size());
+        auto dstPart = meta_->partId(numParts, dstId);
+        ++seen;
+        if (store->isLeader(spaceId, dstPart)) ++local;
+      }
+      ++visitedParts;
+      if (seen == 0) continue;
+      out[spaceId][partId] = static_cast<double>(local) / static_cast<double>(seen);
+      if (edges != nullptr) *edges += seen;
+      if (parts != nullptr) *parts += 1;
+    }
+  }
+  return out;
+}
