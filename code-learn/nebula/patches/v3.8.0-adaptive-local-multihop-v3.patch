+TEST(AdaptiveMultiHopTest, HostBatchSharesALeader) {
+  std::vector<int32_t> parts{1, 2, 3, 4};
+  std::vector<char> multi{1, 1, 1, 0};
+  std::vector<std::string> hosts{"a", "a", "b", "a"};
+  auto grouped = hostBatchGroups(parts, multi, hosts, true);
+  ASSERT_EQ(3, grouped.size());
+  EXPECT_TRUE(grouped[0].multi);
+  EXPECT_EQ(std::vector<int32_t>({1, 2}), grouped[0].parts);
+  EXPECT_TRUE(grouped[1].multi);
+  EXPECT_EQ(std::vector<int32_t>({3}), grouped[1].parts);
+  EXPECT_FALSE(grouped[2].multi);
+  EXPECT_EQ(std::vector<int32_t>({4}), grouped[2].parts);
