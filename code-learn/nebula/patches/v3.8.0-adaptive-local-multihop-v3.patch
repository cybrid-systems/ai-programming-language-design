+#ifndef STORAGE_LOCALDSTRATIOSAMPLER_H_
+#define STORAGE_LOCALDSTRATIOSAMPLER_H_
+
+#include <atomic>
+#include <thread>
+
+#include "clients/meta/MetaClient.h"
+#include "kvstore/NebulaStore.h"
+
+namespace nebula {
+namespace storage {
+
+// Bounded background scan. Each pass reads at most
+// local_dst_ratio_sample_edges edges on each of at most
+// local_dst_ratio_sample_parts leader parts, then publishes the ratio
+// through the meta client's heartbeat provider.
+class LocalDstRatioSampler {
+ public:
+  LocalDstRatioSampler(kvstore::KVStore* store, meta::MetaClient* meta);
+  ~LocalDstRatioSampler();
+
+  void start();
+  void stop();
+
+ private:
+  void loop();
+  meta::MetaClient::LocalDstRatioMap sampleOnce(int64_t* edges, int64_t* parts);
+
+  kvstore::KVStore* store_{nullptr};
+  meta::MetaClient* meta_{nullptr};
+  std::atomic<bool> stopped_{false};
+  std::thread thread_;
+};
+
+}  // namespace storage
+}  // namespace nebula
+
+#endif
