+  auto split = hostBatchGroups(parts, multi, hosts, false);
+  ASSERT_EQ(4, split.size());
+  EXPECT_TRUE(split[0].multi);
+  EXPECT_EQ(std::vector<int32_t>({1}), split[0].parts);
+  EXPECT_TRUE(split[1].multi);
+  EXPECT_EQ(std::vector<int32_t>({2}), split[1].parts);
+  EXPECT_TRUE(split[2].multi);
+  EXPECT_FALSE(split[3].multi);
+}
