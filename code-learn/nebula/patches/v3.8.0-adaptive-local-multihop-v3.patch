+StatusOr<double> MetaClient::localDstRatio(GraphSpaceID spaceId, PartitionID partId) const {
+  folly::SharedMutex::ReadHolder holder(localDstRatioLock_);
+  auto space = localDstRatio_.find(spaceId);
+  if (space == localDstRatio_.end()) {
+    return Status::Error("no local-dst sample");
+  }
+  auto part = space->second.find(partId);
+  if (part == space->second.end()) {
+    return Status::Error("no local-dst sample");
+  }
+  return part->second;
+}
