+// Multihop parts that share a leader host share one RPC when hostBatch is set.
+// An empty host key stays alone. Every baseline part shares one single-hop
+// RPC: that request does not run the guard, so mixing those parts is safe.
+inline std::vector<RpcGroup> hostBatchGroups(const std::vector<int32_t>& parts,
+                                            const std::vector<char>& multi,
+                                            const std::vector<std::string>& hosts,
+                                            bool hostBatch) {
+  std::vector<RpcGroup> out;
+  std::map<std::string, size_t> multiByHost;
+  RpcGroup base;
+  bool anyBase = false;
+  for (size_t i = 0; i < parts.size(); ++i) {
+    const bool isMulti = i < multi.size() && multi[i];
+    if (!isMulti) {
+      anyBase = true;
+      base.parts.push_back(parts[i]);
+      continue;
+    }
+    const std::string host = i < hosts.size() ? hosts[i] : std::string();
+    if (!hostBatch || host.empty()) {
+      RpcGroup one;
+      one.multi = true;
+      one.parts.push_back(parts[i]);
+      out.push_back(std::move(one));
+      continue;
+    }
+    auto it = multiByHost.find(host);
+    if (it == multiByHost.end()) {
+      RpcGroup group;
+      group.multi = true;
+      group.parts.push_back(parts[i]);
+      multiByHost.emplace(host, out.size());
+      out.push_back(std::move(group));
+    } else {
+      out[it->second].parts.push_back(parts[i]);
+    }
+  }
+  if (anyBase) out.push_back(std::move(base));
+  return out;
