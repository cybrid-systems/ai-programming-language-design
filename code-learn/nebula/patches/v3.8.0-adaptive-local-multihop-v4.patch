+// takes one wave per hop, and multihop parts that miss the guard add more
+// waves. Collapse the query to one baseline RPC. All-multihop stays.
+inline void reconcilePartChoices(std::vector<PartDecision>& parts, bool collapseMixed) {
+  if (!collapseMixed) return;
+  bool anyMulti = false;
+  bool anyBase = false;
+  for (const auto& part : parts) {
+    if (part.multi) anyMulti = true;
+    else anyBase = true;
+  }
+  if (!(anyMulti && anyBase)) return;
+  for (auto& part : parts) part.multi = false;
+}
