+  std::vector<PartDecision> oneUnsure{{1, true, true}, {2, true, true}, {3, false, false}};
+  reconcilePartChoices(oneUnsure, true);
+  for (const auto& part : oneUnsure) EXPECT_FALSE(part.multi);
+
+  std::vector<PartDecision> allMulti{{1, true, true}, {2, true, true}};
+  reconcilePartChoices(allMulti, true);
+  EXPECT_TRUE(allMulti[0].multi);
+  EXPECT_TRUE(allMulti[1].multi);
+
+  std::vector<PartDecision> keep{{1, true, true}, {2, false, true}};
+  reconcilePartChoices(keep, false);
+  EXPECT_TRUE(keep[0].multi);
+  EXPECT_FALSE(keep[1].multi);
+}
