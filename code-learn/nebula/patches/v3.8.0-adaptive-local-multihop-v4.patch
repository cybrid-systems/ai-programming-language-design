+TEST(AdaptiveMultiHopTest, ConfidentLowPriorStaysBaselineAfterASample) {
+  AdaptiveController ctl;
+  AdaptiveConfig cfg;
+  cfg.exploreRate = 1;
+  cfg.usePrior = true;
+  cfg.skipConfidentExplore = true;
+  cfg.earlyFlip = true;
+  cfg.priorHigh = 0.8;
+  cfg.priorLow = 0.4;
+  cfg.minLocalRatio = 0.6;
+  auto low = makeAdaptiveShape(1, {1}, 3, false);
+  low.part = 2;
+  EXPECT_FALSE(ctl.choose(low, cfg, 0.0, true, 0.33));
+  ctl.observe(low, cfg, false, 22000, -1, false, 0);
+  // exploreRate is 1, but a confident low sample must not retry multihop.
+  EXPECT_FALSE(ctl.choose(low, cfg, 0.0, true, 0.33));
+
+  auto high = makeAdaptiveShape(1, {1}, 3, false);
+  high.part = 3;
+  EXPECT_TRUE(ctl.choose(high, cfg, 0.0, true, 0.95));
+  ctl.observe(high, cfg, false, 22000, -1, false, 0);
+  EXPECT_TRUE(ctl.choose(high, cfg, 0.0, true, 0.95));
+  ctl.observe(high, cfg, true, 22000, 0.2, true, 1);
+  ctl.observe(high, cfg, true, 22000, 0.2, true, 1);
+  // The high sample wins over the hop-1 streak. Otherwise the streak can
+  // never clear, because the next decision would refuse the walk.
+  EXPECT_TRUE(ctl.choose(high, cfg, 0.0, true, 0.95));
+
+  cfg.exploreRate = 0;
+  auto mid = makeAdaptiveShape(1, {1}, 3, false);
+  mid.part = 4;
+  EXPECT_FALSE(ctl.choose(mid, cfg, 0.0, true, 0.5));
+  ctl.observe(mid, cfg, false, 22000, -1, false, 0);
+  EXPECT_FALSE(ctl.choose(mid, cfg, 0.0, true, 0.5));
+}
