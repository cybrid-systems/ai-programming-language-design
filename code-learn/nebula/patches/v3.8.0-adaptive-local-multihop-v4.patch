+// Algorithm R. drawIn1ToSeen is uniform on [1, seen] after this item is counted.
+// Values outside 1..keep leave an already-full reservoir unchanged.
+inline void reservoirConsider(std::vector<char>& slot,
+                             int32_t& seen,
+                             int32_t& localCount,
+                             bool isLocal,
+                             int32_t keep,
+                             int32_t drawIn1ToSeen) {
