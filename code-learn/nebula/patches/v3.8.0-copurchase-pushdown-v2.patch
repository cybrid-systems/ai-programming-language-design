+// One focus product lives on one partition. `lower` is the number of focus
+// products already observed. `upper` is lower plus focus products whose
+// partition has not reported yet. After every partition reports, upper == lower.
+//
+// threshold is the k-th highest lower bound (the k-th buyer when there are at
+// least k). A buyer with upper < threshold cannot enter the top k: at least k
+// buyers already have a strictly higher confirmed coCount, and coCount is the
+// primary key. purchaseCount and recency cannot repair that. Buyers with
+// upper >= threshold are kept, including every tie at the threshold, so the
+// later full scan can break ties. The kept set contains the true top k.
+struct CoBuyer {
+  int64_t user{0};
+  int32_t lower{0};
+  int32_t upper{0};
+};
+
+inline std::vector<int64_t> pruneCandidates(std::vector<CoBuyer> buyers, int k, int32_t* pruned) {
+  if (pruned != nullptr) *pruned = 0;
+  if (k < 1) k = 1;
+  std::vector<int64_t> keep;
+  if (buyers.empty()) return keep;
+  std::vector<int32_t> lowers;
+  lowers.reserve(buyers.size());
+  for (auto& buyer : buyers) {
+    if (buyer.upper < buyer.lower) buyer.upper = buyer.lower;
+    lowers.push_back(buyer.lower);
+  }
+  int32_t threshold = 0;
+  if (static_cast<int>(lowers.size()) > k) {
+    std::nth_element(
+        lowers.begin(), lowers.begin() + (k - 1), lowers.end(), std::greater<int32_t>());
+    threshold = lowers[static_cast<size_t>(k - 1)];
+  } else {
+    threshold = *std::min_element(lowers.begin(), lowers.end());
+  }
+  keep.reserve(buyers.size());
+  for (const auto& buyer : buyers) {
+    if (buyer.upper >= threshold) {
+      keep.push_back(buyer.user);
+    } else if (pruned != nullptr) {
+      ++(*pruned);
+    }
+  }
+  return keep;
+}
