+  }
+  int32_t pruned = 0;
+  auto kept = pruneCandidates(buyers, 15, &pruned);
+  std::unordered_set<int64_t> keep(kept.begin(), kept.end());
+  auto global = localTopUsers(all, 15);
+  ASSERT_EQ(15, global.size());
+  for (const auto& row : global) {
+    EXPECT_TRUE(keep.count(row.user) != 0) << row.user;
+  }
+  EXPECT_GT(pruned, 0);
+  for (const auto& row : all) {
+    if (keep.count(row.user) == 0) {
+      EXPECT_LT(row.coCount, global.back().coCount);
+    }
+  }
+  // An unfinished partition must not drop a buyer who could still tie.
+  std::vector<CoBuyer> partial = {
+      {1, 3, 3},
+      {2, 3, 3},
+      {3, 1, 3},
+  };
+  auto still = pruneCandidates(partial, 2, nullptr);
+  std::unordered_set<int64_t> stillSet(still.begin(), still.end());
+  EXPECT_TRUE(stillSet.count(3) != 0);
+}
