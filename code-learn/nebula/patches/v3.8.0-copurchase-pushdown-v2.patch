+bool spaceAllowed(const std::string& name) {
+  if (FLAGS_copurchase_spaces.empty()) return true;
+  size_t begin = 0;
+  const std::string& list = FLAGS_copurchase_spaces;
+  while (begin <= list.size()) {
+    auto comma = list.find(',', begin);
+    auto token = list.substr(begin, comma == std::string::npos ? std::string::npos : comma - begin);
+    size_t left = 0;
+    while (left < token.size() && std::isspace(static_cast<unsigned char>(token[left]))) ++left;
+    size_t right = token.size();
+    while (right > left && std::isspace(static_cast<unsigned char>(token[right - 1]))) --right;
+    if (token.substr(left, right - left) == name) return true;
+    if (comma == std::string::npos) break;
+    begin = comma + 1;
+  }
+  return false;
+}
