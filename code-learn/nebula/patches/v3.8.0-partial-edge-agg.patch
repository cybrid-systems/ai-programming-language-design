+#include "parser/Clauses.h"
+
+using nebula::graph::Aggregate;
+using nebula::graph::Expand;
+using nebula::graph::ExpandAll;
+using nebula::graph::Filter;
+using nebula::graph::HashInnerJoin;
+using nebula::graph::PlanNode;
+using nebula::graph::Project;
+
+namespace nebula {
+namespace opt {
+
+std::unique_ptr<OptRule> PushPartialEdgeAggRule::kInstance =
+    std::unique_ptr<PushPartialEdgeAggRule>(new PushPartialEdgeAggRule());
+
+const Pattern& PushPartialEdgeAggRule::pattern() const {
+  static Pattern pattern = Pattern::create(PlanNode::Kind::kAggregate);
+  return pattern;
+}
+
+namespace {
+
+const OptGroupNode* soleNode(const OptGroup* group) {
+  if (group == nullptr || group->groupNodes().size() != 1) {
+    return nullptr;
+  }
+  return group->groupNodes().front();
+}
+
+Expression* columnExpr(const Project* project, const ExpandAll* expand, const std::string& name) {
+  if (project != nullptr && project->columns() != nullptr) {
+    for (auto* col : project->columns()->columns()) {
+      if (col->name() != name && col->alias() != name) {
+        continue;
+      }
+      auto* expr = col->expr();
+      if (expr == nullptr) {
+        continue;
+      }
+      // `uid = $-.uid` is the column itself, not a definition to unfold.
+      if ((expr->kind() == Expression::Kind::kVarProperty ||
+           expr->kind() == Expression::Kind::kInputProperty) &&
+          static_cast<const PropertyExpression*>(expr)->prop() == name) {
+        continue;
+      }
+      return expr;
+    }
+  }
+  if (expand != nullptr && expand->edgeColumns() != nullptr) {
+    for (auto* col : expand->edgeColumns()->columns()) {
+      if ((col->name() == name || col->alias() == name) && col->expr() != nullptr) {
+        return col->expr();
+      }
+    }
+  }
+  return nullptr;
+}
+
+Expression* unfold(Expression* expr, const std::vector<const Project*>& projects, const ExpandAll* expand) {
+  for (int i = 0; i < 8 && expr != nullptr; ++i) {
+    if (expr->kind() != Expression::Kind::kVarProperty &&
+        expr->kind() != Expression::Kind::kInputProperty) {
+      return expr;
+    }
+    auto name = static_cast<PropertyExpression*>(expr)->prop();
+    Expression* next = nullptr;
+    for (auto* project : projects) {
+      next = columnExpr(project, nullptr, name);
+      if (next != nullptr && next != expr) {
+        break;
+      }
+      next = nullptr;
+    }
+    if (next == nullptr) {
+      next = columnExpr(nullptr, expand, name);
+    }
+    if (next == nullptr || next == expr) {
+      return expr;
+    }
+    expr = next;
+  }
+  return expr;
+}
+
+std::string upper(std::string name) {
+  std::transform(name.begin(), name.end(), name.begin(), ::toupper);
+  return name;
+}
+
+bool aggOp(const std::string& name, PartialAggOp* op) {
+  auto n = upper(name);
+  if (n == "SUM") {
+    *op = PartialAggOp::SUM;
+  } else if (n == "COUNT") {
+    *op = PartialAggOp::COUNT;
+  } else if (n == "MIN") {
+    *op = PartialAggOp::MIN;
+  } else if (n == "MAX") {
+    *op = PartialAggOp::MAX;
+  } else {
+    return false;
+  }
+  return true;
+}
+
+struct Scan {
+  const ExpandAll* expandAll{nullptr};
+  const OptGroupNode* expandAllNode{nullptr};
+  // 0-step Expand under ExpandAll. Its input variable is the vid list for a
+  // direct `GO FROM <list>`. That list is planted in the execution context
+  // and is not Start's output.
+  const Expand* pass{nullptr};
+  OptGroup* vidGroup{nullptr};
+  const HashInnerJoin* join{nullptr};
+  std::vector<const Project*> projects;
+  const Expression* extraFilter{nullptr};
+};
+
+bool absorb(const OptGroupNode* node, Scan* scan) {
+  while (node != nullptr) {
+    auto kind = node->node()->kind();
+    if (kind == PlanNode::Kind::kProject) {
+      scan->projects.emplace_back(static_cast<const Project*>(node->node()));
+      if (node->dependencies().size() != 1) {
+        return false;
+      }
+      node = soleNode(node->dependencies()[0]);
+      continue;
+    }
+    if (kind == PlanNode::Kind::kFilter) {
+      auto* filter = static_cast<const Filter*>(node->node());
+      if (scan->extraFilter != nullptr) {
+        return false;
+      }
+      scan->extraFilter = filter->condition();
+      if (node->dependencies().size() != 1) {
+        return false;
+      }
+      node = soleNode(node->dependencies()[0]);
+      continue;
+    }
+    break;
+  }
+  if (node == nullptr) {
+    return false;
+  }
+  if (node->node()->kind() == PlanNode::Kind::kHashInnerJoin) {
+    if (node->dependencies().size() != 2) {
+      return false;
+    }
+    scan->join = static_cast<const HashInnerJoin*>(node->node());
+    scan->vidGroup = node->dependencies()[0];
+    node = soleNode(node->dependencies()[1]);
+    if (node != nullptr && node->node()->kind() == PlanNode::Kind::kFilter) {
+      if (scan->extraFilter != nullptr) {
+        return false;
+      }
+      scan->extraFilter = static_cast<const Filter*>(node->node())->condition();
+      if (node->dependencies().size() != 1) {
+        return false;
+      }
+      node = soleNode(node->dependencies()[0]);
+    }
+  }
+  if (node == nullptr || node->node()->kind() != PlanNode::Kind::kExpandAll) {
+    return false;
+  }
+  scan->expandAllNode = node;
+  scan->expandAll = static_cast<const ExpandAll*>(node->node());
+  if (scan->vidGroup == nullptr) {
+    if (node->dependencies().size() != 1) {
+      return false;
+    }
+    auto* pass = soleNode(node->dependencies()[0]);
+    if (pass == nullptr || pass->node()->kind() != PlanNode::Kind::kExpand) {
+      return false;
+    }
+    if (static_cast<const Expand*>(pass->node())->maxSteps() != 0) {
+      return false;
+    }
+    if (pass->dependencies().size() != 1) {
+      return false;
+    }
+    scan->pass = static_cast<const Expand*>(pass->node());
+    scan->vidGroup = pass->dependencies()[0];
+  }
+  return scan->vidGroup != nullptr;
+}
+
+std::vector<EdgeType> edgeTypesOf(const ExpandAll* expandAll) {
+  std::vector<EdgeType> types = expandAll->edgeTypes();
+  if (!types.empty() || expandAll->edgeProps() == nullptr) {
+    return types;
+  }
+  for (const auto& prop : *expandAll->edgeProps()) {
+    types.emplace_back(prop.get_type());
+  }
+  return types;
+}
