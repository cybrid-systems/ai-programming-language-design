+#ifndef GRAPH_OPTIMIZER_RULE_PUSHPARTIALEDGEAGGRULE_H_
+#define GRAPH_OPTIMIZER_RULE_PUSHPARTIALEDGEAGGRULE_H_
+
+#include "graph/optimizer/OptRule.h"
+
+namespace nebula {
+namespace opt {
+
+// Partial-aggregate a 1-step edge scan that groups by the edge destination.
+//
+//   Aggregate(group by edge._dst, SUM/COUNT/MIN/MAX of edge exprs)
+//     Project* / Filter*
+//       ExpandAll(1, 1)                  or HashInnerJoin(vids, ExpandAll)
+//
+// becomes
+//
+//   Aggregate(merge partials)
+//     Expand(getDstBySrc with PartialEdgeAgg)
+//       <the same vid input>
+//
+// TopN stays above the merge. The group key is the edge dst, which is not
+// partition-aligned, so a per-host TopN would be wrong and is not pushed.
+// AVG, DISTINCT aggregates, multi-step scans, and predicates that still need
+// a column this scan does not return are left unchanged.
+//
+// Requires --enable_partial_edge_agg. The scan sets partial_agg on the
+// response; graphd recomputes from GetNeighbors when that bit is absent.
+class PushPartialEdgeAggRule final : public OptRule {
+ public:
+  const Pattern& pattern() const override;
+
+  bool match(OptContext* ctx, const MatchedResult& matched) const override;
+
+  StatusOr<TransformResult> transform(OptContext* ctx, const MatchedResult& matched) const override;
+
+  std::string toString() const override;
+
+ private:
+  PushPartialEdgeAggRule() {
+    RuleSet::QueryRules().addRule(this);
+  }
+
+  static std::unique_ptr<OptRule> kInstance;
+};
+
+}  // namespace opt
+}  // namespace nebula
+
+#endif  // GRAPH_OPTIMIZER_RULE_PUSHPARTIALEDGEAGGRULE_H_
