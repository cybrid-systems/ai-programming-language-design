+  std::string onlyEdge_;
+};
+
+class EdgePushdown {
+ public:
+  // True when every leaf is deterministic and is an edge key/property, a
+  // constant, or a pure function/arithmetic/logical/relational combination.
+  static bool canPush(const Expression* expr, const std::string& onlyEdge = "") {
+    if (expr == nullptr) {
+      return false;
+    }
+    EdgePushdownVisitor visitor(onlyEdge);
+    const_cast<Expression*>(expr)->accept(&visitor);
+    return visitor.canPush();
+  }
+
+  struct Split {
+    // AND of the conjuncts storage can evaluate. Null when none.
+    Expression* pushable{nullptr};
+    // AND of the conjuncts that must stay on graphd. Null when none.
+    Expression* residual{nullptr};
+  };
+
+  // Split a predicate on AND only. OR/XOR stay intact: if the whole call is
+  // pushable it is one pushable piece, otherwise the whole call is residual.
+  static Split splitAnd(ObjectPool* pool, const Expression* expr) {
+    Split out;
+    if (expr == nullptr || pool == nullptr) {
+      return out;
+    }
+    std::vector<Expression*> pushable;
+    std::vector<Expression*> residual;
+    collect(pool, expr, pushable, residual);
+    out.pushable = combine(pool, pushable);
+    out.residual = combine(pool, residual);
+    return out;
+  }
+
+ private:
+  static void collect(ObjectPool* pool,
+                      const Expression* expr,
+                      std::vector<Expression*>& pushable,
+                      std::vector<Expression*>& residual) {
+    if (expr->kind() == Expression::Kind::kLogicalAnd) {
+      auto* logical = static_cast<const LogicalExpression*>(expr);
+      for (const auto* operand : logical->operands()) {
+        collect(pool, operand, pushable, residual);
+      }
+      return;
+    }
+    auto* cloned = const_cast<Expression*>(expr)->clone();
+    if (canPush(cloned)) {
+      pushable.emplace_back(cloned);
+    } else {
+      residual.emplace_back(cloned);
+    }
+    (void)pool;
+  }
+
+  static Expression* combine(ObjectPool* pool, const std::vector<Expression*>& parts) {
+    Expression* acc = nullptr;
+    for (auto* part : parts) {
+      acc = acc == nullptr ? part : LogicalExpression::makeAnd(pool, acc, part);
+    }
+    return acc;
+  }
+};
