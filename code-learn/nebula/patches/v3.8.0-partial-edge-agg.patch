+folly::Future<Status> ExpandExecutor::partialAgg() {
+  currentStep_++;
+  time::Duration getDstTime;
+  StorageClient* storageClient = qctx_->getStorageClient();
+  StorageClient::CommonRequestParam param(expand_->space(),
+                                          qctx_->rctx()->session()->id(),
+                                          qctx_->plan()->id(),
+                                          qctx_->plan()->isProfileEnabled());
+  std::vector<Value> vids(nextStepVids_.size());
+  std::move(nextStepVids_.begin(), nextStepVids_.end(), vids.begin());
+  partialReqVids_ = vids;
+  std::vector<storage::cpp2::PartialEdgeAgg> aggs;
+  aggs.reserve(expand_->partialAggs().size());
+  for (const auto& agg : expand_->partialAggs()) {
+    if (agg.expr == nullptr) {
+      return Status::Error("partial edge aggregate is missing its expression");
+    }
+    storage::cpp2::PartialEdgeAgg spec;
+    spec.op_ref() = static_cast<storage::cpp2::PartialAggOp>(static_cast<int32_t>(agg.op));
+    spec.expr_ref() = agg.expr->encode();
+    aggs.emplace_back(std::move(spec));
+  }
+  return storageClient
+      ->getDstBySrc(param, std::move(vids), expand_->edgeTypes(), expand_->filter(), &aggs)
+      .via(runner())
+      .ensure([this, getDstTime]() {
+        SCOPED_TIMER(&execTime_);
+        addState("total_rpc_time", getDstTime);
+      })
+      .thenValue([this](StorageRpcResponse<GetDstBySrcResponse>&& resps) {
+        memory::MemoryCheckGuard guard;
+        nextStepVids_.clear();
+        SCOPED_TIMER(&execTime_);
+        auto& hostLatency = resps.hostLatency();
+        for (size_t i = 0; i < hostLatency.size(); ++i) {
+          size_t size = 0u;
+          auto& result = resps.responses()[i];
+          if (result.dsts_ref().has_value()) {
+            size = (*result.dsts_ref()).size();
+          }
+          auto info = util::collectRespProfileData(result.result, hostLatency[i], size);
+          addState(folly::sformat("step{} resp [{}]", currentStep_, i), info);
+        }
+        auto completeness = handleCompleteness(resps, FLAGS_accept_partial_success);
+        if (!completeness.ok()) {
+          return folly::makeFuture<Status>(completeness.status());
+        }
+        bool applied = true;
+        for (const auto& resp : resps.responses()) {
+          // get_partial_agg() is a pointer (null when the field was not
+          // serialized). A set false must not be treated as applied.
+          const bool* bit = resp.get_partial_agg();
+          if (bit == nullptr || !*bit) {
+            applied = false;
+            break;
+          }
+        }
+        if (!applied) {
+          addState("partial_agg_applied", 0);
+          return fallbackPartialAgg();
+        }
+        addState("partial_agg_applied", 1);
+        DataSet ds;
+        ds.colNames = expand_->colNames();
+        for (auto& resp : resps.responses()) {
+          auto* dataset = resp.get_dsts();
+          if (dataset == nullptr) {
+            continue;
+          }
+          for (auto& row : dataset->rows) {
+            if (row.values.size() != ds.colNames.size()) {
+              return folly::makeFuture<Status>(
+                  Status::Error("partial edge aggregate column count does not match the plan"));
+            }
+            ds.rows.emplace_back(std::move(row));
+          }
+        }
+        ResultBuilder builder;
+        builder.state(completeness.value());
+        builder.value(Value(std::move(ds))).iter(Iterator::Kind::kSequential);
+        finish(builder.build());
+        return folly::makeFuture<Status>(Status::OK());
+      });
+}
+
+folly::Future<Status> ExpandExecutor::fallbackPartialAgg() {
+  if (expand_->edgeProps() == nullptr || expand_->edgeProps()->empty()) {
+    return Status::Error(
+        "storaged did not apply partial edge aggregate and the scan has no edge "
+        "props, so graphd cannot recompute the groups");
+  }
+  StorageClient* storageClient = qctx_->getStorageClient();
+  StorageClient::CommonRequestParam param(expand_->space(),
+                                          qctx_->rctx()->session()->id(),
+                                          qctx_->plan()->id(),
+                                          qctx_->plan()->isProfileEnabled());
+  return storageClient
+      ->getNeighbors(param,
+                     {nebula::kVid},
+                     partialReqVids_,
+                     {},
+                     storage::cpp2::EdgeDirection::OUT_EDGE,
+                     nullptr,
+                     nullptr,
+                     expand_->edgeProps(),
+                     nullptr,
+                     false,
+                     false,
+                     std::vector<storage::cpp2::OrderBy>(),
+                     std::numeric_limits<int64_t>::max(),
+                     expand_->filter(),
+                     nullptr)
+      .via(runner())
+      .thenValue([this](RpcResponse&& resp) {
+        memory::MemoryCheckGuard guard;
+        SCOPED_TIMER(&execTime_);
+        addStats(resp);
+        auto completeness = handleCompleteness(resp, FLAGS_accept_partial_success);
+        if (!completeness.ok()) {
+          return folly::makeFuture<Status>(completeness.status());
+        }
+        List list;
+        for (auto& one : resp.responses()) {
+          auto* dataset = one.get_vertices();
+          if (dataset != nullptr) {
+            list.values.emplace_back(std::move(*dataset));
+          }
+        }
+        auto listVal = std::make_shared<Value>(std::move(list));
+        auto iter = std::make_unique<GetNeighborsIter>(listVal);
+        QueryExpressionContext exprCtx(ectx_);
+        const auto& aggs = expand_->partialAggs();
+        std::unordered_map<Value, std::vector<Value>> groups;
+        for (; iter->valid(); iter->next()) {
+          auto dst = iter->getEdgeProp("*", nebula::kDst);
+          if (dst.isNull() || dst.empty()) {
+            continue;
+          }
+          auto& states = groups[dst];
+          if (states.empty()) {
+            states.resize(aggs.size());
+          }
+          for (size_t i = 0; i < aggs.size(); ++i) {
+            applyPartial(aggs[i].op, states[i], aggs[i].expr->eval(exprCtx(iter.get())));
+          }
+        }
+        DataSet ds;
+        ds.colNames = expand_->colNames();
+        ds.rows.reserve(groups.size());
+        for (auto& kv : groups) {
+          Row row;
+          row.values.emplace_back(kv.first);
+          for (auto& state : kv.second) {
+            row.values.emplace_back(std::move(state));
+          }
+          if (row.values.size() != ds.colNames.size()) {
+            return folly::makeFuture<Status>(
+                Status::Error("partial edge aggregate fallback column count mismatch"));
+          }
+          ds.rows.emplace_back(std::move(row));
+        }
+        ResultBuilder builder;
+        builder.state(completeness.value());
+        builder.value(Value(std::move(ds))).iter(Iterator::Kind::kSequential);
+        finish(builder.build());
+        return folly::makeFuture<Status>(Status::OK());
+      });
+}
+
 }  // namespace graph
 }  // namespace nebula
