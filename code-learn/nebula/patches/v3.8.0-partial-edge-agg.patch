+void GetDstBySrcProcessor::mergePartialGroups() {
+  std::unordered_map<Value, std::vector<Value>> groups;
+  for (auto& val : flatResult_) {
+    if (!val.isList()) {
+      continue;
+    }
+    auto& list = val.getList().values;
+    if (list.size() != aggs_.size() + 1) {
+      continue;
+    }
+    auto& states = groups[list[0]];
+    if (states.empty()) {
+      states.assign(list.begin() + 1, list.end());
+      continue;
+    }
+    for (size_t i = 0; i < aggs_.size(); ++i) {
+      mergePartial(aggs_[i].op, states[i], list[i + 1]);
+    }
+  }
+  std::vector<Row> rows;
+  rows.reserve(groups.size());
+  for (auto& kv : groups) {
+    Row row;
+    row.values.reserve(aggs_.size() + 1);
+    row.values.emplace_back(kv.first);
+    for (auto& state : kv.second) {
+      row.values.emplace_back(std::move(state));
+    }
+    rows.emplace_back(std::move(row));
+  }
+  resultDataSet_.rows = std::move(rows);
+}
+
 void GetDstBySrcProcessor::onProcessFinished() {
+  if (!aggs_.empty()) {
+    mergePartialGroups();
+    // Set only after the groups are built. Old graphd never reads this field.
+    resp_.partial_agg_ref() = true;
+    resp_.dsts_ref() = std::move(resultDataSet_);
+    if (profileDetailFlag_) {
+      profileDetail("GetDstBySrcProcessorDedup", 0);
+      profileDetail("GetDstBySrcProcessorTotal", totalDuration_.elapsedInUSec());
+    }
+    return;
+  }
   if (profileDetailFlag_) {
     dedupDuration_.reset();
   }
