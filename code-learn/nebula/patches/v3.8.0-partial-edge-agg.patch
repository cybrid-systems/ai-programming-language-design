+}  // namespace
+
+bool PushPartialEdgeAggRule::match(OptContext* ctx, const MatchedResult& matched) const {
+  if (!FLAGS_enable_partial_edge_agg) {
+    return false;
+  }
+  if (!OptRule::match(ctx, matched)) {
+    return false;
+  }
+  auto* aggNode = matched.node;
+  if (aggNode->dependencies().size() != 1) {
+    return false;
+  }
+  auto* agg = static_cast<const Aggregate*>(aggNode->node());
+  if (agg->groupKeys().size() != 1) {
+    return false;
+  }
+  Scan scan;
+  if (!absorb(soleNode(aggNode->dependencies()[0]), &scan)) {
+    return false;
+  }
+  const auto* expandAll = scan.expandAll;
+  if (expandAll->minSteps() != 1 || expandAll->maxSteps() != 1 || expandAll->sample() ||
+      !expandAll->stepLimits().empty()) {
+    return false;
+  }
+  if (expandAll->edgeProps() == nullptr || expandAll->edgeProps()->empty()) {
+    return false;
+  }
+  if (edgeTypesOf(expandAll).empty()) {
+    return false;
+  }
+  if (scan.join != nullptr) {
+    if (scan.join->probeKeys().size() != 1 || scan.join->hashKeys().size() != 1) {
+      return false;
+    }
+    auto* probe = scan.join->probeKeys()[0];
+    if (probe->kind() != Expression::Kind::kVarProperty &&
+        probe->kind() != Expression::Kind::kInputProperty) {
+      return false;
+    }
+    if (static_cast<const PropertyExpression*>(probe)->prop() != "_expand_vid") {
+      return false;
+    }
+  }
+  auto* groupKey = unfold(agg->groupKeys()[0], scan.projects, expandAll);
+  if (groupKey == nullptr || groupKey->kind() != Expression::Kind::kEdgeDst) {
+    return false;
+  }
+  auto edgeName = static_cast<const PropertyExpression*>(groupKey)->sym();
+  if (edgeName.empty() || edgeName == "*") {
+    return false;
+  }
+  if (scan.extraFilter != nullptr && !graph::EdgePushdown::canPush(scan.extraFilter, edgeName)) {
+    return false;
+  }
+  if (expandAll->filter() != nullptr &&
+      !graph::EdgePushdown::canPush(expandAll->filter(), edgeName)) {
+    return false;
+  }
+  bool sawAgg = false;
+  for (auto* item : agg->groupItems()) {
+    if (item->kind() == Expression::Kind::kAggregate) {
+      auto* call = static_cast<AggregateExpression*>(item);
+      if (call->distinct() || call->arg() == nullptr) {
+        return false;
+      }
+      PartialAggOp op;
+      if (!aggOp(call->name(), &op)) {
+        return false;
+      }
+      auto* arg = unfold(call->arg(), scan.projects, expandAll);
+      if (!graph::EdgePushdown::canPush(arg, edgeName)) {
+        return false;
+      }
+      sawAgg = true;
+      continue;
+    }
+    auto* plain = unfold(item, scan.projects, expandAll);
+    if (plain == nullptr || plain->kind() != Expression::Kind::kEdgeDst ||
+        static_cast<const PropertyExpression*>(plain)->sym() != edgeName) {
+      return false;
+    }
+  }
+  return sawAgg;
+}
+
+StatusOr<OptRule::TransformResult> PushPartialEdgeAggRule::transform(OptContext* ctx,
+                                                                     const MatchedResult& matched) const {
+  auto* aggNode = matched.node;
+  auto* agg = static_cast<const Aggregate*>(aggNode->node());
+  Scan scan;
+  if (!absorb(soleNode(aggNode->dependencies()[0]), &scan)) {
+    return TransformResult::noTransform();
+  }
+  auto* expandAll = scan.expandAll;
+  auto* pool = ctx->qctx()->objPool();
+  auto* groupKey = unfold(agg->groupKeys()[0], scan.projects, expandAll);
+  auto edgeName = static_cast<const PropertyExpression*>(groupKey)->sym();
+
+  Expression* filter = nullptr;
+  if (expandAll->filter() != nullptr) {
+    filter = expandAll->filter()->clone();
+  }
+  if (scan.extraFilter != nullptr) {
+    auto* extra = const_cast<Expression*>(scan.extraFilter)->clone();
+    filter = filter == nullptr ? extra : LogicalExpression::makeAnd(pool, filter, extra);
+  }
+
+  std::vector<PartialAggExpr> partials;
+  std::vector<Expression*> mergeItems;
+  partials.reserve(agg->groupItems().size());
+  mergeItems.reserve(agg->groupItems().size());
+  for (auto* item : agg->groupItems()) {
+    if (item->kind() != Expression::Kind::kAggregate) {
+      mergeItems.emplace_back(VariablePropertyExpression::make(pool, "", "_dst"));
+      continue;
+    }
+    auto* call = static_cast<AggregateExpression*>(item);
+    PartialAggOp op;
+    aggOp(call->name(), &op);
+    auto* arg = unfold(call->arg(), scan.projects, expandAll)->clone();
+    auto col = folly::stringPrintf("_pa%zu", partials.size());
+    partials.push_back(PartialAggExpr{op, arg});
+    mergeItems.emplace_back(AggregateExpression::make(
+        pool, partialMergeName(op), VariablePropertyExpression::make(pool, "", col), false));
+  }
+
+  auto edgeProps = std::make_unique<std::vector<storage::cpp2::EdgeProp>>(*expandAll->edgeProps());
+  auto* expand = Expand::make(ctx->qctx(), nullptr, expandAll->space(), false, 1, std::move(edgeProps));
+  expand->setEdgeTypes(edgeTypesOf(expandAll));
+  expand->setFilter(filter);
+  expand->setPartialAggs(std::move(partials));
+  std::vector<std::string> outCols{"_dst"};
+  for (size_t i = 0; i < expand->partialAggs().size(); ++i) {
+    outCols.emplace_back(folly::stringPrintf("_pa%zu", i));
+  }
+  expand->setColNames(std::move(outCols));
+
+  OptGroup* vidGroup = scan.vidGroup;
+  if (scan.join != nullptr) {
+    auto* hashKey = scan.join->hashKeys()[0];
+    std::string vidCol;
+    if (hashKey->kind() == Expression::Kind::kVarProperty ||
+        hashKey->kind() == Expression::Kind::kInputProperty) {
+      vidCol = static_cast<const PropertyExpression*>(hashKey)->prop();
+    }
+    const auto* leftNode = soleNode(vidGroup);
+    bool firstIsVid = leftNode != nullptr && !leftNode->node()->colNames().empty() &&
+                      leftNode->node()->colNames()[0] == vidCol;
+    if (!vidCol.empty() && !firstIsVid) {
+      auto* cols = pool->makeAndAdd<YieldColumns>();
+      cols->addColumn(new YieldColumn(InputPropertyExpression::make(pool, vidCol), vidCol));
+      auto* project = Project::make(ctx->qctx(), nullptr, cols);
+      project->setColNames({vidCol});
+      project->setInputVar(vidGroup->outputVar());
+      auto* projectGroup = OptGroup::create(ctx);
+      auto* projectNode = projectGroup->makeGroupNode(project);
+      projectNode->dependsOn(vidGroup);
+      vidGroup = projectGroup;
+    }
+  }
+  if (scan.join == nullptr && scan.pass != nullptr && !scan.pass->inputVar().empty()) {
+    // Keep the variable buildConstantInput already filled. Start's own output
+    // is empty, so pointing the scan at it drops every source vertex.
+    expand->setInputVar(scan.pass->inputVar());
+  } else {
+    expand->setInputVar(vidGroup->outputVar());
+  }
+  auto* expandGroup = OptGroup::create(ctx);
+  auto* expandGN = expandGroup->makeGroupNode(expand);
+  expandGN->dependsOn(vidGroup);
+
+  std::vector<Expression*> mergeKeys;
+  mergeKeys.emplace_back(VariablePropertyExpression::make(pool, "", "_dst"));
+  auto* merged = Aggregate::make(ctx->qctx(), nullptr, std::move(mergeKeys), std::move(mergeItems));
+  merged->setOutputVar(agg->outputVar());
+  merged->setColNames(agg->colNames());
+  merged->setInputVar(expand->outputVar());
+  auto* mergedGN = OptGroupNode::create(ctx, merged, aggNode->group());
+  mergedGN->dependsOn(expandGroup);
+
+  TransformResult result;
+  result.eraseAll = true;
+  result.newGroupNodes.emplace_back(mergedGN);
+  return result;
+}
+
+std::string PushPartialEdgeAggRule::toString() const {
+  return "PushPartialEdgeAggRule";
+}
