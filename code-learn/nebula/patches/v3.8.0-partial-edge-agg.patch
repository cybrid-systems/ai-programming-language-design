diff --git a/src/common/function/PartialAgg.h b/src/common/function/PartialAgg.h
index e69de29..cd6f8b0 100644
--- a/src/common/function/PartialAgg.h
+++ b/src/common/function/PartialAgg.h
@@ -0,0 +1,136 @@
+/* Copyright (c) 2026 vesoft inc. All rights reserved.
+ *
+ * This source code is licensed under Apache 2.0 License.
+ */
+
+#ifndef COMMON_FUNCTION_PARTIALAGG_H_
+#define COMMON_FUNCTION_PARTIALAGG_H_
+
+#include "common/datatypes/Value.h"
+
+namespace nebula {
+
+class Expression;
+
+// Decomposable aggregate ops. AVG is not here: it is sum+count, divided after
+// the final merge. The numeric values match storage.thrift PartialAggOp.
+enum class PartialAggOp : int8_t { SUM = 1, COUNT = 2, MIN = 3, MAX = 4 };
+
+// One aggregate argument evaluated per edge that passed the filter.
+// `expr` is not owned.
+struct PartialAggExpr {
+  PartialAggOp op{PartialAggOp::SUM};
+  Expression* expr{nullptr};
+};
+
+// Same null/empty/bad-type rules as AggFunctionManager's SUM/COUNT/MIN/MAX.
+// A default-constructed Value is __EMPTY__, not null. That is the state of a
+// group that has not seen a row yet. EMPTY + x stays EMPTY, and x < EMPTY is
+// false, so SUM/COUNT/MIN would stick at empty while MAX (x > EMPTY) would
+// look fine. Treat empty like null: uninitialized.
+// SUM and COUNT turn that into 0 on the first applied row, then skip null and
+// empty inputs. MIN/MAX stay null until the first comparable value.
+inline bool partialUninitialized(const Value& state) {
+  return state.isNull() || state.empty();
+}
+
+inline void applyPartial(PartialAggOp op, Value& state, const Value& val) {
+  if (state.isBadNull()) {
+    return;
+  }
+  switch (op) {
+    case PartialAggOp::COUNT: {
+      if (partialUninitialized(state)) {
+        state = 0;
+      }
+      if (val.isNull() || val.empty()) {
+        return;
+      }
+      state = state + 1;
+      return;
+    }
+    case PartialAggOp::SUM: {
+      if (partialUninitialized(state)) {
+        state = 0;
+      }
+      if (!val.isNull() && !val.empty() && !val.isNumeric()) {
+        state = Value::kNullBadType;
+        return;
+      }
+      if (val.isNull() || val.empty()) {
+        return;
+      }
+      state = state + val;
+      return;
+    }
+    case PartialAggOp::MIN:
+    case PartialAggOp::MAX: {
+      if (val.isNull() || val.empty()) {
+        return;
+      }
+      if (partialUninitialized(state)) {
+        state = val;
+        return;
+      }
+      if (op == PartialAggOp::MIN) {
+        if (val < state) {
+          state = val;
+        }
+      } else if (val > state) {
+        state = val;
+      }
+      return;
+    }
+  }
+}
+
+// Combine two partial states. SUM/COUNT add. MIN/MAX take the more extreme
+// value and ignore a null partial (that partition had no comparable input).
+inline void mergePartial(PartialAggOp op, Value& state, const Value& partial) {
+  if (state.isBadNull() || partial.isBadNull()) {
+    state = Value::kNullBadType;
+    return;
+  }
+  if (op == PartialAggOp::SUM || op == PartialAggOp::COUNT) {
+    if (partial.isNull() || partial.empty()) {
+      return;
+    }
+    if (!partial.isNumeric() || (!partialUninitialized(state) && !state.isNumeric())) {
+      state = Value::kNullBadType;
+      return;
+    }
+    if (partialUninitialized(state)) {
+      state = partial;
+      return;
+    }
+    state = state + partial;
+    return;
+  }
+  applyPartial(op, state, partial);
+}
+
+inline const char* partialAggName(PartialAggOp op) {
+  switch (op) {
+    case PartialAggOp::SUM:
+      return "SUM";
+    case PartialAggOp::COUNT:
+      return "COUNT";
+    case PartialAggOp::MIN:
+      return "MIN";
+    case PartialAggOp::MAX:
+      return "MAX";
+  }
+  return "SUM";
+}
+
+// COUNT's final merge is a SUM of partial counts. MIN/MAX/SUM merge as themselves.
+inline const char* partialMergeName(PartialAggOp op) {
+  if (op == PartialAggOp::COUNT) {
+    return "SUM";
+  }
+  return partialAggName(op);
+}
+
+}  // namespace nebula
+
+#endif  // COMMON_FUNCTION_PARTIALAGG_H_
