+namespace nebula {
+namespace graph {
+
+// Expressions storage can evaluate while scanning one edge, using only that
+// edge's key and value. Non-deterministic calls (now(), timestamp(), rand())
+// stay on graphd: each storaged would otherwise call them independently.
+// NULL and non-bool filter results are false, matching FilterNode::checkTagAndEdge.
+class EdgePushdownVisitor final : public ExprVisitorImpl {
+ public:
+  explicit EdgePushdownVisitor(std::string onlyEdge = "") : onlyEdge_(std::move(onlyEdge)) {}
+
+  bool canPush() const {
+    return !rejected_;
+  }
+
+  void visit(UnaryExpression* expr) override {
+    auto kind = expr->kind();
+    if (kind == Expression::Kind::kUnaryIncr || kind == Expression::Kind::kUnaryDecr) {
+      rejected_ = true;
+      return;
+    }
+    ExprVisitorImpl::visit(expr);
+  }
+
+  void visit(FunctionCallExpression* expr) override {
+    auto pure = FunctionManager::getIsPure(expr->name(), expr->args()->numArgs());
+    if (!pure.ok() || !pure.value()) {
+      rejected_ = true;
+      return;
+    }
+    ExprVisitorImpl::visit(expr);
+  }
+
+  void visit(SubscriptExpression*) override {
+    rejected_ = true;
+  }
+  void visit(AttributeExpression*) override {
+    rejected_ = true;
+  }
+  void visit(LabelAttributeExpression*) override {
+    rejected_ = true;
+  }
+  void visit(LabelExpression*) override {
+    rejected_ = true;
+  }
+  void visit(UUIDExpression*) override {
