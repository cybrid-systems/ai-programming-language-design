diff --git a/tests/copurchase_pushdown_test.py b/tests/copurchase_pushdown_test.py
new file mode 100644
index 0000000..49686ae
--- /dev/null
+++ b/tests/copurchase_pushdown_test.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Manual integration test for the co-purchase pushdown prototype.
+
+Start a single-node metad/storaged/graphd, then run:
+
+    python3 tests/copurchase_pushdown_test.py
+
+It loads a 4-buyer / 5-item graph and checks the target nGQL query. The
+expected scores are a=2, b=3, c=3, d=1 (the seed product p is excluded).
+"""
+
+from __future__ import annotations
+
+import ssl
+import time
+
+# nebula3-python 3.8 references this constant at import time; Python 3.14
+# removed it.
+if not hasattr(ssl, "PROTOCOL_TLSv1"):
+    ssl.PROTOCOL_TLSv1 = ssl.PROTOCOL_TLS_CLIENT
+
+from nebula3.Config import Config  # noqa: E402
+from nebula3.gclient.net import ConnectionPool  # noqa: E402
+
+QUERY = (
+    'GO FROM "p" OVER buy REVERSELY YIELD DISTINCT src(edge) AS uid '
+    '| GO FROM $-.uid OVER buy WHERE dst(edge) != "p" YIELD dst(edge) AS item '
+    "| GROUP BY $-.item YIELD $-.item AS rec_item, COUNT(1) AS score "
+    "| ORDER BY $-.score DESC | LIMIT 20"
+)
+
+EDGES = [
+    ("u1", "p"), ("u1", "a"), ("u1", "b"), ("u1", "c"),
+    ("u2", "p"), ("u2", "a"), ("u2", "b"),
+    ("u3", "p"), ("u3", "b"), ("u3", "c"),
+    ("u4", "p"), ("u4", "c"), ("u4", "d"),
+]
+
+
+def main() -> int:
+    pool = ConnectionPool()
+    if not pool.init([("127.0.0.1", 9669)], Config()):
+        raise SystemExit("cannot connect to graphd at 127.0.0.1:9669")
+    session = pool.get_session("root", "nebula")
+
+    def run(stmt: str):
+        result = session.execute(stmt)
+        if not result.is_succeeded():
+            raise SystemExit(f"FAILED: {stmt}\n{result.error_msg()}")
+        return result
+
+    add = session.execute("ADD HOSTS 127.0.0.1:9779")
+    if not add.is_succeeded() and "Existed" not in add.error_msg():
+        raise SystemExit("FAILED: ADD HOSTS: " + add.error_msg())
+    time.sleep(8)
+    run("CREATE SPACE IF NOT EXISTS copurchase (partition_num=3, replica_factor=1, "
+        "vid_type=FIXED_STRING(32))")
+    for _ in range(12):
+        use = session.execute("USE copurchase")
+        if use.is_succeeded():
+            break
+        time.sleep(2)
+    else:
+        raise SystemExit("FAILED: space copurchase did not become ready")
+    run("CREATE EDGE IF NOT EXISTS buy()")
+    time.sleep(10)
+    values = ",".join(f'"{a}"->"{b}":()' for a, b in EDGES)
+    run(f"INSERT EDGE buy() VALUES {values}")
+    time.sleep(2)
+
+    rows = run(QUERY).rows()
+    got = {row.values[0].get_sVal().decode(): row.values[1].get_iVal() for row in rows}
+    expected = {"a": 2, "b": 3, "c": 3, "d": 1}
+    print("got:     ", got)
+    print("expected:", expected)
+    session.release()
+    pool.close()
+    if got != expected:
+        print("FAIL")
+        return 1
+    print("PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
