 #include "graph/planner/plan/Query.h"
 
 namespace nebula {
 namespace graph {
 
+AggregateExecutor::AggregateExecutor(const PlanNode* node, QueryContext* qctx)
+    : Executor("AggregateExecutor", node, qctx) {
+  auto* agg = asNode<Aggregate>(node);
+  if (agg == nullptr || agg->groupKeys().size() != 1) {
+    return;
+  }
+
+  bool hasCount = false;
+  for (size_t i = 0; i < agg->groupItems().size(); ++i) {
+    auto* item = agg->groupItems()[i];
+    if (item->kind() != Expression::Kind::kAggregate) {
+      continue;
+    }
+    auto str = item->toString();
+    std::transform(str.begin(), str.end(), str.begin(), ::toupper);
+    if (str.rfind("COUNT(", 0) == 0 && str.find("DISTINCT") == std::string::npos) {
+      countItemIdx_ = i;
+      hasCount = true;
+      break;
+    }
+  }
+  if (!hasCount) {
+    return;
+  }
+
+  // The aggregate's input may be a Filter (the query's WHERE) directly on the
+  // second hop. Only that hop is rewritten; anything else keeps the normal
+  // COUNT-over-rows path.
+  if (agg->numDeps() != 1) {
+    return;
+  }
+  const PlanNode* in = agg->dep(0);
+  while (in != nullptr && in->numDeps() == 1 &&
+         (in->kind() == PlanNode::Kind::kFilter || in->kind() == PlanNode::Kind::kProject ||
+          in->kind() == PlanNode::Kind::kDataCollect)) {
+    in = in->dep(0);
+  }
+  HashInnerJoin* join = nullptr;
+  if (in != nullptr && in->kind() == PlanNode::Kind::kHashInnerJoin) {
+    join = const_cast<HashInnerJoin*>(static_cast<const HashInnerJoin*>(in));
+    in = join->right();
+    while (in != nullptr && in->numDeps() == 1 &&
+           (in->kind() == PlanNode::Kind::kFilter || in->kind() == PlanNode::Kind::kProject ||
+            in->kind() == PlanNode::Kind::kDataCollect)) {
+      in = in->dep(0);
+    }
+  }
+  if (in != nullptr && in->kind() == PlanNode::Kind::kExpandAll) {
+    auto* ea = const_cast<ExpandAll*>(static_cast<const ExpandAll*>(in));
+    ea->setGroupByDst(true);
+    if (join != nullptr) {
+      join->setPassThroughRight(true);
+    }
+    pushdown_ = true;
+    LOG(INFO) << "co-purchase pushdown: ExpandAll " << ea->id()
+              << " returns (item, partial_count)";
+    return;
+  }
+  if (in == nullptr || in->kind() != PlanNode::Kind::kGetNeighbors) {
+    return;
+  }
+  auto* gn = const_cast<GetNeighbors*>(static_cast<const GetNeighbors*>(in));
+  if (gn->edgeDirection() != Direction::OUT_EDGE || gn->edgeTypes().size() != 1) {
+    return;
+  }
+  if (gn->edgeProps() != nullptr && !gn->edgeProps()->empty()) {
+    return;
+  }
+  gn->setGroupByDst(true);
+  if (join != nullptr) {
+    join->setPassThroughRight(true);
+  }
+  pushdown_ = true;
+  LOG(INFO) << "co-purchase pushdown: GetNeighbors node " << gn->id()
+            << " returns (item, partial_count)";
+}
