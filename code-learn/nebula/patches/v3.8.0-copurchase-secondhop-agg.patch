+// Co-purchase pushdown: consume the edge iterator for every input buyer and
+// count occurrences of each destination vertex. The map is owned by the
+// processor and flushed once after all parts/vertices have been traversed.
+class GroupByDstNode final : public QueryNode<VertexID> {
+ public:
+  using RelNode::doExecute;
+
+  GroupByDstNode(RuntimeContext* context,
+                 IterateNode<VertexID>* upstream,
+                 std::unordered_map<std::string, int64_t>* counts)
+      : context_(context), upstream_(upstream), counts_(counts) {
+    name_ = "GroupByDstNode";
+  }
+
+  nebula::cpp2::ErrorCode doExecute(PartitionID partId, const VertexID& vId) override {
+    auto ret = RelNode::doExecute(partId, vId);
+    if (ret != nebula::cpp2::ErrorCode::SUCCEEDED) {
+      return ret;
+    }
+    for (; upstream_->valid(); upstream_->next()) {
+      if (context_->isPlanKilled()) {
+        return nebula::cpp2::ErrorCode::E_PLAN_IS_KILLED;
+      }
+      auto dst = NebulaKeyUtils::getDstId(context_->vIdLen(), upstream_->key());
+      ++(*counts_)[std::string(dst.data(), dst.size())];
+    }
+    return nebula::cpp2::ErrorCode::SUCCEEDED;
+  }
+
+  // Emit one row per destination. The count is the number of traversed edges
+  // pointing at it (no dedup), matching COUNT(1) over the second hop.
+  void flush(nebula::DataSet* ds, bool isIntId) {
+    ds->rows.clear();
+    ds->colNames = {"_group_item", "_group_count"};
+    ds->rows.reserve(counts_->size());
+    for (const auto& [key, count] : *counts_) {
+      Row row;
+      if (isIntId) {
+        row.values.emplace_back(*reinterpret_cast<const int64_t*>(key.data()));
+      } else {
+        // Fixed-string VIDs are right-padded with NULs in the KV key; return
+        // the same unpadded form the normal GetNeighbors path yields.
+        std::string item = key;
+        while (!item.empty() && item.back() == '\0') {
+          item.pop_back();
+        }
+        row.values.emplace_back(Value(item));
+      }
+      row.values.emplace_back(static_cast<int64_t>(count));
+      ds->rows.emplace_back(std::move(row));
+    }
+  }
+
+ private:
+  RuntimeContext* context_{nullptr};
+  IterateNode<VertexID>* upstream_{nullptr};
+  std::unordered_map<std::string, int64_t>* counts_{nullptr};
+};
+
+}  // namespace storage
+}  // namespace nebula
+
+#endif  // STORAGE_EXEC_GROUPBYDSTNODE_H_
