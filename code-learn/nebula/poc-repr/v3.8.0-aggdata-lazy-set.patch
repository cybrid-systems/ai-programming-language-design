diff --git a/src/common/function/AggFunctionManager.h b/src/common/function/AggFunctionManager.h
--- a/src/common/function/AggFunctionManager.h
+++ b/src/common/function/AggFunctionManager.h
@@ -21,11 +21,12 @@
 
 class AggData final {
  public:
+  // The set is only read when AggregateExpression::distinct_ is true
+  // (COUNT/SUM/... DISTINCT). COLLECT and COLLECT_SET store their collection
+  // in result_, not here. Leave uniques_ empty until ensureUniques().
   explicit AggData(Set* uniques = nullptr)
       : cnt_(0), sum_(0.0), avg_(0.0), deviation_(0.0), result_(Value::kNullValue) {
-    if (uniques == nullptr) {
-      uniques_ = std::make_unique<Set>();
-    } else {
+    if (uniques != nullptr) {
       uniques_.reset(uniques);
     }
   }
@@ -102,6 +103,13 @@
     return uniques_.get();
   }
 
+  Set* ensureUniques() {
+    if (uniques_ == nullptr) {
+      uniques_ = std::make_unique<Set>();
+    }
+    return uniques_.get();
+  }
+
   void setUniques(Set* uniques) {
     uniques_.reset(uniques);
   }
