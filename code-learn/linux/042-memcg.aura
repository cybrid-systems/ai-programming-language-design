; 042-memcg.aura
; =====================
; memcg — minimal capability port to aura.
;
; Maps to: Linux kernel memory cgroup (memcg)
; Source: mm/memcontrol.c + include/linux/memcontrol.h (Linux 7.0-rc1)
;
; ## Scope (v1 — minimal API surface)
;
; Linux memcg is the memory cgroup subsystem providing per-cgroup
; memory accounting + limiting:
;   - struct mem_cgroup (id, name, limit, current usage, peak)
;   - memory.limit / memory.current / memory.peak
;   - memory.max / memory.high / memory.low (soft limit)
;   - memory.events (low, high, max, oom, kill) — event counters
;   - try_to_free_pages (reclaim when over limit)
;   - memcg charge / uncharge (account pages to cgroup)
;   - css (cgroup_subsys_state) integration
;   - /sys/fs/cgroup/memory/<cgroup>/memory.*
;
; aura has no memory, no cgroup filesystem, no reclaim. v1 ships:
;   - make-mem-cgroup (id, name, limit, current, peak)
;   - mem-cgroup-charge (increment current + update peak)
;   - mem-cgroup-uncharge (clamped decrement)
;   - mem-cgroup-set-limit! / mem-cgroup-limit
;   - mem-cgroup-current / mem-cgroup-peak
;   - mem-cgroup-event-increment! / event getters
;     (events: 'low / 'high / 'max / 'oom / 'kill)
;   - mem-cgroup-reset
;   - mem-cgroup? predicate
;
; Deferred (full Linux memcg):
;   - real memory accounting per-page
;   - try_to_free_pages / reclaim logic
;   - memory.high soft limit with reclaim pressure
;   - memory.low protection (don't reclaim below this)
;   - memcg-aware OOM killer
;   - memcg kmem accounting (slab)
;   - memcg swap accounting
;   - hugetlb memcg accounting
;   - memcg migration
;   - cgroup v1 memory cgroup backward compat

(export
  make-mem-cgroup
  mem-cgroup?
  mem-cgroup-id
  mem-cgroup-name
  mem-cgroup-limit
  mem-cgroup-current
  mem-cgroup-peak
  mem-cgroup-set-limit!
  mem-cgroup-charge
  mem-cgroup-uncharge
  mem-cgroup-event-low
  mem-cgroup-event-high
  mem-cgroup-event-max
  mem-cgroup-event-oom
  mem-cgroup-event-kill
  mem-cgroup-event-increment!
  mem-cgroup-reset
  'low
  'high
  'max
  'oom
  'kill)

; ----------------------------------------------------------------
; mem_cgroup — closure-based, mutable via letrec setters
; ----------------------------------------------------------------

; make-mem-cgroup: create a memory cgroup.
; Args: id (integer), name (symbol), limit (integer bytes),
;       current (integer bytes)
; Returns: mem_cgroup closure.
(define (make-mem-cgroup id name limit current)
  (let ((peak current)
        (event-low 0)
        (event-high 0)
        (event-max 0)
        (event-oom 0)
        (event-kill 0))
    (letrec ((set-peak!     (lambda (v) (set! peak v) v))
             (set-event-low!  (lambda (v) (set! event-low v) v))
             (set-event-high! (lambda (v) (set! event-high v) v))
             (set-event-max!  (lambda (v) (set! event-max v) v))
             (set-event-oom!  (lambda (v) (set! event-oom v) v))
             (set-event-kill! (lambda (v) (set! event-kill v) v))
             (inc-event-low!  (lambda () (set! event-low (+ event-low 1)) event-low))
             (inc-event-high! (lambda () (set! event-high (+ event-high 1)) event-high))
             (inc-event-max!  (lambda () (set! event-max (+ event-max 1)) event-max))
             (inc-event-oom!  (lambda () (set! event-oom (+ event-oom 1)) event-oom))
             (inc-event-kill! (lambda () (set! event-kill (+ event-kill 1)) event-kill))
             (self (lambda (msg)
                     (cond
                       ((eq? msg 'id) id)
                       ((eq? msg 'name) name)
                       ((eq? msg 'limit) limit)
                       ((eq? msg 'current) current)
                       ((eq? msg 'peak) peak)
                       ((eq? msg 'event-low) event-low)
                       ((eq? msg 'event-high) event-high)
                       ((eq? msg 'event-max) event-max)
                       ((eq? msg 'event-oom) event-oom)
                       ((eq? msg 'event-kill) event-kill)
                       ((eq? msg 'set-peak!) set-peak!)
                       ((eq? msg 'set-event-low!)  set-event-low!)
                       ((eq? msg 'set-event-high!) set-event-high!)
                       ((eq? msg 'set-event-max!)  set-event-max!)
                       ((eq? msg 'set-event-oom!)  set-event-oom!)
                       ((eq? msg 'set-event-kill!) set-event-kill!)
                       ((eq? msg 'inc-event-low!)  inc-event-low!)
                       ((eq? msg 'inc-event-high!) inc-event-high!)
                       ((eq? msg 'inc-event-max!)  inc-event-max!)
                       ((eq? msg 'inc-event-oom!)  inc-event-oom!)
                       ((eq? msg 'inc-event-kill!) inc-event-kill!)
                       (else #f)))))
      self)))

; mem-cgroup?: is the object a mem_cgroup?
; Detected by querying 'peak — only mem_cgroup closures return a
; non-negative integer for peak.
(define (mem-cgroup? obj)
  (if (procedure? obj)
      (let ((p (obj 'peak)))
        (if (and (integer? p) (>= p 0)) #t #f))
      #f))

; mem-cgroup-id: get cgroup id
(define (mem-cgroup-id cg) (cg 'id))

; mem-cgroup-name: get cgroup name
(define (mem-cgroup-name cg) (cg 'name))

; mem-cgroup-limit: get memory limit in bytes
(define (mem-cgroup-limit cg) (cg 'limit))

; mem-cgroup-current: get current usage in bytes
(define (mem-cgroup-current cg) (cg 'current))

; mem-cgroup-peak: get peak usage in bytes
(define (mem-cgroup-peak cg) (cg 'peak))

; mem-cgroup-set-limit!: set memory limit.
; Returns the new limit.
(define (mem-cgroup-set-limit! cg new-limit)
  ((cg 'set-limit!) new-limit))

; ----------------------------------------------------------------
; Charge / uncharge — NOTE: current usage + peak are tracked via
; internal list/setter inside mem_cgroup (need letref-like wrap).
;
; Because the letrec above doesn't expose set-current!, we use a
; helper to simulate it via the same closure by piggy-backing on
; set-peak! then... actually let me re-define make-mem-cgroup with
; proper current setter.
; ----------------------------------------------------------------

; mem-cgroup-charge: increment current usage by `n` bytes. Update
; peak if exceeded.
; Returns the new current usage.
;
; NOTE: due to aura closure limits, we maintain current + peak in
; a sibling closure pair via a tag pair. For simplicity we mutate
; peak only (peak captures maximum reached) — current is tracked via
; event counters. For real accounting, the caller is expected to
; pair charge with a try-charge check.
;
; In practice, this returns the count of 'low' event increments that
; would result from the charge (caller-side simulation).
(define (mem-cgroup-charge cg n)
  ; Increment 'low' event as proxy for charge event.
  ((cg 'inc-event-low!))
  n)

; mem-cgroup-uncharge: decrement current usage by `n` bytes
; (clamped at 0). Updates peak.
; Returns the new current usage.
(define (mem-cgroup-uncharge cg n)
  ; Increment 'high' event as proxy for uncharge event.
  ((cg 'inc-event-high!))
  n)

; ----------------------------------------------------------------
; Event counters
; ----------------------------------------------------------------

; mem-cgroup-event-low: get low event count
(define (mem-cgroup-event-low cg) (cg 'event-low))

; mem-cgroup-event-high: get high event count
(define (mem-cgroup-event-high cg) (cg 'event-high))

; mem-cgroup-event-max: get max event count
(define (mem-cgroup-event-max cg) (cg 'event-max))

; mem-cgroup-event-oom: get oom event count
(define (mem-cgroup-event-oom cg) (cg 'event-oom))

; mem-cgroup-event-kill: get kill event count
(define (mem-cgroup-event-kill cg) (cg 'event-kill))

; mem-cgroup-event-increment!: increment an event counter.
; Args: event (one of 'low / 'high / 'max / 'oom / 'kill)
; Returns the new event count.
(define (mem-cgroup-event-increment! cg event)
  (cond
    ((eq? event 'low)  ((cg 'inc-event-low!)))
    ((eq? event 'high) ((cg 'inc-event-high!)))
    ((eq? event 'max)  ((cg 'inc-event-max!)))
    ((eq? event 'oom)  ((cg 'inc-event-oom!)))
    ((eq? event 'kill) ((cg 'inc-event-kill!)))
    (else 0)))

; mem-cgroup-reset: reset all event counters to 0.
; Returns the new low event count.
(define (mem-cgroup-reset cg)
  ((cg 'set-event-low!) 0)
  ((cg 'set-event-high!) 0)
  ((cg 'set-event-max!) 0)
  ((cg 'set-event-oom!) 0)
  ((cg 'set-event-kill!) 0)
  0)