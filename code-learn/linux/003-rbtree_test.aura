; 003-rbtree_test.aura
; =====================
; Minimal smoke tests for 003-rbtree.aura — Red-Black Tree (Linux rbtree).
;
; Run:
;   cd ~/code/aura
;   AURA_PATH="/home/dev/code/ai-programming-language-design/code-learn/linux:$AURA_PATH" \
;     ./build/aura --load /home/dev/code/ai-programming-language-design/code-learn/linux/003-rbtree_test.aura
;
; ## Test framework quirks (#3235 follow-up)
;
; Each suite is one (check (= EXPR EXPECTED)) form using numeric equality.
;
; ## Why so minimal
;
; The shipped v1 rbtree implementation includes:
;   - rb_node / rb_root construction
;   - rb-link-node! (manual link via setter closure)
;   - rb-count-nodes, rb-for-each, rb-first/last/next
;
; Full rbtree requires rb-insert-color! (with rotations + 3 cases of
; rebalancing) to actually build multi-node trees. rb-link-node-root!
; alone always replaces the root, so multi-link smoke tests would only
; verify root-replacement, not actual tree building.
;
; Verified automatically (minimal):
;   - make-rb-node / make-rb-root construction
;   - Color field (RB-RED default, mutable via 'set-color!)
;   - rb-link-node-root! (single root link)
;   - rb-count-nodes = 1 after single link
;   - Root color is mutable
;
; Verified via separate probes during development:
;   - rb-rotate-left! / rb-rotate-right! (parent/child pointers swap)
;   - rb-insert-color! (3 cases — color flip + rotations)
;   - All 5 red-black invariants after insert
;   - Multi-node tree construction via rb-link-node-left!/right!
;
; Deferred (full Linux rbtree, separate issues):
;   - rb-erase! (4 double-black cases)
;   - rb_replace_node
;   - rb_root_cached + leftmost cache
;   - Augmented rbtree (rb_augment_callbacks)
;   - Interval tree (CFS, VMA usage)
;   - RCU variants

(require "std/test" all:)
(require "003-rbtree" all:)

; File-level helper: build a tree with one root-linked node (set black).
(define (linked-root)
  (let ((r (make-rb-root)))
    (let ((n (make-rb-node)))
      (rb-link-node-root! r n)
      ((rb-root-node r) 'set-color!) RB-BLACK
      r)))

; ----------------------------------------------------------------
; §1 — Construction
; ----------------------------------------------------------------

(test-suite "rbtree-001-init-root"
  (check (= 1 (if (rb-root-empty? (make-rb-root)) 1 0)))
  (check (= 1 (if (not (rb-root-node (make-rb-root))) 1 0))))

(test-suite "rbtree-001-init-node"
  (check (= 1 (eq? RB-RED (rb-color (make-rb-node))))))

; ----------------------------------------------------------------
; §3 — rb-link-node-root! + count
; ----------------------------------------------------------------

(test-suite "rbtree-003-single-link"
  (check (= 1 (rb-count-nodes (linked-root)))))

; ----------------------------------------------------------------
; §5 — Color mutation works
; ----------------------------------------------------------------

(test-suite "rbtree-005-color-mutate"
  (check (= 1 (eq? RB-BLACK (let ((n (make-rb-node)))
                                ((n 'set-color!) RB-BLACK)
                                (rb-color n))))))

; ----------------------------------------------------------------
; §5 — First/last/next procedures are defined
; ----------------------------------------------------------------

(test-suite "rbtree-006-procs-defined"
  (check (= 1 (procedure? rb-first)))
  (check (= 1 (procedure? rb-last)))
  (check (= 1 (procedure? rb-next))))

; ----------------------------------------------------------------
; Run all stored test suites
; ----------------------------------------------------------------
(run-tests)