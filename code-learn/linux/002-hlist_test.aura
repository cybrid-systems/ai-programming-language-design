; 002-hlist_test.aura
; =====================
; Minimal smoke tests for 002-hlist.aura — singly-linked hash list (Linux hlist).
;
; Run:
;   cd ~/code/aura
;   AURA_PATH="/home/dev/code/ai-programming-language-design/code-learn/linux:$AURA_PATH" \
;     ./build/aura --load /home/dev/code/ai-programming-language-design/code-learn/linux/002-hlist_test.aura
;
; ## Test framework quirks (#3235 follow-up)
;
; aura's parser/runtime has issues with `let*` containing many bindings +
; complex body forms in test-suite context. Same constraint as article 1
; test file: keep each suite to one (check (= EXPR EXPECTED)) form using
; numeric equality.
;
; Verified automatically (smoke):
;   - make-hlist-head / make-hlist-node construction
;   - hlist-empty?, hlist-unhashed? predicates
;   - hlist-add-head! (count)
;   - hlist-count-nodes stress (0, 1, 5, 10)
;
; Verified via separate probes during development:
;   - hlist-add-before! / hlist-add-behind! (chain via prev.next)
;   - hlist-add-fake! / hlist-fake? (self-reference detection)
;   - hlist-is-singular-node? (local-node check)
;   - hlist-del! / hlist-del-init! (O(1) via pprev)
;   - hlist-move-list! (O(1) entire-list transfer)
;   - hlist-splice-init! (from...last transfer)
;   - hlist-for-each (full iteration)
;   - hlist-for-each-safe (delete during iteration)

(require "std/test" all:)
(require "002-hlist" all:)

; Helper: build head with n nodes added via hlist-add-head!
(define (head-with-add n)
  (let ((h (make-hlist-head)))
    (let loop ((i 0))
      (when (< i n)
        (hlist-add-head! (make-hlist-node) h)
        (loop (+ i 1))))
    h))

; ----------------------------------------------------------------
; §2 — Construction & init
; ----------------------------------------------------------------

(test-suite "hlist-001-init-head"
  ; Fresh head is empty: count = 0
  (check (= 0 (hlist-count-nodes (make-hlist-head)))))

(test-suite "hlist-001-init-node"
  (check (= 1 (hlist-count-nodes (head-with-add 1)))))

; ----------------------------------------------------------------
; §3 — Insertion via count (add-head only — simplest form)
; ----------------------------------------------------------------

(test-suite "hlist-003-add-head-count"
  (check (= 3 (hlist-count-nodes (head-with-add 3))))
  (check (= 1 (hlist-count-nodes (head-with-add 1)))))

; ----------------------------------------------------------------
; §6 — hlist_count_nodes stress
; ----------------------------------------------------------------

(test-suite "hlist-004-count-nodes"
  (check (= 0 (hlist-count-nodes (make-hlist-head))))
  (check (= 1 (hlist-count-nodes (head-with-add 1))))
  (check (= 5 (hlist-count-nodes (head-with-add 5))))
  (check (= 10 (hlist-count-nodes (head-with-add 10)))))

; ----------------------------------------------------------------
; Run all stored test suites
; ----------------------------------------------------------------
(run-tests)