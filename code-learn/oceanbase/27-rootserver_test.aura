; 27-rootserver_test.aura
; ======================
; Smoke tests for 27-rootserver.aura — RootServer (cluster coordination) minimal.
;
; Run:
;   cd ~/code/aura
;   AURA_PATH="/home/dev/code/ai-programming-language-design/code-learn/oceanbase:$AURA_PATH" \
;     AURA_PIPELINE_STRICT=0 \
;     ./build/aura --load /home/dev/code/ai-programming-language-design/code-learn/oceanbase/27-rootserver_test.aura
;
; Verified automatically (smoke):
;   - 5 RS-STATUS + 4 SERVER-STATUS + 4 ZONE-STATUS + 4 UNIT-STATUS +
;     5 DDL-STATUS constants distinct
;   - make-root-service + accessors + set-state + stats
;   - make-server-manager + accessors + inc-stats-heartbeat
;   - make-zone + accessors + set-state
;   - make-unit + accessors + set-state
;   - make-root-balancer + accessors + inc-balance-count
;   - make-ddl-task + accessors + set-status
;
; Verified via separate probes during development:
;   - Predicates reject non-target procedures
;   - State machine transitions work correctly
;
; Deferred (full OceanBase RootServer):
;   - real ObRootService with 200+ files
;   - real ObServerManager with heartbeat protocol
;   - real ObZoneManager with multi-zone coordination
;   - real ObUnitManager with pool placement
;   - real ObRootBalancer with load balancing algorithms
;   - real ObDDLService with internal table schema management
;   - real ObMajorFreezeService with daily freeze
;   - real internal __all_* tables (200+ tables)
;   - real RPC framework (ObSrvRpcProxy, ObCommonRpcProxy)
;   - real schema versioning (ObMultiVersionSchemaService)
;   - real resource unit placement (point-product greedy)
;   - real ObRestoreCtx for backup/restore coordination

(require "std/test" all:)
(require "27-rootserver" all:)

; ----------------------------------------------------------------
; Constants distinctness
; ----------------------------------------------------------------

(test-suite "27-001-rs-status-distinct"
  ; 5 RS-STATUS constants are distinct.
  (check (= 1 (if (not (= RS-STATUS-INIT
                          RS-STATUS-STARTING)) 1 0)))
  (check (= 1 (if (not (= RS-STATUS-STARTING
                          RS-STATUS-RUNNING)) 1 0)))
  (check (= 1 (if (not (= RS-STATUS-RUNNING
                          RS-STATUS-STOPPING)) 1 0)))
  (check (= 1 (if (not (= RS-STATUS-STOPPING
                          RS-STATUS-STOPPED)) 1 0))))

(test-suite "27-001-server-status-distinct"
  ; 4 SERVER-STATUS constants are distinct.
  (check (= 1 (if (not (= SERVER-STATUS-ALIVE
                          SERVER-STATUS-DEAD)) 1 0)))
  (check (= 1 (if (not (= SERVER-STATUS-DEAD
                          SERVER-STATUS-INIT)) 1 0)))
  (check (= 1 (if (not (= SERVER-STATUS-INIT
                          SERVER-STATUS-UNKNOWN)) 1 0))))

(test-suite "27-001-zone-status-distinct"
  ; 4 ZONE-STATUS constants are distinct.
  (check (= 1 (if (not (= ZONE-STATUS-ACTIVE
                          ZONE-STATUS-INACTIVE)) 1 0)))
  (check (= 1 (if (not (= ZONE-STATUS-INACTIVE
                          ZONE-STATUS-INIT)) 1 0)))
  (check (= 1 (if (not (= ZONE-STATUS-INIT
                          ZONE-STATUS-UNKNOWN)) 1 0))))

(test-suite "27-001-unit-status-distinct"
  ; 4 UNIT-STATUS constants are distinct.
  (check (= 1 (if (not (= UNIT-STATUS-ACTIVE
                          UNIT-STATUS-INACTIVE)) 1 0)))
  (check (= 1 (if (not (= UNIT-STATUS-INACTIVE
                          UNIT-STATUS-INIT)) 1 0)))
  (check (= 1 (if (not (= UNIT-STATUS-INIT
                          UNIT-STATUS-DELETING)) 1 0))))

(test-suite "27-001-ddl-status-distinct"
  ; 5 DDL-STATUS constants are distinct.
  (check (= 1 (if (not (= DDL-STATUS-PENDING
                          DDL-STATUS-RUNNING)) 1 0)))
  (check (= 1 (if (not (= DDL-STATUS-RUNNING
                          DDL-STATUS-SUCCESS)) 1 0)))
  (check (= 1 (if (not (= DDL-STATUS-SUCCESS
                          DDL-STATUS-FAILED)) 1 0)))
  (check (= 1 (if (not (= DDL-STATUS-FAILED
                          DDL-STATUS-CANCELED)) 1 0))))

; ----------------------------------------------------------------
; ObRootService
; ----------------------------------------------------------------

(test-suite "27-002-rs-construction"
  ; root-service preserves fields.
  (check (= 1 (root-service-get-rs-id
               (make-root-service 1 1004 RS-STATUS-INIT))))
  (check (= 1004 (root-service-get-tenant-id
                   (make-root-service 1 1004 RS-STATUS-INIT))))
  (check (= RS-STATUS-INIT
             (root-service-get-state
               (make-root-service 1 1004 RS-STATUS-INIT))))
  (check (= 0 (root-service-get-stats-heartbeat
               (make-root-service 1 1004 RS-STATUS-INIT))))
  (check (= 0 (root-service-get-stats-ddl
               (make-root-service 1 1004 RS-STATUS-INIT))))
  (check (= 0 (root-service-get-stats-balance
               (make-root-service 1 1004 RS-STATUS-INIT))))

(test-suite "27-002-rs-predicate"
  ; root-service? accepts only root services.
  (check (= #t (root-service? (make-root-service 1 1004 RS-STATUS-INIT))))
  (check (= #f (root-service? 'not-rs)))
  (check (= #f (root-service? 42)))

(test-suite "27-003-rs-set-state"
  ; set-state! updates.
  (check (= RS-STATUS-RUNNING
             (let ((rs (make-root-service 1 1004 RS-STATUS-INIT)))
               (root-service-set-state! rs RS-STATUS-RUNNING)
               (root-service-get-state rs))))

(test-suite "27-003-rs-inc-stats"
  ; inc-stats-ddl! / inc-stats-balance! increment.
  (check (= 1 (let ((rs (make-root-service 1 1004 RS-STATUS-INIT)))
                 (root-service-inc-stats-ddl! rs)
                 (root-service-get-stats-ddl rs))))
  (check (= 1 (let ((rs (make-root-service 1 1004 RS-STATUS-INIT)))
                 (root-service-inc-stats-balance! rs)
                 (root-service-get-stats-balance rs))))

; ----------------------------------------------------------------
; ObServerManager
; ----------------------------------------------------------------

(test-suite "27-004-server-mgr-construction"
  ; server-manager preserves fields.
  (check (= 10 (server-manager-get-server-count
                 (make-server-manager 10 8 0))))
  (check (= 8 (server-manager-get-active-count
                (make-server-manager 10 8 0))))

(test-suite "27-004-server-mgr-predicate"
  ; server-manager? accepts only server managers.
  (check (= #t (server-manager?
                 (make-server-manager 1 1 0))))
  (check (= #f (server-manager? 'not-mgr)))
  (check (= #f (server-manager? 42)))

(test-suite "27-004-server-mgr-set-active"
  ; set-active-count! updates.
  (check (= 5 (let ((sm (make-server-manager 10 8 0)))
                (server-manager-set-active-count! sm 5)
                (server-manager-get-active-count sm))))

(test-suite "27-005-server-mgr-heartbeat"
  ; inc-stats-heartbeat! increments.
  (check (= 1 (let ((sm (make-server-manager 10 8 0)))
                 (server-manager-inc-stats-heartbeat! sm)
                 (sm 'heartbeat-count))))

; ----------------------------------------------------------------
; ObZone
; ----------------------------------------------------------------

(test-suite "27-006-zone-construction"
  ; zone preserves fields.
  (check (= 1 (zone-get-id (make-zone 1 'zone1 ZONE-STATUS-ACTIVE))))
  (check (= #t (eq? 'zone1
                   (zone-get-name (make-zone 1 'zone1 ZONE-STATUS-ACTIVE)))))
  (check (= ZONE-STATUS-ACTIVE
             (zone-get-state (make-zone 1 'zone1 ZONE-STATUS-ACTIVE))))

(test-suite "27-006-zone-predicate"
  ; zone? accepts only zones.
  (check (= #t (zone? (make-zone 1 'z ZONE-STATUS-ACTIVE))))
  (check (= #f (zone? 'not-zone)))
  (check (= #f (zone? 42)))

(test-suite "27-006-zone-set-state"
  ; set-state! updates.
  (check (= ZONE-STATUS-INACTIVE
             (let ((z (make-zone 1 'z ZONE-STATUS-ACTIVE)))
               (zone-set-state! z ZONE-STATUS-INACTIVE)
               (zone-get-state z))))

; ----------------------------------------------------------------
; ObUnit
; ----------------------------------------------------------------

(test-suite "27-007-unit-construction"
  ; unit preserves fields.
  (check (= 5 (unit-get-id (make-unit 5 1 1 UNIT-STATUS-ACTIVE))))
  (check (= UNIT-STATUS-ACTIVE
             (unit-get-state (make-unit 5 1 1 UNIT-STATUS-ACTIVE))))
  (check (= 1 (unit-get-zone-id
               (make-unit 5 1 1 UNIT-STATUS-ACTIVE))))
  (check (= 1 (unit-get-server-id
               (make-unit 5 1 1 UNIT-STATUS-ACTIVE))))

(test-suite "27-007-unit-predicate"
  ; unit? accepts only units.
  (check (= #t (unit? (make-unit 1 1 1 UNIT-STATUS-ACTIVE))))
  (check (= #f (unit? 'not-unit)))
  (check (= #f (unit? 42)))

(test-suite "27-007-unit-set-state"
  ; set-state! updates.
  (check (= UNIT-STATUS-DELETING
             (let ((u (make-unit 1 1 1 UNIT-STATUS-ACTIVE)))
               (unit-set-state! u UNIT-STATUS-DELETING)
               (unit-get-state u))))

; ----------------------------------------------------------------
; ObRootBalancer
; ----------------------------------------------------------------

(test-suite "27-008-balancer-construction"
  ; balancer preserves fields.
  (check (= 0 (root-balancer-get-last-balance-time
                 (make-root-balancer 0 0))))
  (check (= 0 (root-balancer-get-balance-count
                 (make-root-balancer 0 0))))

(test-suite "27-008-balancer-predicate"
  ; root-balancer? accepts only balancers.
  (check (= #t (root-balancer? (make-root-balancer 0 0))))
  (check (= #f (root-balancer? 'not-balancer)))
  (check (= #f (root-balancer? 42)))

(test-suite "27-009-balancer-set-last-time"
  ; set-last-balance-time! updates.
  (check (= 1234567890 (let ((rb (make-root-balancer 0 0)))
                            (root-balancer-set-last-balance-time! rb 1234567890)
                            (root-balancer-get-last-balance-time rb))))

; ----------------------------------------------------------------
; ObDDLTask
; ----------------------------------------------------------------

(test-suite "27-010-ddl-task-construction"
  ; ddl-task preserves fields.
  (check (= 1 (ddl-task-get-task-id
               (make-ddl-task 1 'CREATE-TABLE DDL-STATUS-PENDING))))
  (check (= #t (eq? 'CREATE-TABLE
                   (ddl-task-get-stmt
                     (make-ddl-task 1 'CREATE-TABLE DDL-STATUS-PENDING)))))
  (check (= DDL-STATUS-PENDING
             (ddl-task-get-status
               (make-ddl-task 1 'CREATE-TABLE DDL-STATUS-PENDING))))

(test-suite "27-010-ddl-task-predicate"
  ; ddl-task? accepts only tasks.
  (check (= #t (ddl-task? (make-ddl-task 1 'X DDL-STATUS-PENDING))))
  (check (= #f (ddl-task? 'not-task)))
  (check (= #f (ddl-task? 42)))

(test-suite "27-010-ddl-task-set-status"
  ; set-status! updates.
  (check (= DDL-STATUS-SUCCESS
             (let ((t (make-ddl-task 1 'X DDL-STATUS-PENDING)))
               (ddl-task-set-status! t DDL-STATUS-SUCCESS)
               (ddl-task-get-status t))))

; ----------------------------------------------------------------
; Run all stored test suites
; ----------------------------------------------------------------
(run-tests)