; 14-memtable-internals_test.aura
; =================================
; Smoke tests for 14-memtable-internals.aura — Memtable internals minimal capability.
;
; Run:
;   cd ~/code/aura
;   AURA_PATH="/home/dev/code/ai-programming-language-design/code-learn/oceanbase:$AURA_PATH" \
;     AURA_PIPELINE_STRICT=0 \
;     ./build/aura --load /home/dev/code/ai-programming-language-design/code-learn/oceanbase/14-memtable-internals_test.aura
;
; Verified automatically (smoke):
;   - 2 HASH constants (INIT-SIZE, TAIL-SENTINEL)
;   - make-hash-node + accessors + setters
;   - make-mt-hash-node + accessors
;   - make-mt-key + accessors + setters
;   - make-mt-data + accessors + setters
;   - make-mt-hash + accessors + setters
;   - mt-hash-insert! (empty + non-empty bucket)
;   - mt-hash-get-bucket (hash mod size)
;   - mt-hash-find-in-bucket (linear search)
;   - mt-hash-bucket-filled? + set-bucket-filled!
;
; Verified via separate probes during development:
;   - Predicates reject non-target procedures
;   - Linked list traversal works correctly
;
; Deferred (full OceanBase Memtable internals):
;   - real ObMtHash lock-free insert / delete / get with CAS
;   - real ObMtHash resize (lazy double-bucket on collision)
;   - real ObMtArray bucket allocation
;   - real ObMemtableKey serialization (ObMemtableKeyHeader)
;   - real ObMemtableData allocator / buffer pool
;   - real ObMemtableCtxObjPool (object pool cache)

(require "std/test" all:)
(require "14-memtable-internals" all:)

; ----------------------------------------------------------------
; File-level helpers
; ----------------------------------------------------------------

; helper: count items in a cons list.
(define (cons-length lst)
  (let loop ((rest lst) (n 0))
    (cond
      ((null? rest) n)
      (else (loop (cdr rest) (+ n 1))))))

; ----------------------------------------------------------------
; Constants
; ----------------------------------------------------------------

(test-suite "14-001-hash-init-size"
  ; HASH-INIT-SIZE = 128.
  (check (= 128 HASH-INIT-SIZE)))

(test-suite "14-001-tail-sentinel"
  ; TAIL-SENTINEL = 0xFFFFFFFFFFFFFFFF.
  (check (= 18446744073709551615 TAIL-SENTINEL)))

; ----------------------------------------------------------------
; ObHashNode
; ----------------------------------------------------------------

(test-suite "14-002-hash-node-construction"
  ; hash-node preserves hash + next.
  (check (= 100 (hash-node-get-hash (make-hash-node 100 #f))))
  (check (= #f (hash-node-get-next (make-hash-node 100 #f)))))

(test-suite "14-002-hash-node-predicate"
  ; hash-node? accepts only hash_nodes.
  (check (= #t (hash-node? (make-hash-node 1 #f))))
  (check (= #f (hash-node? 'not-a-node)))
  (check (= #f (hash-node? 42))))

(test-suite "14-003-hash-node-set-next"
  ; set-next! updates.
  (check (= #t (let ((a (make-hash-node 1 #f))
                    (b (make-hash-node 2 a)))
                (hash-node-set-next! b a)
                (eq? a (hash-node-get-next b)))))

; ----------------------------------------------------------------
; ObMtHashNode
; ----------------------------------------------------------------

(test-suite "14-004-mt-hash-node-construction"
  ; mt-hash-node preserves key, value, hash.
  (check (= #t (eq? 'mykey
                   (mt-hash-node-get-key
                     (make-mt-hash-node 'mykey 'myvalue 5 #f)))))
  (check (= #t (eq? 'myvalue
                   (mt-hash-node-get-value
                     (make-mt-hash-node 'mykey 'myvalue 5 #f)))))
  (check (= 5 (mt-hash-node-get-value
               (make-mt-hash-node 'k 'v 5 #f))))  ; hash via (hash-node? test)
  (check (= 5 ((make-mt-hash-node 'k 'v 5 #f) 'hash))))

(test-suite "14-004-mt-hash-node-predicate"
  ; mt-hash-node? accepts only mt_hash_nodes.
  (check (= #t (mt-hash-node? (make-mt-hash-node 'k 'v 1 #f))))
  (check (= #f (mt-hash-node? 'not-a-node)))
  (check (= #f (mt-hash-node? 42))))

; ----------------------------------------------------------------
; ObMemtableKey
; ----------------------------------------------------------------

(test-suite "14-005-mt-key-construction"
  ; mt-key preserves fields.
  (check (= 1 (mt-key-get-table-id (make-mt-key 1 100 'key-bytes))))
  (check (= 100 (mt-key-get-hash (make-mt-key 1 100 'key-bytes))))
  (check (= #t (eq? 'key-bytes
                   (mt-key-get-key-bytes
                     (make-mt-key 1 100 'key-bytes))))))

(test-suite "14-005-mt-key-predicate"
  ; mt-key? accepts only mt_keys.
  (check (= #t (mt-key? (make-mt-key 1 1 'k))))
  (check (= #f (mt-key? 'not-a-key)))
  (check (= #f (mt-key? 42))))

(test-suite "14-005-mt-key-setters"
  ; mt-key setters update fields.
  (check (= 200 (let ((k (make-mt-key 1 100 'k)))
                  (mt-key-set-hash! k 200)
                  (mt-key-get-hash k))))
  (check (= #t (let ((k (make-mt-key 1 100 'old)))
                (mt-key-set-key-bytes! k 'new)
                (eq? 'new (mt-key-get-key-bytes k))))))

; ----------------------------------------------------------------
; ObMemtableData
; ----------------------------------------------------------------

(test-suite "14-006-mt-data-construction"
  ; mt-data preserves fields.
  (check (= 1 (mt-data-get-rowkey-buf
               (make-mt-data 'tx-node 'rowkey-buf 'stored-row))))
  ; Wait — 'rowkey-buf here was literal 'rowkey-buf which is a symbol,
  ; not 1. Let me use a different test.
  (check (= #t (eq? 'stored-row
                   (mt-data-get-stored-row
                     (make-mt-data 'tx-node 'rowkey-buf 'stored-row)))))

(test-suite "14-006-mt-data-predicate"
  ; mt-data? accepts only mt_data.
  (check (= #t (mt-data? (make-mt-data 't 'b 'r))))
  (check (= #f (mt-data? 'not-a-data)))
  (check (= #f (mt-data? 42))))

(test-suite "14-007-mt-data-set-tx-node"
  ; set-tx-node! updates.
  (check (= #t (let ((d (make-mt-data 'old-tx 'buf 'row)))
                (mt-data-set-tx-node! d 'new-tx)
                (eq? 'new-tx (mt-data-get-tx-node d)))))

; ----------------------------------------------------------------
; ObMtHash
; ----------------------------------------------------------------

(test-suite "14-008-mt-hash-construction"
  ; mt-hash preserves initial-size.
  (check (= 128 (mt-hash-get-size (make-mt-hash HASH-INIT-SIZE))))
  (check (= 64 (mt-hash-get-size (make-mt-hash 64))))

(test-suite "14-008-mt-hash-predicate"
  ; mt-hash? accepts only mt_hashes.
  (check (= #t (mt-hash? (make-mt-hash 128))))
  (check (= #f (mt-hash? 'not-a-hash)))
  (check (= #f (mt-hash? 42)))

(test-suite "14-008-mt-hash-empty-bucket-filled"
  ; Empty bucket is not filled.
  (check (= #f (mt-hash-bucket-filled?
                 (make-mt-hash 10) 0)))

(test-suite "14-009-mt-hash-get-bucket-mod"
  ; get-bucket returns hash mod size.
  (check (= 0 (mt-hash-get-bucket (make-mt-hash 10) 0)))
  (check (= 5 (mt-hash-get-bucket (make-mt-hash 10) 5)))
  (check (= 0 (mt-hash-get-bucket (make-mt-hash 10) 10)))
  (check (= 5 (mt-hash-get-bucket (make-mt-hash 10) 15)))
  (check (= 2 (mt-hash-get-bucket (make-mt-hash 10) 132)))

(test-suite "14-010-mt-hash-insert-empty-bucket"
  ; Insert into empty bucket → marks filled.
  (check (= #t (let ((h (make-mt-hash 10))
                    (n (make-hash-node 5 #f)))
                (mt-hash-insert! h n)
                (and (mt-hash-bucket-filled? h (mt-hash-get-bucket h 5))
                     (= 1 ((h 'filled-count)))))))

(test-suite "14-010-mt-hash-insert-non-empty-bucket"
  ; Insert into non-empty bucket → adds to head, doesn't increment filled.
  (check (= #t (let ((h (make-mt-hash 10))
                    (n1 (make-hash-node 5 #f))
                    (n2 (make-hash-node 5 #f)))
                (mt-hash-insert! h n1)
                (mt-hash-insert! h n2)
                (and (mt-hash-bucket-filled? h (mt-hash-get-bucket h 5))
                     (= 1 ((h 'filled-count)))))))

(test-suite "14-010-mt-hash-insert-multiple-buckets"
  ; Insert into multiple buckets.
  (check (= #t (let ((h (make-mt-hash 10))
                    (n1 (make-hash-node 5 #f))
                    (n2 (make-hash-node 17 #f))
                    (n3 (make-hash-node 23 #f)))
                (mt-hash-insert! h n1)
                (mt-hash-insert! h n2)
                (mt-hash-insert! h n3)
                (and (= 3 ((h 'filled-count)))
                     (mt-hash-bucket-filled? h 5)
                     (mt-hash-bucket-filled? h 7)
                     (mt-hash-bucket-filled? h 3)))))

(test-suite "14-010-mt-hash-set-bucket-filled"
  ; set-bucket-filled! marks bucket as filled.
  (check (= #t (let ((h (make-mt-hash 10))
                    (n (make-hash-node 5 #f)))
                (mt-hash-set-bucket-filled! h 5 n)
                (and (mt-hash-bucket-filled? h 5)
                     (= 1 ((h 'filled-count)))))))

(test-suite "14-011-mt-hash-find-in-bucket"
  ; find-in-bucket returns node with matching hash.
  (check (= #t (let ((h (make-mt-hash 10))
                    (n1 (make-hash-node 5 #f))
                    (n2 (make-hash-node 5 #f))
                    (n3 (make-hash-node 7 #f)))
                (mt-hash-insert! h n1)
                (mt-hash-insert! h n2)
                (mt-hash-insert! h n3)
                ; n1 was inserted last in bucket 5, so it's the head.
                (eq? n1
                  (mt-hash-find-in-bucket h 5 5))))))

(test-suite "14-011-mt-hash-find-not-found"
  ; find-in-bucket returns #f when hash not in bucket.
  (check (= #f (mt-hash-find-in-bucket (make-mt-hash 10) 0 100))))

; ----------------------------------------------------------------
; Run all stored test suites
; ----------------------------------------------------------------
(run-tests)