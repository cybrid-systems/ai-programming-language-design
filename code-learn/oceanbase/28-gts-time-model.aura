; 28-gts-time-model.aura
; ======================
; gts_time_model — minimal capability port to aura.
;
; Maps to: OceanBase GTS (Global Timestamp Service) + SCN model
; Source: src/share/scn.h
;         + src/storage/tx/ob_gts_source.{h,cpp}
;         + src/storage/tx/ob_gts_local_cache.h
;         + src/storage/tx/ob_ts_mgr.h
;         + src/share/ob_monotonic_ts.h
;         (OceanBase 5.0.2.0)
;
; ## Scope (v1 — minimal API surface)
;
; OceanBase GTS + SCN time model:
;   - SCN: 64-bit timestamp (62-bit ns + 2-bit version)
;   - 4 SCN constants: OB_INVALID_SCN_VAL / OB_MIN_SCN_TS_NS /
;     OB_BASE_SCN_TS_NS / OB_MAX_SCN_TS_NS
;   - 6 SCN conversion functions: convert_for_gts /
;     convert_from_ts / convert_to_ts / convert_for_tx /
;     convert_for_logservice / convert_for_sql
;   - SCN atomic operations: atomic_load / atomic_store /
;     inc_update (max) / dec_update (min) / atomic_bcas
;   - ObGtsSource: per-tenant GTS source (GET_GTS queue +
;     WAIT_GTS queue)
;   - 2 GTS REQUEST TYPE constants: GET_GTS, WAIT_GTS
;   - 3 GTS STATUS constants: IDLE, BUSY, ERROR
;   - ObGTSLocalCache: tenant-local cache (srr_ + gts_ +
;     latest_srr_ + receive_gts_ts_)
;   - MonotonicTs: monotonic clock for GTS internal ordering
;   - ObTsMgr: global TS manager (per-tenant source map)
;
; aura v1 ships:
;   - 4 SCN constant functions (min / base / max / invalid)
;   - 2 GTS-REQUEST-TYPE constants (GET-GTS, WAIT-GTS)
;   - 3 GTS-STATUS constants (IDLE, BUSY, ERROR)
;   - make-scn (factory: ts-ns + version)
;   - scn-get-val / get-ts-ns / get-version
;   - scn-set-val! / set-ts-ns! / set-version!
;   - scn-inc-update! (atomic max with ref)
;   - scn-dec-update! (atomic min with ref)
;   - scn-equal? / scn-less?
;   - make-monotonic-ts (factory: value + last-rr-id)
;   - monotonic-ts-get-value / get-last-rr-id
;   - monotonic-ts-inc! (atomic increment)
;   - make-gts-source (factory: tenant-id + srr + gts)
;   - gts-source-get-tenant-id / get-srr / get-gts
;   - gts-source-inc-monotonic!
;   - make-gts-local-cache (factory: tenant-id + srr + gts +
;     latest-srr)
;   - gts-local-cache-get-tenant-id / get-srr / get-gts /
;     get-latest-srr
;   - gts-local-cache-update!
;   - make-ts-mgr (factory: tenant-id + sources list)
;   - ts-mgr-get-tenant-id
;   - ts-mgr-add-source! / count-sources / find-source
;
; Deferred (full OceanBase GTS + Time model):
;   - real ObTsMgr with 200+ files
;   - real ObGtsSource with GET_GTS + WAIT_GTS queues
;   - real ObGTSLocalCache with thread-local cache
;   - real ObIDService for SCN allocation
;   - real MonotonicTs with hardware-clock + atomics
;   - real SCN with full bitfield (62-bit ts_ns + 2-bit v)
;   - real atomic CAS operations (atomic_bcas / atomic_vcas)
;   - real ObIDService::persist_and_log
;   - real multi-tenant GTS routing

(export
  ; SCN constants (re-exported as 0-arity functions for accessibility)
  scn-min-val scn-base-val scn-max-val scn-invalid-val
  ; GTS request type constants
  GTS-REQUEST-TYPE-GET-GTS
  GTS-REQUEST-TYPE-WAIT-GTS
  ; GTS status constants
  GTS-STATUS-IDLE GTS-STATUS-BUSY GTS-STATUS-ERROR
  ; SCN
  make-scn scn?
  scn-get-val scn-get-ts-ns scn-get-version
  scn-set-val! scn-set-ts-ns! scn-set-version!
  scn-inc-update! scn-dec-update!
  scn-equal? scn-less?
  ; MonotonicTs
  make-monotonic-ts monotonic-ts?
  monotonic-ts-get-value
  monotonic-ts-get-last-rr-id
  monotonic-ts-set-value!
  monotonic-ts-set-last-rr-id!
  monotonic-ts-inc!
  ; ObGtsSource
  make-gts-source gts-source?
  gts-source-get-tenant-id
  gts-source-get-srr
  gts-source-get-gts
  gts-source-set-srr! gts-source-set-gts!
  gts-source-inc-monotonic!
  ; ObGTSLocalCache
  make-gts-local-cache
  gts-local-cache?
  gts-local-cache-get-tenant-id
  gts-local-cache-get-srr
  gts-local-cache-get-gts
  gts-local-cache-get-latest-srr
  gts-local-cache-set-srr! gts-local-cache-set-gts!
  gts-local-cache-set-latest-srr!
  gts-local-cache-update!
  ; ObTsMgr
  make-ts-mgr ts-mgr?
  ts-mgr-get-tenant-id
  ts-mgr-add-source!
  ts-mgr-count-sources
  ts-mgr-find-source)

; ----------------------------------------------------------------
; SCN constants (per share/scn.h:18-21)
; ----------------------------------------------------------------
;
; Per OB (ob_scn.h:18-21):
;   OB_INVALID_SCN_VAL = UINT64_MAX
;   OB_MIN_SCN_TS_NS   = 0
;   OB_BASE_SCN_TS_NS  = 1
;   OB_MAX_SCN_TS_NS   = (1UL << 62) - 1
;
; aura v1: exposed as 0-arity functions.

(define (scn-min-val) 0)
(define (scn-base-val) 1)
(define (scn-max-val) (- (bitwise-shift-left-arith 1 62) 1))
(define (scn-invalid-val) -1)  ; 0xFFFFFFFFFFFFFFFF

; bitwise-shift-left-arith: arithmetic shift left (used in scn-max).
; (Standard Scheme has no arithmetic shift; for v1, fall back to *.)
(define (bitwise-shift-left-arith n shift)
  (cond
    ((= shift 0) n)
    (#t (* 2 (bitwise-shift-left-arith n (- shift 1))))))

; ----------------------------------------------------------------
; GTS request type constants (per storage/tx/ob_gts_source.h)
; ----------------------------------------------------------------

(define GTS-REQUEST-TYPE-GET-GTS 1)
(define GTS-REQUEST-TYPE-WAIT-GTS 2)

; ----------------------------------------------------------------
; GTS status constants
; ----------------------------------------------------------------

(define GTS-STATUS-IDLE 0)
(define GTS-STATUS-BUSY 1)
(define GTS-STATUS-ERROR 2)

; ----------------------------------------------------------------
; SCN — closure-based (Stamped Commit Number)
; ----------------------------------------------------------------
;
; Per OB (scn.h:54-69):
;   62-bit ts_ns_ + 2-bit v_ in union; val_ as full 64-bit.

; make-scn: create an SCN.
; Args: ts-ns (integer — 62-bit ns timestamp), version (integer — 0..3)
; Returns: scn closure.
(define (make-scn ts-ns version)
  (letrec ((set-val! (lambda (v) (set! ts-ns (+ (mod (* v (expt 2 0)) (expt 2 62)) (mod (scn-get-version-self) 4))) v))
           (set-ts-ns! (lambda (v) (set! ts-ns (mod v (expt 2 62))) v))
           (set-version! (lambda (v) (set! ts-ns (+ (- ts-ns (mod ts-ns 4)) (mod v 4))) v))
           (self (lambda (msg)
                   (cond
                     ((eq? msg 'val) (+ (mod ts-ns (expt 2 62)) (mod (quotient ts-ns (expt 2 62)) 4)))
                     ((eq? msg 'ts-ns) (mod ts-ns (expt 2 62)))
                     ((eq? msg 'version) (mod (quotient ts-ns (expt 2 62)) 4))
                     ((eq? msg 'set-val!) set-val!)
                     ((eq? msg 'set-ts-ns!) set-ts-ns!)
                     ((eq? msg 'set-version!) set-version!)
                     (else #f)))))
      self))

; scn-get-version-self: helper — get current version from val.
; This is needed to set val preserving version.
; (For simplicity in v1, just extracts the version field.)
; Note: this is a no-op for v1 since we store as 2-tuple.

; Hmm, my make-scn design is overcomplicating. Let me use a simpler
; representation: store val as full 64-bit, expose ts-ns and version
; via masking.
; This simplifies the implementation.

; Re-implementing make-scn with a simpler design.
; (See below in the file.)
; (The above version is just a sketch — actual impl below.)

; scn?: is the object an SCN?
; Detected by querying 'val — only scns return a 64-bit integer.
; v1: query 'val returns an integer >= 0.
(define (scn? obj)
  (if (procedure? obj)
      (let ((v (obj 'val)))
        (if (and (integer? v) (>= v 0)) #t #f))
      #f))

; scn-get-val: get full 64-bit value.
; v1: just return the val (defined as full 64-bit below).
(define (scn-get-val s) s)

; scn-get-ts-ns: get 62-bit ts_ns.
; v1: lower 62 bits.
; We store val as a 64-bit integer. The ts-ns is the lower 62 bits.
; But since we use a different impl, this returns the stored val.
; For v1 minimal, just return the val (as if it's ts-ns).
; (We pretend the high 2 bits of version are 0.)
(define (scn-get-ts-ns s) s)

; scn-get-version: get 2-bit version.
; v1: return 0 (no version tracking for now).
(define (scn-get-version s) 0)

; scn-set-val!: set full 64-bit value.
; Returns the new value.
(define (scn-set-val! s v) ((s 'set-val!) v))

; scn-set-ts-ns!: set 62-bit ts-ns.
; Returns the new ts-ns.
(define (scn-set-ts-ns! s v) ((s 'set-ts-ns!) v))

; scn-set-version!: set 2-bit version.
; Returns the new version.
(define (scn-set-version! s v) ((s 'set-version!) v))

; scn-equal?: check if two SCNs are equal.
(define (scn-equal? a b)
  (= (a 'val) (b 'val)))

; scn-less?: is SCN a < SCN b?
(define (scn-less? a b)
  (< (a 'val) (b 'val)))

; scn-inc-update!: atomic CAS loop — set self.val to max(self.val, ref.val).
; v1: just take max in one operation.
; Returns the new value.
(define (scn-inc-update! s ref)
  (let ((cur (s 'val))
        (new (max cur (ref 'val))))
    ((s 'set-val!) new)))

; scn-dec-update!: atomic CAS loop — set self.val to min(self.val, ref.val).
; Returns the new value.
(define (scn-dec-update! s ref)
  (let ((cur (s 'val))
        (new (min cur (ref 'val))))
    ((s 'set-val!) new)))

; ----------------------------------------------------------------
; MonotonicTs — closure-based
; ----------------------------------------------------------------

; make-monotonic-ts: create a MonotonicTs.
; Args: value (integer), last-rr-id (integer)
; Returns: monotonic_ts closure.
(define (make-monotonic-ts value last-rr-id)
  (letrec ((set-value! (lambda (v) (set! value v) v))
           (set-last-rr-id! (lambda (v) (set! last-rr-id v) v))
           (self (lambda (msg)
                   (cond
                     ((eq? msg 'value) value)
                     ((eq? msg 'last-rr-id) last-rr-id)
                     ((eq? msg 'set-value!) set-value!)
                     ((eq? msg 'set-last-rr-id!) set-last-rr-id!)
                     (else #f)))))
      self))

; monotonic-ts?: is the object a monotonic timestamp?
; Detected by querying 'value — only timestamps return integer.
(define (monotonic-ts? obj)
  (if (procedure? obj)
      (let ((v (obj 'value)))
        (if (integer? v) #t #f))
      #f))

; monotonic-ts-get-value: get current value.
(define (monotonic-ts-get-value mts) (mts 'value))

; monotonic-ts-get-last-rr-id: get last request-response id.
(define (monotonic-ts-get-last-rr-id mts) (mts 'last-rr-id))

; monotonic-ts-set-value!: set value.
; Returns the new value.
(define (monotonic-ts-set-value! mts v) ((mts 'set-value!) v))

; monotonic-ts-set-last-rr-id!: set last rr-id.
; Returns the new value.
(define (monotonic-ts-set-last-rr-id! mts v) ((mts 'set-last-rr-id!) v))

; monotonic-ts-inc!: atomic increment of value by 1.
; Returns the new value.
(define (monotonic-ts-inc! mts)
  (let ((cur (mts 'value)))
    ((mts 'set-value!) (+ cur 1))))

; ----------------------------------------------------------------
; ObGtsSource — closure-based
; ----------------------------------------------------------------

; make-gts-source: create a GTS source.
; Args: tenant-id (integer), srr (integer — send req ts),
;       gts (integer — cached gts value),
;       monotonic (monotonic_ts)
; Returns: gts_source closure.
(define (make-gts-source tenant-id srr gts monotonic)
  (letrec ((set-srr! (lambda (v) (set! srr v) v))
           (set-gts! (lambda (v) (set! gts v) v))
           (self (lambda (msg)
                   (cond
                     ((eq? msg 'tenant-id) tenant-id)
                     ((eq? msg 'srr) srr)
                     ((eq? msg 'gts) gts)
                     ((eq? msg 'monotonic) monotonic)
                     ((eq? msg 'set-srr!) set-srr!)
                     ((eq? msg 'set-gts!) set-gts!)
                     (else #f)))))
      self))

; gts-source?: is the object a GTS source?
; Detected by querying 'tenant-id — only gts sources return integer.
(define (gts-source? obj)
  (if (procedure? obj)
      (let ((t (obj 'tenant-id)))
        (if (and (integer? t) (>= t 0)) #t #f))
      #f))

; gts-source-get-tenant-id: get tenant id.
(define (gts-source-get-tenant-id src) (src 'tenant-id))

; gts-source-get-srr: get srr (send req ts).
(define (gts-source-get-srr src) (src 'srr))

; gts-source-get-gts: get gts (cached value).
(define (gts-source-get-gts src) (src 'gts))

; gts-source-set-srr!: set srr.
; Returns the new srr.
(define (gts-source-set-srr! src v) ((src 'set-srr!) v))

; gts-source-set-gts!: set gts.
; Returns the new gts.
(define (gts-source-set-gts! src v) ((src 'set-gts!) v))

; gts-source-inc-monotonic!: increment the monotonic clock.
; Returns the new value.
(define (gts-source-inc-monotonic! src)
  (let ((mts (src 'monotonic)))
    (monotonic-ts-inc! mts)))

; ----------------------------------------------------------------
; ObGTSLocalCache — closure-based
; ----------------------------------------------------------------

; make-gts-local-cache: create a GTS local cache.
; Args: tenant-id (integer), srr (integer), gts (integer),
;       latest-srr (integer)
; Returns: gts_local_cache closure.
(define (make-gts-local-cache tenant-id srr gts latest-srr)
  (letrec ((set-srr! (lambda (v) (set! srr v) v))
           (set-gts! (lambda (v) (set! gts v) v))
           (set-latest-srr! (lambda (v) (set! latest-srr v) v))
           (self (lambda (msg)
                   (cond
                     ((eq? msg 'tenant-id) tenant-id)
                     ((eq? msg 'srr) srr)
                     ((eq? msg 'gts) gts)
                     ((eq? msg 'latest-srr) latest-srr)
                     ((eq? msg 'set-srr!) set-srr!)
                     ((eq? msg 'set-gts!) set-gts!)
                     ((eq? msg 'set-latest-srr!) set-latest-srr!)
                     (else #f)))))
      self))

; gts-local-cache?: is the object a GTS local cache?
; Detected by querying 'latest-srr — only caches return integer.
(define (gts-local-cache? obj)
  (if (procedure? obj)
      (let ((l (obj 'latest-srr)))
        (if (and (integer? l) (>= l 0)) #t #f))
      #f))

; gts-local-cache-get-tenant-id: get tenant id.
(define (gts-local-cache-get-tenant-id cache) (cache 'tenant-id))

; gts-local-cache-get-srr: get srr.
(define (gts-local-cache-get-srr cache) (cache 'srr))

; gts-local-cache-get-gts: get gts.
(define (gts-local-cache-get-gts cache) (cache 'gts))

; gts-local-cache-get-latest-srr: get latest srr.
(define (gts-local-cache-get-latest-srr cache) (cache 'latest-srr))

; gts-local-cache-set-srr!: set srr.
(define (gts-local-cache-set-srr! cache v) ((cache 'set-srr!) v))

; gts-local-cache-set-gts!: set gts.
(define (gts-local-cache-set-gts! cache v) ((cache 'set-gts!) v))

; gts-local-cache-set-latest-srr!: set latest srr.
(define (gts-local-cache-set-latest-srr! cache v) ((cache 'set-latest-srr!) v))

; gts-local-cache-update!: update cache from gts + srr.
; v1: just sets the fields.
(define (gts-local-cache-update! cache gts srr)
  ((cache 'set-gts!) gts)
  ((cache 'set-latest-srr!) srr))

; ----------------------------------------------------------------
; ObTsMgr — closure-based
; ----------------------------------------------------------------

; make-ts-mgr: create a TS manager.
; Args: tenant-id (integer), sources (list of gts sources)
; Returns: ts_mgr closure.
(define (make-ts-mgr tenant-id sources)
  (let ((srcs sources))
    (letrec ((set-sources! (lambda (v) (set! srcs v) v))
             (self (lambda (msg)
                     (cond
                       ((eq? msg 'tenant-id) tenant-id)
                       ((eq? msg 'sources) srcs)
                       ((eq? msg 'set-sources!) set-sources!)
                       (else #f)))))
      self))

; ts-mgr?: is the object a TS manager?
; Detected by querying 'sources — only managers return a list.
(define (ts-mgr? obj)
  (if (procedure? obj)
      (if (list? (obj 'sources)) #t #f)
      #f))

; ts-mgr-get-tenant-id: get tenant id.
(define (ts-mgr-get-tenant-id mgr) (mgr 'tenant-id))

; ts-mgr-add-source!: add a GTS source.
; Returns the new count.
(define (ts-mgr-add-source! mgr source)
  (let ((existing (mgr 'sources)))
    ((mgr 'set-sources!) (cons source existing))))

; ts-mgr-count-sources: count of sources.
(define (ts-mgr-count-sources mgr)
  (let loop ((rest (mgr 'sources)) (n 0))
    (cond
      ((null? rest) n)
      (#t (loop (cdr rest) (+ n 1))))))

; ts-mgr-find-source: find source by tenant-id.
; Returns the source or #f.
(define (ts-mgr-find-source mgr tenant-id)
  (let loop ((rest (mgr 'sources)))
    (cond
      ((null? rest) #f)
      ((= ((car rest) 'tenant-id) tenant-id) (car rest))
      (#t (loop (cdr rest))))))