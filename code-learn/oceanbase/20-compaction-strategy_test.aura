; 20-compaction-strategy_test.aura
; ======================
; Smoke tests for 20-compaction-strategy.aura — Compaction minimal.
;
; Run:
;   cd ~/code/aura
;   AURA_PATH="/home/dev/code/ai-programming-language-design/code-learn/oceanbase:$AURA_PATH" \
;     AURA_PIPELINE_STRICT=0 \
;     ./build/aura --load /home/dev/code/ai-programming-language-design/code-learn/oceanbase/20-compaction-strategy_test.aura
;
; Verified automatically (smoke):
;   - 3 SST-TYPE constants distinct
;   - 3 COMPACTION-TYPE constants distinct
;   - 4 COMPACTION-STATUS constants distinct
;   - make-sstable + accessors + setters
;   - make-compaction-task + accessors + set-status!
;   - make-memtable + accessors + need-freeze?
;   - make-tablet + memtable + sstables + add/remove
;   - make-sstable-writer + write! (memtable → sstable)
;
; Verified via separate probes during development:
;   - Predicates reject non-target procedures
;   - Compaction trigger predicate works correctly
;   - SSTable write returns valid sstable
;
; Deferred (full OceanBase Compaction):
;   - real ObMemtable::need_freeze with time threshold
;   - real ObPartitionService::minor_freeze with 5-step flow
;   - real ObSSTableWriter with micro_block / macro_block headers
;   - real compaction DAG scheduler (ObDagScheduler)
;   - real ObPartitionMerge with 4-phase merge
;   - real history merge with TTL / delete handling
;   - real major freeze (cluster-wide + column-store conversion)
;   - real IO rate control (ObIOManager)
;   - real statistics + monitoring (ObCompactionStat)

(require "std/test" all:)
(require "20-compaction-strategy" all:)

; ----------------------------------------------------------------
; Constants distinctness
; ----------------------------------------------------------------

(test-suite "20-001-sst-type-distinct"
  ; 3 SST-TYPE constants are distinct.
  (check (= 1 (if (not (= SST-TYPE-NORMAL
                          SST-TYPE-COMPACTED)) 1 0)))
  (check (= 1 (if (not (= SST-TYPE-COMPACTED
                          SST-TYPE-COLUMNAR)) 1 0)))
  (check (= 1 (if (not (= SST-TYPE-NORMAL
                          SST-TYPE-COLUMNAR)) 1 0))))

(test-suite "20-001-compaction-type-distinct"
  ; 3 COMPACTION-TYPE constants are distinct.
  (check (= 1 (if (not (= COMPACTION-TYPE-MINOR-FREEZE
                          COMPACTION-TYPE-MAJOR-FREEZE)) 1 0)))
  (check (= 1 (if (not (= COMPACTION-TYPE-MAJOR-FREEZE
                          COMPACTION-TYPE-HISTORY-MERGE)) 1 0)))
  (check (= 1 (if (not (= COMPACTION-TYPE-MINOR-FREEZE
                          COMPACTION-TYPE-HISTORY-MERGE)) 1 0))))

(test-suite "20-001-compaction-status-distinct"
  ; 4 COMPACTION-STATUS constants are distinct.
  (check (= 1 (if (not (= COMPACTION-STATUS-PENDING
                          COMPACTION-STATUS-RUNNING)) 1 0)))
  (check (= 1 (if (not (= COMPACTION-STATUS-RUNNING
                          COMPACTION-STATUS-DONE)) 1 0)))
  (check (= 1 (if (not (= COMPACTION-STATUS-DONE
                          COMPACTION-STATUS-FAILED)) 1 0)))
  (check (= 1 (if (not (= COMPACTION-STATUS-PENDING
                          COMPACTION-STATUS-FAILED)) 1 0))))

; ----------------------------------------------------------------
; SSTable
; ----------------------------------------------------------------

(test-suite "20-002-sstable-construction"
  ; sstable preserves type + size + row-count.
  (check (= SST-TYPE-NORMAL
             (sstable-get-type (make-sstable SST-TYPE-NORMAL 1048576 1000))))
  (check (= 1048576
             (sstable-get-size (make-sstable SST-TYPE-NORMAL 1048576 1000))))
  (check (= 1000
             (sstable-get-row-count
               (make-sstable SST-TYPE-NORMAL 1048576 1000)))))

(test-suite "20-002-sstable-predicate"
  ; sstable? accepts only sstables.
  (check (= #t (sstable? (make-sstable SST-TYPE-NORMAL 100 10))))
  (check (= #f (sstable? 'not-a-sst)))
  (check (= #f (sstable? 42)))

(test-suite "20-003-sstable-setters"
  ; setters update fields.
  (check (= SST-TYPE-COMPACTED
             (let ((s (make-sstable SST-TYPE-NORMAL 100 10)))
               (sstable-set-type! s SST-TYPE-COMPACTED)
               (sstable-get-type s))))
  (check (= 200 (let ((s (make-sstable SST-TYPE-NORMAL 100 10)))
                 (sstable-set-size! s 200)
                 (sstable-get-size s))))
  (check (= 5000 (let ((s (make-sstable SST-TYPE-NORMAL 100 10)))
                  (sstable-set-row-count! s 5000)
                  (sstable-get-row-count s))))

; ----------------------------------------------------------------
; CompactionTask
; ----------------------------------------------------------------

(test-suite "20-004-compaction-task-construction"
  ; compaction task preserves fields.
  (check (= COMPACTION-TYPE-MINOR-FREEZE
             (compaction-task-get-type
               (make-compaction-task COMPACTION-TYPE-MINOR-FREEZE 1 100))))
  (check (= 1 (compaction-task-get-tablet-id
                (make-compaction-task COMPACTION-TYPE-MINOR-FREEZE 1 100))))
  (check (= 100 (compaction-task-get-trigger
                 (make-compaction-task COMPACTION-TYPE-MINOR-FREEZE 1 100))))
  (check (= COMPACTION-STATUS-PENDING
             (compaction-task-get-status
               (make-compaction-task COMPACTION-TYPE-MINOR-FREEZE 1 100))))

(test-suite "20-004-compaction-task-predicate"
  ; compaction-task? accepts only tasks.
  (check (= #t (compaction-task?
                 (make-compaction-task COMPACTION-TYPE-MINOR-FREEZE 1 1))))
  (check (= #f (compaction-task? 'not-a-task)))
  (check (= #f (compaction-task? 42)))

(test-suite "20-005-compaction-task-set-status"
  ; set-status! updates.
  (check (= COMPACTION-STATUS-DONE
             (let ((t (make-compaction-task COMPACTION-TYPE-MINOR-FREEZE 1 1)))
               (compaction-task-set-status! t COMPACTION-STATUS-DONE)
               (compaction-task-get-status t))))
  (check (= COMPACTION-STATUS-RUNNING
             (let ((t (make-compaction-task COMPACTION-TYPE-MAJOR-FREEZE 1 1)))
               (compaction-task-set-status! t COMPACTION-STATUS-RUNNING)
               (compaction-task-get-status t))))

; ----------------------------------------------------------------
; Memtable
; ----------------------------------------------------------------

(test-suite "20-006-memtable-construction"
  ; memtable preserves fields.
  (check (= 1 (memtable-get-tablet-id (make-memtable 1 1024 100))))
  (check (= 1024 (memtable-get-mem-used (make-memtable 1 1024 100))))
  (check (= 100 (memtable-get-row-count (make-memtable 1 1024 100)))))

(test-suite "20-006-memtable-predicate"
  ; memtable? accepts only memtables.
  (check (= #t (memtable? (make-memtable 1 0 0))))
  (check (= #f (memtable? 'not-a-mt)))
  (check (= #f (memtable? 42)))

(test-suite "20-006-memtable-setters"
  ; memtable setters update fields.
  (check (= 2048 (let ((m (make-memtable 1 0 0)))
                  (memtable-set-mem-used! m 2048)
                  (memtable-get-mem-used m))))
  (check (= 200 (let ((m (make-memtable 1 0 0)))
                 (memtable-set-row-count! m 200)
                 (memtable-get-row-count m))))

(test-suite "20-007-memtable-need-freeze"
  ; need-freeze? true when mem-used >= threshold.
  (check (= #f (let ((m (make-memtable 1 1024 100)))
                 (memtable-need-freeze? m))))
  (check (= #t (let ((m (make-memtable 1
                                       memtable-freeze-memory-threshold
                                       100)))
                 (memtable-need-freeze? m)))))

; ----------------------------------------------------------------
; Tablet
; ----------------------------------------------------------------

(test-suite "20-008-tablet-construction"
  ; tablet preserves fields.
  (check (= 1 (tablet-get-id (make-tablet 1 #f '()))))
  (check (= #f (tablet-get-memtable (make-tablet 1 #f '()))))
  (check (= 0 (tablet-get-sstable-count (make-tablet 1 #f '())))))

(test-suite "20-008-tablet-predicate"
  ; tablet? accepts only tablets.
  (check (= #t (tablet? (make-tablet 1 #f '()))))
  (check (= #f (tablet? 'not-a-tablet)))
  (check (= #f (tablet? 42)))

(test-suite "20-009-tablet-set-memtable"
  ; set-memtable! updates.
  (check (= #t (let ((t (make-tablet 1 #f '()))
                      (m (make-memtable 1 0 0)))
                 (tablet-set-memtable! t m)
                 (eq? m (tablet-get-memtable t)))))

(test-suite "20-010-tablet-add-sstable"
  ; add-sstable! increases count.
  (check (= 1 (let ((t (make-tablet 1 #f '()))
                    (s (make-sstable SST-TYPE-NORMAL 100 10)))
                (tablet-add-sstable! t s)
                (tablet-get-sstable-count t))))
  (check (= 3 (let ((t (make-tablet 1 #f '()))
                    (s1 (make-sstable SST-TYPE-NORMAL 100 10))
                    (s2 (make-sstable SST-TYPE-COMPACTED 200 20))
                    (s3 (make-sstable SST-TYPE-COLUMNAR 300 30)))
                (tablet-add-sstable! t s1)
                (tablet-add-sstable! t s2)
                (tablet-add-sstable! t s3)
                (tablet-get-sstable-count t))))

(test-suite "20-011-tablet-remove-sstable"
  ; remove-sstable! decreases count.
  (check (= 1 (let ((t (make-tablet 1 #f '()))
                    (s1 (make-sstable SST-TYPE-NORMAL 100 10))
                    (s2 (make-sstable SST-TYPE-NORMAL 200 20))
                    (s3 (make-sstable SST-TYPE-NORMAL 300 30)))
                (tablet-add-sstable! t s1)
                (tablet-add-sstable! t s2)
                (tablet-add-sstable! t s3)
                (tablet-remove-sstable! t 0)
                (tablet-get-sstable-count t))))

; ----------------------------------------------------------------
; SSTableWriter
; ----------------------------------------------------------------

(test-suite "20-012-sstable-writer-construction"
  ; writer preserves fields.
  (check (= #t (memtable? (sstable-writer-write!
                            (make-sstable-writer (make-memtable 1 1024 100)
                                                 COMPRESSOR-TYPE-ZSTD))))
  )

(test-suite "20-012-sstable-writer-predicate"
  ; sstable-writer? accepts only writers.
  (check (= #t (sstable-writer?
                 (make-sstable-writer (make-memtable 1 0 0) COMPRESSOR-TYPE-NONE))))
  (check (= #f (sstable-writer? 'not-a-writer)))
  (check (= #f (sstable-writer? 42)))

(test-suite "20-013-sstable-writer-write"
  ; write! returns a valid sstable.
  (check (= #t (let ((w (make-sstable-writer
                          (make-memtable 1 1024 100)
                          COMPRESSOR-TYPE-ZSTD)))
                 (let ((sst (sstable-writer-write! w)))
                   (and (sstable? sst)
                        (= SST-TYPE-NORMAL (sstable-get-type sst))
                        (= 100 (sstable-get-row-count sst)))))))

(test-suite "20-013-sstable-writer-write-stats"
  ; write! increments stats.
  (check (= 1 (let ((w (make-sstable-writer
                          (make-memtable 1 1024 100)
                          COMPRESSOR-TYPE-ZSTD)))
                 (sstable-writer-write! w)
                 (sstable-writer-get-sstables-written w))))

(test-suite "20-014-sstable-writer-multiple-writes"
  ; Multiple writes accumulate stats.
  (check (= 3 (let ((w (make-sstable-writer
                          (make-memtable 1 1024 100)
                          COMPRESSOR-TYPE-ZSTD)))
                 (sstable-writer-write! w)
                 (sstable-writer-write! w)
                 (sstable-writer-write! w)
                 (sstable-writer-get-sstables-written w))))

(test-suite "20-014-sstable-writer-reset-stats"
  ; reset-stats! zeros all stats.
  (check (= 0 (let ((w (make-sstable-writer
                          (make-memtable 1 1024 100)
                          COMPRESSOR-TYPE-ZSTD)))
                 (sstable-writer-write! w)
                 (sstable-writer-reset-stats! w)
                 (sstable-writer-get-sstables-written w))))

; ----------------------------------------------------------------
; Run all stored test suites
; ----------------------------------------------------------------
(run-tests)