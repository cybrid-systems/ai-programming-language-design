+/** B-Tree optimization header size.
+    This is placed between the supremum record end and the user record
+    heap start, ONLY in FORMAT_BTREE_OPT pages.
+    Layout:
+      0-3:    PAGE_BTREE_FLAGS (uint32)
+      4-67:   PAGE_HINTS[16] (16 × uint32_t)
+      68-71:  PAGE_PREFIX_LEN (uint32, length of common prefix)
+      72-103: PAGE_PREFIX_BUF (32 bytes of prefix data)
+      104-111: PAGE_FD_BASE_KEY (uint64, min key for fully-dense mode)
+      112-175: PAGE_FD_BITMAP (64 bytes, 512-bit occupancy bitmap) */
+constexpr uint32_t PAGE_HEADS_MAX = 128;
+constexpr uint32_t PAGE_HEADS_AREA = PAGE_HEADS_MAX * 4;
+constexpr uint32_t PAGE_BTREE_HDR_SIZE = 176 + PAGE_HEADS_AREA;
+constexpr uint32_t PAGE_HEADS = 176;
+
+/** Common prefix length field offset (4 bytes). */
+constexpr uint32_t PAGE_PREFIX_LEN = 94 + 4 + 16 * 4;
+
+/** Common prefix data buffer offset (32 bytes). */
+constexpr uint32_t PAGE_PREFIX_BUF = 94 + 4 + 64 + 4 + 4;
+
+/** Max prefix bytes we can store. */
+constexpr uint32_t PAGE_PREFIX_BUF_SIZE = 32;
+
+/** Fully-Dense base key (uint64, min key on this page). */
+constexpr uint32_t PAGE_FD_BASE_KEY = PAGE_PREFIX_BUF + PAGE_PREFIX_BUF_SIZE;
+
+/** Fully-Dense bitmap (64 bytes = 512 bits for occupancy tracking). */
+constexpr uint32_t PAGE_FD_BITMAP = PAGE_FD_BASE_KEY + 8;
+
+/** Number of keys in the FD bitmap (512 = 64 bytes × 8 bits). */
+constexpr uint32_t PAGE_FD_BITMAP_ENTRIES = 512;
+
+/** Fully-dense bitmap size in bytes. */
+constexpr uint32_t PAGE_FD_BITMAP_SIZE = PAGE_FD_BITMAP_ENTRIES / 8;
+
+/** B-Tree flags offset from page start (at SUPREMUM_END for BTREE_OPT). */
+constexpr uint32_t PAGE_BTREE_FLAGS = PAGE_DATA + 26;
+
+/** Hints array offset from page start (4 bytes after BTREE_FLAGS). */
+constexpr uint32_t PAGE_HINTS = PAGE_BTREE_FLAGS + 4;
+
+/** Number of Hints (sampled Heads at the page level). */
+constexpr uint32_t PAGE_HINTS_N = 16;
+
+/** B-Tree flags stored in page[PAGE_BTREE_FLAGS] (32-bit, FORMAT_BTREE_OPT only). */
+enum page_btree_flag_t : uint32_t {
+  /** Semi-Dense: each slot owns 1-2 records (vs 4-8). */
+  PAGE_BTREE_SEMI_DENSE = 1 << 0,
+  /** Fully-Dense: array+bitmap for integer auto_increment PK.
+      When set, PAGE_FD_BASE_KEY and PAGE_FD_BITMAP are valid. */
+  PAGE_BTREE_FULLY_DENSE = 1 << 1
+};
