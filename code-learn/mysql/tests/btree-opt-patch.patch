 /** level of the node in an index tree; the leaf level is the level 0.
-This field should not be written to after page creation. */
+This field should not be written to after page creation.
+
+High byte (bits 8-15) is used to store page format version; the level
+itself fits in the low byte (max BTR_MAX_LEVELS=100 < 256). */
+constexpr uint32_t PAGE_FORMAT_SHIFT = 8;
+constexpr uint32_t PAGE_FORMAT_MASK = 0xFF << PAGE_FORMAT_SHIFT;
+constexpr uint32_t PAGE_LEVEL_MASK = 0xFF;
+
+/** Page format versions (stored in high byte of PAGE_LEVEL).
+    Original InnoDB: slots are 2-byte offsets, no Heads/Hints/PrefixTruncation.
+    OPT_FORMAT: slots are 6-byte (offset+Head), page header has Hints array,
+    records may use Prefix Truncation. */
+enum page_format_t : uint8_t {
+  PAGE_FORMAT_ORIG = 0,
+  PAGE_FORMAT_BTREE_OPT = 1
+};
+
+/** Returns the page format version from PAGE_LEVEL field.
+@param[in]  page_level  raw PAGE_LEVEL field value
+@return format version */
+inline page_format_t page_get_format(ulint page_level) {
+  return static_cast<page_format_t>(
+      (page_level >> PAGE_FORMAT_SHIFT) & 0xFF);
+}
+
+/** Encodes format + level into PAGE_LEVEL field.
+@param[in]  format  page format version
+@param[in]  level   tree level (leaf=0)
+@return encoded value for PAGE_LEVEL field */
+inline ulint page_make_level(page_format_t format, ulint level) {
+  return (static_cast<ulint>(format) << PAGE_FORMAT_SHIFT) |
+         (level & PAGE_LEVEL_MASK);
+}
+
+/** Page directory slot size in bytes, depends on page format.
+    ORIG: 2 bytes (just offset)
+    BTREE_OPT: 6 bytes (2-byte offset + 4-byte Head) */
