@@ -523,6 +523,46 @@ static inline page_dir_slot_t *page_dir_get_nth_slot(
 }
 #endif /* UNIV_DEBUG */
 
+/** Extract 4-byte Head from record key data. */
+static inline uint32_t page_rec_head_compute(const rec_t *rec) {
+  byte buf[4];
+  memcpy(buf, rec, 4);
+  return mach_read_from_4(buf);
+}
+
+/** Read per-slot Head from PAGE_HEADS array. */
+static inline uint32_t page_dir_slot_get_head(const page_t *page, ulint n) {
+  return mach_read_from_4(const_cast<byte *>(page + PAGE_HEADS + n * 4));
+}
+
+/** Write per-slot Head to PAGE_HEADS array. */
+static inline void page_dir_slot_set_head(page_t *page, ulint n, uint32_t head) {
+  mach_write_to_4(page + PAGE_HEADS + n * 4, head);
+}
+
+/** Populate the Hints array (16 sample Heads) from directory slots. */
+static inline void page_hints_populate(const page_t *page) {
+  ulint n = page_dir_get_n_slots(page);
+  if (n <= 1) return;
+  for (ulint i = 0; i < 16; i++) {
+    ulint idx = (i * (n - 1)) / 16;
+    const auto *s = page_dir_get_nth_slot(page, idx);
+    const rec_t *r = page_dir_slot_get_rec(s);
+    mach_write_to_4(const_cast<byte *>(page + PAGE_HINTS + i * 4), page_rec_head_compute(r));
+  }
+}
+
+/** Compute heap start offset (after B-tree header). */
+static inline ulint page_heap_start_offset(const page_t *page) {
+  ulint base = page_is_comp(page) ? PAGE_NEW_SUPREMUM_END : PAGE_OLD_SUPREMUM_END;
+  if (srv_btree_optimizations && page_is_leaf(page)) {
+    ulint pl = mach_read_from_2(page + PAGE_HEADER + PAGE_LEVEL);
+    if (page_get_format(pl) == PAGE_FORMAT_BTREE_OPT)
+      return base + PAGE_BTREE_HDR_SIZE;
+  }
+  return base;
+}
+
